---
import { AstroFont } from 'astro-font';
import AppFooter from "../components/AppFooter.astro";
import AppHeader from "../components/AppHeader.astro";

import Cart from "../components/Cart.astro";
import cartWidgetScript from "../lib/carritoWidget.ts?url";
import loginWidgetScript from "../lib/sesionWidget.ts?url";
import authVisibilityScript from "../lib/authVisibility.ts?url";
import priceByUserScript from "../lib/precioPorUsuario.ts?url";
import { getGlobalData } from "../lib/api";
import "../css/tailus.css"
import "../styles/global.css";
import NotFoundContent from "../components/NotFound.astro";

const API_URL = import.meta.env.VITE_STRAPI_URL;

const response = await getGlobalData().catch(() => null);
const metaTitle = response?.data?.defaultSeo?.metaTitle ?? "Página no encontrada";
const metaDescription = response?.data?.defaultSeo?.metaDescription ?? "";
const metaKeywords = response?.data?.defaultSeo?.metaKeywords ?? "";
const metaIcon = response?.data?.favicon?.url ? API_URL + response.data.favicon.url : null;
const metaImage = response?.data?.defaultSeo?.shareImage?.url ? API_URL + response.data.defaultSeo.shareImage.url : null;
const siteName = response?.data?.siteName ?? "Unicom";
const showNotFound = !response;


---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={metaIcon} />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={metaDescription} />
        <meta name="keywords" content={metaKeywords} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Open Graph / Facebook -->
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={metaImage} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />

        
        <title>{siteName}</title>


        <AstroFont
            config={[
                {
                    src: [],
                    name: "Urbanist",
                    preload: true,
                    display: "swap",
                    selector: "html",
                    fallback: "sans-serif",
                    googleFontsURL: 'https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap',
                },
            ]}
        />
    </head>
    
    <body class="relative min-h-screen dark:bg-gray-900">

        <div class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen" aria-hidden="true">
            <div class="relative h-full w-full">
                <div class="absolute inset-0 z-10 bg-black/50 black:bg-black/10"></div>
                <video
                    class="absolute inset-0 z-0 h-full w-full object-cover object-center"
                    autoplay
                    muted
                    loop
                    playsinline
                >
                    <source src="/images/video/video.mp4" type="video/mp4" />
                </video>
            </div>
        </div>

        <div class="relative z-10 min-h-screen" >


            
            {response && <AppHeader />}


            {showNotFound ? <NotFoundContent /> : <slot />}
            
            {response && <AppFooter />}
        
        </div>

        <Cart floating />
        
        <script type="module" src={loginWidgetScript}></script>
        <script type="module" src={cartWidgetScript}></script>
        <script type="module" src={authVisibilityScript}></script>
        <script type="module" src={priceByUserScript}></script>

        
    </body>
</html>
