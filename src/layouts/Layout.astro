---
import { AstroFont } from 'astro-font';
import AppFooter from "../components/AppFooter.astro";
import AppHeader from "../components/AppHeader.astro";
import Cart from "../components/Cart.astro";
import cartWidgetScript from "../lib/carritoWidget.ts?url";
import loginWidgetScript from "../lib/sesionWidget.ts?url";
import authVisibilityScript from "../lib/authVisibility.ts?url";
import priceByUserScript from "../lib/precioPorUsuario.ts?url";
import NotFoundContent from "../components/NotFound.astro";
import pureCounterScript from "../lib/pureCounterClient.ts?url";
import aosScript from "../lib/aosClient.ts?url";
import { getGlobalData } from "../lib/api";
import "../css/tailus.css"
import "../styles/global.css";

const API_URL = import.meta.env.VITE_STRAPI_URL;

const {
    metaTitle: metaTitleOverride,
    metaDescription: metaDescriptionOverride,
    metaKeywords: metaKeywordsOverride,
    metaImages: metaImagesOverride,
    forceNotFound = false,
    global: globalProp,
    stopIndexing = false,
} = Astro.props;

const response = globalProp ?? (await getGlobalData().catch(() => null));
const metaTitle = metaTitleOverride ?? response?.data?.defaultSeo?.metaTitle ?? "Página no encontrada";
const metaDescription = metaDescriptionOverride ?? response?.data?.defaultSeo?.metaDescription ?? "";
const metaKeywords = metaKeywordsOverride ?? response?.data?.defaultSeo?.metaKeywords ?? "";
const metaIcon = response?.data?.favicon?.url ? API_URL + response.data.favicon.url : null;
const metaImage = response?.data?.defaultSeo?.shareImage?.url ? API_URL + response.data.defaultSeo.shareImage.url : null;
const siteName = response?.data?.siteName ?? "Unicom";
const metaImages = Array.isArray(metaImagesOverride) && metaImagesOverride.length
    ? metaImagesOverride
    : metaImage
      ? [metaImage]
      : [];
const showNotFound = forceNotFound || !response;
const showShell = Boolean(response);
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta http-equiv="Cache-Control" content="public, max-age=86400, s-maxage=86400" />
        <link rel="icon" type="image/svg+xml" href={metaIcon} />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={metaDescription} />
        <meta name="keywords" content={metaKeywords} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Open Graph / Facebook -->
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={metaDescription} />
        {metaImages[0] && <meta property="og:image" content={metaImages[0]} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />

        {stopIndexing && (
            <>
                <meta name="robots" content="noindex, nofollow" />
                <link rel="canonical" href="https://sistema.unicomec.com/tienda" />
            </>
        )}
        <title>{metaTitle ?? siteName}</title>



        <AstroFont
            config={[
                {
                    src: [],
                    name: "Urbanist",
                    preload: true,
                    display: "swap",
                    selector: "html",
                    fallback: "sans-serif",
                    googleFontsURL: 'https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap',
                },
            ]}
        />
    </head>

    
    <body class="relative min-h-screen dark:bg-gray-950 scroll-smooth">

        <div
            aria-hidden="true"
            class="pointer-events-none w-full fixed inset-0 -z-10"
        >
            <div class="mx-auto grid h-full w-full max-w-7xl items-center grid-cols-2 -space-x-52 opacity-40 ">
                <div class="h-120 bg-gradient-to-r from-red-600 to-orange-400 dark:from-cyan-600 dark:to-blue-700 blur-3xl"></div>
                <div class="h-120 bg-gradient-to-br from-orange-400 to-red-600 dark:from-blue-700 dark:to-cyan-600 blur-3xl"></div>
            </div>
        </div>

        <div class="relative z-10 w-full" >
            
            {showShell && <AppHeader global={response} />}

            {showNotFound ? <NotFoundContent /> : <slot />}
            
            {showShell && <AppFooter global={response} />}

        </div>

        <Cart floating />
        
        <script type="module" src={loginWidgetScript}></script>
        <script type="module" src={cartWidgetScript}></script>
        <script type="module" src={authVisibilityScript}></script>
        <script type="module" src={priceByUserScript}></script>
        <script type="module" src={aosScript}></script>
        <script type="module" src={pureCounterScript}></script>

        
    </body>
</html>
