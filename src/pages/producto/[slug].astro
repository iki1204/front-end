---
import BaseLayout from "../../layouts/Layout.astro";
import { BlocksRenderer} from "@strapi/blocks-react-renderer";
import { getProductoBySlug, getGlobalData, getCategorias, getProductos, getMarcas } from "../../lib/api";
import ProductCard from "../../components/ProductCard.astro";

const API_URL = import.meta.env.VITE_STRAPI_URL;

const normalizeCollection = (collection: any[] = []) =>
  collection.map((item) => (item?.attributes ? { id: item.id, ...item.attributes } : item));

export async function getStaticPaths() {
  const PAGE_SIZE = 100;
  const productos: Record<string, unknown>[] = [];
  let page = 1;
  let pageCount = 1;

  do {
    const response = await getProductos({
      "pagination[page]": page,
      "pagination[pageSize]": PAGE_SIZE,
    });

    const pageItems = normalizeCollection(response?.data ?? []);
    productos.push(...pageItems);

    const pagination = response?.meta?.pagination;
    pageCount = pagination?.pageCount ?? pageCount;
    page += 1;
  } while (page <= pageCount);

  return productos
    .map((producto) => {
      const slug = producto?.ID_Nombre ?? producto?.slug ?? (producto?.id ? String(producto.id) : null);

      if (!slug) {
        return null;
      }

      return {
        params: { slug },
        props: { preloadedProducto: producto },
      };
    })
    .filter(
      (
        value,
      ): value is {
        params: { slug: string };
        props: { preloadedProducto: Record<string, unknown> };
      } => Boolean(value),
    );
}

const { params } = Astro;
const slug = params.slug;
const preloadedProducto = Astro.props?.preloadedProducto;

if (!slug) {
  throw new Error("No se proporcionó un identificador de producto");
}

const [productoResponse, global, categoriasResponse, marcasResponse] = await Promise.all([
  preloadedProducto ? Promise.resolve({ data: [preloadedProducto] }) : getProductoBySlug(slug),
  getGlobalData(),
  getCategorias(),
  getMarcas()
]);

const producto = normalizeCollection(productoResponse?.data ?? [])[0];

if (!producto) {
  return Astro.redirect("/tienda", 302);
}

const categorias = normalizeCollection(categoriasResponse?.data ?? []);
const marcas = normalizeCollection(marcasResponse?.data ?? []);
const categoriaActual = categorias.find((categoria) =>
  categoria?.ID_Categoria === producto?.ID_Categoria || categoria?.id === producto?.ID_Categoria
);
const marcaActual = marcas.find((marca) =>
  marca?.ID_Marca === producto?.ID_Marca || null
)

const currentProductKey =
  producto?.id ??
  producto?.ID_Producto ??
  producto?.codigo ??
  producto?.ID_Nombre ??
  producto?.slug ??
  null;

const recommendationPageSize = 6;
const baseRecommendationParams = new URLSearchParams({
  "pagination[page]": "1",
  "pagination[pageSize]": String(recommendationPageSize),
  populate: "*",
  sort: "createdAt:desc",
});

const buildRecommendationParams = (filters: Record<string, string | null>) => {
  const params = new URLSearchParams(baseRecommendationParams);
  Object.entries(filters).forEach(([key, value]) => {
    if (!value) return;
    params.set(key, value);
  });
  return params;
};

const categoriaFiltro = producto?.ID_Categoria ? String(producto.ID_Categoria) : null;
const marcaFiltro = producto?.ID_Marca ? String(producto.ID_Marca) : null;

const fetchRecommendations = async (filters: Record<string, string | null>) => {
  const params = buildRecommendationParams(filters);
  const response = await getProductos(params);
  return normalizeCollection(response?.data ?? []);
};

const getProductKey = (item: any) =>
  item?.id ?? item?.ID_Producto ?? item?.codigo ?? item?.ID_Nombre ?? item?.slug ?? null;

const uniqueRecommendations: any[] = [];
const seenKeys = new Set<string | number>();

const addUniqueRecommendations = (items: any[]) => {
  items.forEach((item) => {
    const key = getProductKey(item);
    if (!key || key === currentProductKey || seenKeys.has(key)) {
      return;
    }
    seenKeys.add(key);
    uniqueRecommendations.push(item);
  });
};

if (categoriaFiltro && marcaFiltro) {
  const byBrandAndCategory = await fetchRecommendations({
    "filters[ID_Categoria][$eq]": categoriaFiltro,
    "filters[ID_Marca][$eq]": marcaFiltro,
  });
  addUniqueRecommendations(byBrandAndCategory);
}

if (categoriaFiltro && uniqueRecommendations.length < 4) {
  const byCategory = await fetchRecommendations({
    "filters[ID_Categoria][$eq]": categoriaFiltro,
  });
  addUniqueRecommendations(byCategory);
}

const recommendedProducts = uniqueRecommendations.slice(0, 4);

const identifier = producto?.identifier;
const stockEndpoint = `${API_URL}/api/productos/${encodeURIComponent(String(identifier))}/stock`;
const bodegaEndpoint = `/api/bodega-stock/${encodeURIComponent(String(identifier))}`;


const toAbsoluteMediaUrl = (path: string | null) => {
  if (!path) return null;
  if (/^https?:\/\//i.test(path)) return path;
  return API_URL ? `${API_URL}${path}` : path;
};

const getMediaUrl = (item: any) => {
  const media = item?.attributes ?? item;
  const path =
    media?.formats?.medium?.url ??
    media?.formats?.large?.url ??
    media?.formats?.small?.url ??
    media?.formats?.thumbnail?.url ??
    media?.url ??
    null;

  return toAbsoluteMediaUrl(path);
};

const mediaGroups = [
  producto?.imagen,
  producto?.imagenes,
  producto?.imagenes?.data,
];

const imageCandidates = mediaGroups
  .flatMap((group) => {
    if (!group) return [];
    if (Array.isArray(group)) return group;
    if (Array.isArray(group?.data)) return group.data;
    return [group];
  })
  .filter(Boolean);

const seenMediaKeys = new Set<string | number>();

const uniqueImages = imageCandidates
  .map((item) => {
    const media = item?.attributes ?? item;
    const key = media?.id ?? item?.id ?? null;
    const imageUrl = getMediaUrl(item);

    return {
      key,
      imageUrl,
      mime: media?.mime ?? null,
      width: media?.width ?? null,
      height: media?.height ?? null,
      ext: media?.ext ?? null,
      name: media?.name ?? null,
      alternativeText: media?.alternativeText ?? null,
      formats: media?.formats ?? null,
    };
  })
  .filter(({ imageUrl }) => Boolean(imageUrl))
  .filter(({ key, imageUrl }) => {
    const dedupeKey = key ?? imageUrl;
    if (seenMediaKeys.has(dedupeKey)) return false;
    seenMediaKeys.add(dedupeKey);
    return true;
  });

const mainImageData = uniqueImages[0] ?? null;
const mainImage = mainImageData?.imageUrl ?? "/images/placeholder.svg";

const galleryItems = uniqueImages.slice(1).map((img) => img.imageUrl as string);

const ogImageType = mainImageData?.mime ?? null;
const ogImageWidth = mainImageData?.width ? String(mainImageData.width) : null;
const ogImageHeight = mainImageData?.height ? String(mainImageData.height) : null;
const ogImageAlt =
  mainImageData?.alternativeText ??
  mainImageData?.name ??
  "Imagen del producto";

const productoNombre = producto?.nombre ?? "Producto";
const categoriaNombre = categoriaActual?.nombre ?? "Sin categoría";
const marcaNombre = marcaActual?.nombre ?? "Sin marca";
const fallbackDescription = `Compra ${productoNombre} de ${marcaNombre} en la categoría ${categoriaNombre}.`;
const metaDescription =
  typeof producto?.descripcion === "string" && producto.descripcion.trim()
    ? producto.descripcion
    : fallbackDescription;
const metaKeywords = [productoNombre, categoriaNombre, marcaNombre].filter(Boolean).join(", ");
const metaImages = [mainImage, ...galleryItems].filter(Boolean);
const siteOrigin = Astro.url.origin.replace(/^http:/, "https:");
const encodedSlug = encodeURIComponent(String(slug));
const canonicalUrl = new URL(`/producto/${encodedSlug}`, siteOrigin).toString();
const porcentajeDescuento = Number(producto?.oferta?.Porcentaje_de_descuento ?? 0);

  
const datasheetEntries: any[] = [
  ...(Array.isArray(producto?.datasheets) ? producto.datasheets : []),
  ...(Array.isArray(producto?.datasheets?.data)
    ? producto.datasheets.data.map((item: any) => item?.attributes ?? item)
    : []),
  ...(producto?.datasheets?.data?.attributes ? [producto.datasheets.data.attributes] : []),
].filter(Boolean);

const datasheetLinks = datasheetEntries
  .map((item, index) => {
    const url = item?.url ?? item?.formats?.pdf?.url ?? null;
    if (!url) return null;

    const absoluteUrl = url.startsWith("http") ? url : `${API_URL ?? ""}${url}`;
    const label = item?.name ?? item?.alternativeText ?? item?.caption;
    const displayLabel = index === 0 ? "DataSheet" : `Ficha Tecnica ${index}`;

    return { url: absoluteUrl, label, displayLabel };
  })
  .filter(Boolean);


const isOfertaActiva = producto?.oferta?.Activo;



var descripcion = producto?.descripcion;

const asesorContactLinks: Record<string, string> = {
  "Edison": "https://wa.me/593967302450?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Moises": "https://wa.me/593989372276?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Katya": "https://wa.me/593991046279?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Samantha": "https://wa.me/593989538349?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Lizeth": "https://wa.me/593980373798?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
};

const getRandomAsesorLink = (links: Record<string, string>) => {
  const values = Object.values(links).filter(Boolean);
  if (values.length === 0) return "#";
  return values[Math.floor(Math.random() * values.length)];
};

const randomAsesorContactLink = getRandomAsesorLink(asesorContactLinks);

const stockCount = Number(producto?.cantidad_stock ?? 0);
const isOutOfStock = Number.isFinite(stockCount) ? stockCount <= 0 : !producto?.cantidad_stock;
---

<BaseLayout
  global={global}
  metaTitle={productoNombre}
  metaDescription={metaDescription}
  metaKeywords={metaKeywords}
  metaImages={metaImages}
  ogImageType={ogImageType}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={ogImageAlt}
  metaCanonical={canonicalUrl}
  metaOgType="product"
>

    <article class="relative mx-10  px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <a
