                  <g transform="rotate(90)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(120)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(150)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(180)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(210)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(240)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(270)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(300)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                  <g transform="rotate(330)"><line x1="0" y1="-82" x2="0" y2="-74"/></g>
                </g>
              </g>

              <!-- Manecillas -->
              <g stroke="currentColor" stroke-linecap="round">
                <!-- Hora -->
                <line x1="100" y1="100" x2="100" y2="58" stroke-width="13"/>
                <!-- Minuto -->
                <line x1="100" y1="100" x2="142" y2="100" stroke-width="14"/>
                <!-- Segundo (rojo) -->
                <line x1="100" y1="104" x2="100" y2="40" stroke="red" stroke-width="10"/>
              </g>

              <!-- Centro -->
              <circle cx="100" cy="100" r="6" fill="currentColor"/>
              <circle cx="100" cy="100" r="3" fill="white"/>
            </svg>



          <p class="text-red-500 animate-pulse font-bold">
            Pocas Unidades
          </p>
        `;
      }

      if (statusEl) {
        statusEl.innerHTML = hasStock
          ? '<span class="h-2 w-2 rounded-full bg-emerald-500"></span>Disponible'
          : '<span class="h-2 w-2 rounded-full bg-rose-500"></span>No disponible';
        statusEl.className = hasStock
          ? "inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-200"
          : "inline-flex items-center gap-2 rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-rose-600 dark:bg-rose-500/10 dark:text-rose-200";
      }

      const cartBtn = document.querySelector<HTMLButtonElement>("[data-action='add-to-cart']");
      if (cartBtn) {
        if (!hasStock) {
          cartBtn.disabled = true;
          cartBtn.setAttribute("aria-disabled", "true");
          cartBtn.className = "w-full rounded-full px-5 py-3 text-sm font-semibold text-white transition cursor-not-allowed bg-zinc-300 dark:bg-zinc-700 opacity-60";
        } else {
          cartBtn.disabled = false;
          cartBtn.removeAttribute("aria-disabled");
          cartBtn.className = "w-full cursor-pointer rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/30";
        }
      }
    } catch (e) {
      el.textContent = "Error, intente más tarde";
       if (statusEl) {
        statusEl.innerHTML = '<span class="h-2 w-2 rounded-full bg-amber-500"></span>Stock no disponible';
        statusEl.className =
          "inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700 dark:bg-amber-500/10 dark:text-amber-200";
      }
    }
  });
</script>

<script type="module">
  window.addEventListener("DOMContentLoaded", async () => {
    const bodegaPanel = document.getElementById("bodega-panel");
    const bodegaList = document.getElementById("bodega-list");
    if (!bodegaPanel || !bodegaList) return;

    try {
      const raw = localStorage.getItem("usuarioSesion");
      const parsed = raw ? JSON.parse(raw) : null;
      const user = parsed?.user ?? parsed?.data?.user ?? null;
      if (user?.admin !== true) return;
    } catch {
      return;
    }

    const endpoint = bodegaPanel.dataset.bodegaEndpoint;
    if (!endpoint || endpoint.includes("undefined")) {
      bodegaList.innerHTML = '<p class="text-xs text-zinc-400">Sin información de bodegas.</p>';
      return;
    }

    try {
      const res = await fetch(endpoint, { cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      if (!Array.isArray(data) || data.length === 0) {
        bodegaList.innerHTML = '<p class="text-xs text-zinc-400">Sin información de bodegas.</p>';
        return;
      }

      bodegaList.innerHTML = data
        .map((bodega) => {
          const nombre = String(bodega.bodega_nombre ?? "Bodega");
          const cantidad = Number(bodega.cantidad ?? 0);
          const hasStock = cantidad > 0;
          const fewStock = cantidad > 0 && cantidad <= 10;

          const dotClass = hasStock
            ? fewStock
              ? "bg-amber-400"
              : "bg-emerald-400"
            : "bg-zinc-300 dark:bg-zinc-600";
          const countClass = hasStock
            ? fewStock
              ? "font-bold text-amber-600 dark:text-amber-400"
              : "font-bold text-emerald-600 dark:text-emerald-400"
            : "font-medium text-zinc-400 dark:text-zinc-500";
          const rowClass = hasStock
            ? fewStock
              ? "border-amber-100 bg-amber-50/60 dark:border-amber-500/20 dark:bg-amber-500/5"
              : "border-emerald-100 bg-emerald-50/60 dark:border-emerald-500/20 dark:bg-emerald-500/5"
            : "border-zinc-100 bg-zinc-50/50 dark:border-zinc-700/30 dark:bg-zinc-800/20";

          return `
            <div class="flex items-center gap-3 rounded-xl border ${rowClass} px-3 py-2">
              <span class="h-2 w-2 shrink-0 rounded-full ${dotClass}"></span>
              <span class="flex-1 truncate text-xs font-medium text-zinc-700 dark:text-zinc-300">${nombre}</span>
              <span class="shrink-0 tabular-nums text-xs ${countClass}">${cantidad}</span>
            </div>
          `;
        })
        .join("");
    } catch (e) {
      bodegaList.innerHTML =
        '<p class="text-xs text-zinc-400">No se pudo cargar el stock por bodega.</p>';
    }
  });
</script>

