<script>
  (() => {
    const preloader = document.getElementById("product-info-preloader");

    const hidePreloader = () => {
      if (!preloader) return;
      preloader.style.opacity = "0";
      preloader.style.pointerEvents = "none";
      setTimeout(() => preloader.remove(), 500);
    };

    if (document.readyState === "complete") {
      hidePreloader();
    } else {
      window.addEventListener("load", hidePreloader, { once: true });
    }
  })();

  window.addEventListener("DOMContentLoaded", () => {
    const shareButton = document.getElementById("share-product");

    if (shareButton) {
      shareButton.addEventListener("click", async () => {
        const title = document.title;
        const url = window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              text: title,
              url: url
            });
          } catch (error) {
            console.error("Error compartiendo:", error);
          }
        } else {
          alert("Tu navegador no soporta compartir");
        }
      });
    }

    const storeStateKey = "tiendaState";
    const backToStoreLink = document.querySelector("[data-back-to-store]");
    const referrer = document.referrer;

    if (referrer) {
      try {
        const referrerUrl = new URL(referrer);
        if (referrerUrl.pathname.startsWith("/tienda")) {
          localStorage.setItem(storeStateKey, `${referrerUrl.pathname}${referrerUrl.search}`);
        }
      } catch (error) {
        console.warn("No se pudo leer la URL de referencia", error);
      }
    }

    if (backToStoreLink instanceof HTMLAnchorElement) {
      const storedState = localStorage.getItem(storeStateKey);
      if (storedState) {
        backToStoreLink.setAttribute("href", storedState);
      }
    }

    {
      let sessionAsesorKey: string | null = null;
      try {
        const rawSession = localStorage.getItem("usuarioSesion");
        if (rawSession) {
          const parsedSession = JSON.parse(rawSession);
          const user = parsedSession?.user ?? parsedSession?.data?.user ?? null;
          sessionAsesorKey = user?.asesor ?? null;
        }
      } catch { /* sin sesión válida */ }

      const getRandomLink = (links: Record<string, string>) => {
        const values = Object.values(links).filter(Boolean);
        return values.length > 0 ? values[Math.floor(Math.random() * values.length)] : "#";
      };

      document.querySelectorAll<HTMLAnchorElement>("[data-asesor-contact]").forEach((el) => {
        const raw = el.getAttribute("data-asesor-links") ?? "{}";
        let links: Record<string, string> = {};
        try { links = JSON.parse(raw); } catch { return; }

        if (sessionAsesorKey && links[sessionAsesorKey]) {
          el.setAttribute("href", links[sessionAsesorKey]);
        } else {
          el.setAttribute("href", getRandomLink(links));
        }
      });
    }

    const mainImg = document.getElementById("main-image");
    const zoomContainer = document.querySelector("[data-zoom-container]");
    const thumbsRoot = document.getElementById("thumbs");
    if (!mainImg) return;

    if (zoomContainer) {
      const handlePointerMove = (event: Event) => {
        const mouseEvent = event as MouseEvent;
        const rect = zoomContainer.getBoundingClientRect();
        const offsetX = mouseEvent.clientX - rect.left;
        const offsetY = mouseEvent.clientY - rect.top;
        const percentX = Math.max(0, Math.min(100, (offsetX / rect.width) * 100));
        const percentY = Math.max(0, Math.min(100, (offsetY / rect.height) * 100));
        mainImg.style.setProperty("--zoom-x", `${percentX}%`);
        mainImg.style.setProperty("--zoom-y", `${percentY}%`);
      };

      const resetZoomOrigin = () => {
        mainImg.style.setProperty("--zoom-x", "50%");
        mainImg.style.setProperty("--zoom-y", "50%");
      };

      zoomContainer.addEventListener("mousemove", handlePointerMove);
      zoomContainer.addEventListener("mouseleave", resetZoomOrigin);
      zoomContainer.addEventListener("touchend", resetZoomOrigin);
    }

    if (!thumbsRoot) return;

    // Estado: URLs absolutas
    const mainState = { src: mainImg.getAttribute("src") };
    let thumbs = Array.from(thumbsRoot.querySelectorAll("[data-src]"))
      .map((el) => el.getAttribute("data-src"))
      .filter(Boolean);

    // Delegación de eventos para clicks en las miniaturas
    thumbsRoot.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-src]");
      if (!btn) return;

      const newMain = btn.getAttribute("data-src");
      if (!newMain || newMain === mainState.src) return;

      // 1) Cambia imagen principal
      const prevMain = mainState.src;
      mainState.src = newMain;
      mainImg.setAttribute("src", newMain);

      // 2) Reordena: quita clicada y agrega la anterior principal al final
      thumbs = thumbs.filter((u) => u !== newMain);
      thumbs.push(prevMain);

      // 3) Re-renderiza miniaturas
      renderThumbs();
    });

    function renderThumbs() {
      // Limpia y vuelve a dibujar
      if (!thumbsRoot) return;
      thumbsRoot.innerHTML = thumbs
        .map(
          (src) => `
          <button
            class="thumb relative h-24 w-full cursor-pointer overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 p-2 transition hover:-translate-y-0.5 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 sm:h-28"
            data-src="${src}"
            type="button"
            aria-label="Cambiar imagen"
          >
            <img src="${src}" alt="Vista adicional" class="h-full w-full object-cover pointer-events-none" loading="lazy" />
          </button>`
        )
        .join("");
    }
  });
</script>

<script type="module">
