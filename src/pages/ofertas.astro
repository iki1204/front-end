---
import BaseLayout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import LiqProductCard from "../components/LiqProductCard.astro";
import { getGlobalData, getProductos } from "../lib/api";

const normalizeWithAttributes = (item: any) =>
  item?.attributes ? { id: item.id, ...item.attributes } : item;

const normalizeCollection = (collection: any[] = []) => collection.map(normalizeWithAttributes);

const offerParams = new URLSearchParams({
  "pagination[page]": "1",
  "pagination[pageSize]": "100",
  sort: "nombre:asc",
});

const offerItems: any[] = [];
let page = 1;
let pageCount = 1;

do {
  offerParams.set("pagination[page]", String(page));
  const response = await getProductos(offerParams);
  offerItems.push(...normalizeCollection(response?.data ?? []));
  pageCount = response?.meta?.pagination?.pageCount ?? 1;
  page += 1;
} while (page <= pageCount);

const global = await getGlobalData();
const productosOferta = offerItems.filter((producto) => {
  const activo = producto?.oferta?.Activo;
  return activo === true || activo === "true" || activo === 1;
});
---

<BaseLayout
  global={global}
  metaTitle="Ofertas y Liquidación | Unicomec"
  metaDescription="Descubre los productos en liquidación con precios exclusivos y disponibilidad actualizada."
  metaCanonical="https://sistema.unicomec.com/ofertas"
>
  <div
    class="fixed inset-0 z-[999] flex items-center justify-center bg-white/80 text-zinc-900 backdrop-blur-sm transition-opacity dark:bg-zinc-950/80 dark:text-white"
    data-preloader
    role="status"
    aria-live="polite"
    aria-busy="true"
  >
    <div class="flex flex-col items-center gap-4 rounded-3xl bg-white/90 px-8 py-6 shadow-xl dark:bg-zinc-900/90">
      <div class="loader"></div>
      <p class="text-sm font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-300">
        Cargando productos
      </p>
    </div>
  </div>

  <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-zinc-900 to-slate-800 py-20 text-white">
    <div class="absolute -left-24 top-8 h-64 w-64 rounded-full bg-primary/30 blur-3xl"></div>
    <div class="absolute -right-20 bottom-0 h-72 w-72 rounded-full bg-amber-400/20 blur-3xl"></div>
    <Container>
      <div class="relative z-10 mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-amber-300">
          Liquidación activa
        </p>
        <h1 class="mt-6 text-balance text-4xl font-black tracking-tight md:text-6xl">
          Ofertas que no duran para siempre
        </h1>
        <p class="mt-5 text-lg text-zinc-200 md:text-xl">
          Seleccionamos aquí todos los productos con oferta activa para que encuentres oportunidades reales en segundos.
        </p>
      </div>
    </Container>
  </section>

  <section class="bg-zinc-50 py-14 dark:bg-zinc-950"
    data-auth-visible="authenticated"
  >
    <Container>
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white md:text-3xl">Productos en oferta</h2>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
            {productosOferta.length} producto{productosOferta.length === 1 ? "" : "s"} en liquidación
          </p>
        </div>
        <a
          href="/tienda"
          class="inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 transition hover:border-primary hover:text-primary dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200"
        >
          Ver toda la tienda
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {productosOferta.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
          {productosOferta.map((producto) => <LiqProductCard producto={producto} />)}
        </div>
      ) : (
        <div class="rounded-3xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-900">
          <p class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">No hay productos en liquidación en este momento.</p>
          <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Vuelve pronto para descubrir nuevas ofertas activas.</p>
        </div>
      )}

    </Container>
  </section>
   <section class="bg-zinc-50 py-14 dark:bg-zinc-950"
    data-auth-visible="guest"
  >
    <Container>
        <div class="rounded-3xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-900">
          <p class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">Las Ofertas son irresistibles</p>
          <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Inicia sesión para ver más</p>
        </div>
    </Container>
  </section>

</BaseLayout>
<script is:inline>
    const preloader = document.querySelector("[data-preloader]");
    if (preloader) {
      const hidePreloader = () => {
        preloader.classList.add("opacity-0");
        preloader.setAttribute("aria-busy", "false");
        setTimeout(() => {
          preloader.classList.add("hidden");
        }, 200);
      };

      const showPreloader = () => {
        preloader.classList.remove("hidden", "opacity-0");
        preloader.setAttribute("aria-busy", "true");
      };

      window.addEventListener("load", hidePreloader);

      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (form instanceof HTMLFormElement) {
          showPreloader();
        }
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a");
        if (!link || link.target === "_blank" || link.hasAttribute("download")) {
          return;
        }
        const href = link.getAttribute("href") ?? "";
        if (href.startsWith("#")) return;
        if (link.hasAttribute("data-no-preloader")) return;
        showPreloader();
      });
    }
  </script>