---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---

<Layout title="Cuenta pendiente de verificación">
  <Container layout="layout">
    <main class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
      <h1 class="mb-4 text-4xl font-bold text-primary">Cuenta pendiente de verificación</h1>
      <p class="mb-8 text-lg text-zinc-700 dark:text-zinc-200">
        Tu cuenta está en revisión. Cuando termine el proceso, podrás acceder a los precios y comprar en la tienda.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-full border border-primary/30 px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/10"
        >
          Volver al inicio
        </a>
        <a
          href="/login"
          class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:brightness-110"
        >
          Intentar de nuevo
        </a>
      </div>
    </main>
  </Container>
</Layout>
