---
import Stats from '../components/Stats.astro';
import Features from '../components/Features.astro';
import HeroSection from '../components/HeroSection.astro';
import SliderMarcas from '../components/SliderMarcas.astro';
import SliderBanner from '../components/SliderBanner.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import Layout from '../layouts/LayoutIndex.astro';
import Ubicacion from '../components/Ubicacion.astro';
import About from '../components/About.astro';
import SliderPromos from '../components/SliderPromos.astro';
import { getPageData } from '../lib/api';

const pageData = await getPageData("home-page");
---

<Layout title="Unicom - Inicio">
  <main class="space-y-30 mb-40">
    <section id="home">
      <HeroSection pageData={pageData} />
    </section>

    <section id="marcas">
      <SliderMarcas pageData={pageData} />
    </section>

    <section id="about">
      <About />
    </section>

    <section id="banner">
      <SliderBanner pageData={pageData} />
    </section>

    <section id="features">
      <Features />
    </section>


    <section id="productos">
      <ProductCarousel />
    </section>

    <section id="stats">
      <Stats />
    </section>

    <section id="promos">
      <SliderPromos pageData={pageData} />
    </section>

    <section id="ubicacion">
      <Ubicacion />
    </section>
  </main>
</Layout>
