}




---
<BaseLayout title="Calculadora Solar">
  <main>
    <section class="container mx-auto my-[100px] px-4 fade-in-animation">
      <h1 class="text-center text-6xl font-bold">Calculadora Solar</h1>
      <h2 class="mt-2 text-center text-2xl text-gray-600">
        ¡Calcula el tamaño de tu sistema con nosotros!
      </h2>

      <div class="mt-8 flex justify-center">
        <div class="w-full max-w-6xl">
          <!-- Sección de ingreso de equipos -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Uso diario de Energia</h5>
              <i class="bi bi-lightbulb-fill"></i>
            </div>

            <div class="p-5">
              <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:items-end appliance-row">
                <div class="md:col-span-12">
                  <label class="mb-2 block text-sm font-medium">Seleccione el equipo</label>
                  <select
                    class="obt mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    id="applianceSelect"
                    aria-label="Large select example"
                  >
                                    
                  </select>
                </div>

                <div class="md:col-span-3">
                  <label class="mb-2 block text-sm font-medium">Cantidad</label>
                  <input
                    type="number"
                    class="qty w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-red-500 focus:outline-none"
                    min="1"
                    value="1"
                  />
                </div>

                <div class="md:col-span-3">
                  <label class="mb-2 block text-sm font-medium">Potencia (W)</label>
                  <input
                    type="number"
                    class="power w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-red-500 focus:outline-none"
                    min="1"
                  />
                </div>

                <div class="md:col-span-3">
                  <label class="mb-2 block text-sm font-medium">Horas al dia</label>
                  <input
                    type="number"
                    class="hours w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-red-500 focus:outline-none"
                    min="1"
                    max="24"
                  />
                </div>

                <div class="text-center md:col-span-3">
                  <button
                    class="w-full rounded-lg bg-red-600 px-4 py-2 font-medium text-white transition hover:bg-red-700"
                    type="button"
                    id="btnCalc"
                  >
                    Calcular
                  </button>
                </div>
              </div>

              <!-- Tabla Desktop -->
              <div class="mt-8 hidden overflow-x-auto md:block">
                <table class="min-w-full border-collapse text-left" id="appliancesTable">
                  <thead>
                    <tr class="border-b bg-gray-100">
                      <th class="min-w-[150px] px-4 py-3 font-semibold">Objeto</th>
                      <th class="min-w-[150px] px-4 py-3 font-semibold">Cantidad</th>
                      <th class="min-w-[150px] px-4 py-3 font-semibold">Potencia</th>
                      <th class="min-w-[150px] px-4 py-3 font-semibold">Horas</th>
                      <th class="min-w-[150px] px-4 py-3 font-semibold">Consumo</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>

              <!-- Versión móvil -->
              <div class="md:hidden">
                <div id="mobile-appliances-list" class="grid grid-cols-1 gap-3"></div>
              </div>
            </div>

            <div class="p-5 pt-0">
              <h5 class="mb-3 text-lg font-semibold">Consumo Total Diario de Energia</h5>
              <div class="mb-3 rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div>
                    <label class="block text-sm text-gray-500">Total Potencia</label>
                    <div class="h4 text-2xl font-bold" id="totalWatts">0 W</div>
                  </div>
                  <div>
                    <label class="block text-sm text-gray-500">Total Vatios-Hora</label>
                    <div class="h4 text-2xl font-bold" id="totalWattHours">0 Wh</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sección de pérdidas -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Consumo diario según la perdida energética</h5>
              <i class="bi bi-lightning-fill"></i>
            </div>

            <div class="p-5">
              <div class="grid grid-cols-1 gap-4 appliance-row">
                <div>
                  <label class="mb-2 block text-sm font-medium">
                    Seleccione el estimado de la perdida
                  </label>
                  <select
                    class="lss mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    id="lossSelect"
                  >
                    <option value="0.15">15%</option>
                    <option value="0.20">20%</option>
                    <option value="0.25">25%</option>
                    <option value="0.30">30%</option>
                    <option value="0.35">35%</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="p-5 pt-0">
              <h5 class="mb-3 text-lg font-semibold">
                Consumo Total Diario de Energia con Perdidas
              </h5>
              <div class="mb-3 rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div>
                    <label class="block text-sm text-gray-500">Total Potencia</label>
                    <div class="h4 text-2xl font-bold" id="totalWattsloss">0 W</div>
                  </div>
                  <div>
                    <label class="block text-sm text-gray-500">Total Vatios-Hora</label>
                    <div class="h4 text-2xl font-bold" id="totalWattHoursloss">0 Wh</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sección horas de sol -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Horas de Sol segun su localidad</h5>
              <i class="bi bi-sun-fill"></i>
            </div>

            <div class="p-5">
              <div class="grid grid-cols-1 gap-4 appliance-row">
                <div>
                  <div id="map" class="mb-4 h-[400px] w-full rounded-lg border border-gray-300"></div>

                  <div class="mb-3">
                    <label class="mb-2 block text-sm font-medium">Buscar provincia:</label>
                    <select
                      id="selectProvincias"
                      class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <option value="">Selecciona una provincia...</option>
                    </select>
                  </div>

                  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="mb-3">
                      <label class="mb-2 block text-sm font-medium">Provincia seleccionada:</label>
                      <input
                        type="text"
                        id="provincia"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2"
                        readonly
                      />
                    </div>

                    <div class="mb-3">
                      <label class="mb-2 block text-sm font-medium">
                        Horas sol pico (promedio):
                      </label>
                      <div class="flex overflow-hidden rounded-lg border border-gray-300">
                        <input
                          type="number"
                          id="horasSol"
                          class="w-full px-3 py-2 focus:outline-none"
                        />
                        <span class="bg-gray-100 px-3 py-2 text-sm text-gray-600">horas/día</span>
                      </div>
                    </div>

                    <div class="mb-3">
                      <a
                        class="inline-block rounded-lg bg-red-600 px-4 py-2 font-medium text-white transition hover:bg-red-700"
                        id="btnpanel"
                        href="#panelSection"
                      >
                        Aceptar
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Paneles solares -->
          <div
            class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block"
            id="panelSection"
          >
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Cálculo de Paneles Solares</h5>
              <i class="fa-solid fa-solar-panel"></i>
            </div>

            <div class="p-5">
              <div class="rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-medium">Seleccionar Panel:</label>
                    <select
                      id="panelType"
                      class="panel mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <option value="160">160W</option>
                      <option value="300">300W</option>
                      <option value="360">360W</option>
                      <option value="450">450W</option>
                      <option value="550">550W</option>
                    </select>
                  </div>

                  <h5 class="mt-10 mb-3 text-lg font-semibold md:col-span-2">
                    Cálculo de los Paneles necesarios para la Potencia requerida
                  </h5>

                  <div>
                    <label class="block text-sm text-gray-500">Total de Potencia Solar</label>
                    <div class="h4 text-2xl font-bold" id="totalWattageSolar">0 Wp</div>
                  </div>

                  <div>
                    <label class="block text-sm text-gray-500">Paneles Totales</label>
                    <div class="h4 text-2xl font-bold" id="totalPaneles">0</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Voltaje del sistema -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Voltaje del sistema</h5>
              <div class="flex items-center gap-2">
                <i class="bi bi-lightning-fill"></i>
                <button
                  type="button"
                  class="rounded bg-red-700 px-2 py-1 text-sm text-white hover:bg-red-800"
                  title="Voltaje del sistema"
                  data-popover-content="<p>El voltaje del sistema es importante para determinar la configuración de los paneles solares y baterías.</p><p>Si el consumo es menor a 2000Wh, se recomienda 12V. Entre 2000Wh y 5000Wh, 24V. Mayor a 5000Wh, 48V.</p>"
                >
                  ℹ️
                </button>
              </div>
            </div>

            <div class="p-5">
              <div class="grid grid-cols-1 gap-4 appliance-row">
                <div>
                  <label class="mb-2 block text-sm font-medium">Seleccione el voltaje del sistema</label>

                  <input
                    type="text"
                    id="voltajeSistema"
                    class="block w-full rounded-lg border border-gray-300 px-3 py-2"
                    readonly
                  />

                  <select
                    class="mt-3 hidden w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    id="voltajeSistemaSelect"
                  >
                    <option value="12">12V</option>
                    <option value="24">24V</option>
                    <option value="48">48V</option>
                  </select>

                  <div class="mt-4" id="lossSection"></div>

                  <div class="mt-4 block" id="voltajeSection">
                    <label class="inline-flex items-center gap-2 text-sm">
                      <input class="h-4 w-4" type="checkbox" id="voltajeCheckbox" />
                      <span>Quiero escoger mi voltaje</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Batería -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Cálculo del tamaño de la Batería</h5>
              <i class="bi bi-battery-charging"></i>
            </div>

            <div class="p-5">
              <div class="rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div class="md:col-span-2">
                    <label class="mb-2 block text-sm font-medium">Seleccionar la Batería:</label>
                    <select
                      id="batteryType"
                      class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <option value="acido-plomo">Ácido-Plomo</option>
                      <option value="agm">AGM</option>
                      <option value="gel">GEL</option>
                      <option value="plomo-carbono">Plomo-Carbono</option>
                      <option value="litio">Litio</option>
                    </select>

                    <label class="mb-2 block text-sm font-medium">
                      Seleccionar profundidad de descarga (DOD):
                    </label>
                    <select
                      id="batteryDOD"
                      class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <!-- Se llenará dinámicamente -->
                    </select>

                    <label class="mb-2 block text-sm font-medium">
                      Seleccionar la capacidad del banco de batería:
                    </label>
                    <select
                      id="ampSelect"
                      class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <!-- Se llenará dinámicamente -->
                    </select>

                    <label class="mb-2 block text-sm font-medium">Voltaje de la bateria:</label>
                    <select
                      id="voltajeSelect"
                      class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-700 p-2 text-white focus:border-red-500 focus:outline-none"
                    >
                      <!-- Se llenará dinámicamente -->
                    </select>

                    <div id="batterySeriesMessage" class="mt-2"></div>
                  </div>

                  <h5 class="mt-10 mb-3 text-lg font-semibold md:col-span-2">
                    Cálculo de la Batería requerida
                  </h5>

                  <div>
                    <label class="block text-sm text-gray-500">Energia Ajustada</label>
                    <div class="h4 text-2xl font-bold" id="batteryPow">0 Wh</div>
                  </div>

                  <div>
                    <label class="block text-sm text-gray-500">
                      Capacidad del Banco de Batería
                    </label>
                    <div class="h4 text-2xl font-bold" id="batteryCap">0 Ah</div>
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-sm text-gray-500">Arreglo de Baterías</label>
                    <div class="h4 text-2xl font-bold" id="ampValue">0</div>
                  </div>

                  <div class="hidden">
                    <label class="block text-sm text-gray-500">Baterías en Serie</label>
                    <div class="h4 text-2xl font-bold" id="ampValueSerie">0</div>
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-sm text-gray-500">Baterías Totales</label>
                    <div class="h4 text-2xl font-bold" id="battTotal">0</div>
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-sm text-gray-500">
                      Tiempo Aproximado de Autonomía
                    </label>
                    <div class="h4 text-2xl font-bold" id="tiempoAutonomia">0 horas</div>
                  </div>

                  <div
                    id="infoBateriaSistema"
                    class="mt-2 text-center font-bold md:col-span-2"
                  ></div>

                  <div
                    class="mt-4 flex h-[400px] w-full border border-black md:col-span-2"
                    id="myDiagramDiv"
                  >
                    <!-- Aquí se mostrará el diagrama de GoJS -->
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Inversor -->
          <div class="mb-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow block">
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">Cálculo del Inversor requerido</h5>
              <div class="flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <button
                  type="button"
                  class="rounded bg-red-700 px-2 py-1 text-sm text-white hover:bg-red-800"
                  id="cableInfo"
                  data-popover-content="Conocer mas para este inversor"
                >
                  ℹ️
                </button>
              </div>
            </div>

            <div class="p-5">
              <div class="rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4">
                  <h5 class="mb-3 text-lg font-semibold">Segun el sistema especificado</h5>

                  <div class="hidden">
                    <label class="block text-sm text-gray-500">Inversor seleccionado</label>
                    <div class="h4 text-2xl font-bold" id="inversor">0 W</div>
                  </div>

                  <div
                    id="productoInversor"
                    class="col-span-1 flex justify-center"
                  >
                    <!-- Aquí se mostrará el producto del inversor recomendado -->
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Paneles serie/paralelo -->
          <div
            class="mb-6 hidden overflow-hidden rounded-xl border border-gray-200 bg-white shadow block"
            id="panelSerieParaleloSection"
          >
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">
                Calculo de paneles en serie y en paralelo para el inversor seleccionado
              </h5>
              <span class="material-symbols-rounded">solar_power</span>
            </div>

            <div class="p-5">
              <div class="rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div class="md:col-span-2">
                    <label class="block text-sm text-gray-500">
                      Paneles Maximos que acepta el inversor
                    </label>
                    <div class="h4 text-2xl font-bold" id="panelTotal">0</div>
                  </div>

                  <div class="md:col-span-2">
                    <div id="panelMarcaContainer"></div>
                  </div>

                  <div>
                    <label class="block text-sm text-gray-500">Máximo de paneles en Serie</label>
                    <div class="h4 text-2xl font-bold" id="panelSerie">0</div>
                  </div>

                  <div>
                    <label class="block text-sm text-gray-500">
                      Máximo de paneles en Paralelo
                    </label>
                    <div class="h4 text-2xl font-bold" id="panelParalelo">0</div>
                  </div>

                  <div
                    class="col-span-1 mt-10 rounded-lg border border-yellow-300 bg-yellow-100 p-4 text-yellow-900 md:col-span-2"
                    role="alert"
                  >
                    <div class="h4 text-xl font-bold">Conexión de Paneles para su caso ⚠️</div>
                    <label id="conexionPaneles">0</label>
                  </div>

                  <h5 class="mt-10 mb-4 text-lg font-semibold md:col-span-2">
                    Ilustración general de conexión en serie y paralelo para paneles
                  </h5>

                  <div class="col-span-1 flex items-center justify-between md:col-span-2">
                    <img
                      src="/assets/img/panelsolar.png"
                      class="w-full"
                      alt="Conexión de paneles solares"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tabla AWG -->
          <div
            class="mb-6 hidden overflow-hidden rounded-xl border border-gray-200 bg-white shadow block"
            id="cableSection"
          >
            <div class="flex items-center justify-between bg-red-600 px-5 py-4 text-white">
              <h5 class="m-0 text-lg font-semibold">
                Tabla del amperaje que soportan los cables de cobre AWG
              </h5>
              <i class="bi bi-lightning-charge-fill"></i>
            </div>

            <div class="p-5">
              <div class="rounded-lg bg-gray-50 p-4 total-section">
                <div class="grid grid-cols-1 gap-4">
                  <div class="flex items-center justify-center">
                    <img
                      src="/assets/img/amperajetabla.png"
                      class="w-full"
                      alt="Tabla de amperaje AWG"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Botones -->
          <div class="mx-auto w-full max-w-md">
            <div class="grid grid-cols-1 gap-3 text-center">
              <button
                type="button"
                class="mt-3 w-full rounded-lg bg-yellow-500 px-4 py-3 font-semibold text-black transition duration-300 hover:scale-105 hover:bg-yellow-400"
                id="btnPDF"
              >
                Generar PDF
              </button>

              <button
                type="button"
                class="mt-3 w-full rounded-lg bg-yellow-500 px-4 py-3 font-semibold text-black transition duration-300 hover:scale-105 hover:bg-yellow-400"
                id="btnContacto"
              >
                Contactar a un asesor comercial
              </button>

              <div class="mt-10 text-center" id="pdfMessage">
                <!-- Mensaje que se mostrará al generar el PDF -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/@turf/turf@6/turf.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://unpkg.com/gojs/release/go.js"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,200&icon_names=solar_power" />

</BaseLayout>