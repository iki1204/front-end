---
import Layout from '../layouts/LayoutCalculadora.astro';
---

<Layout title="Unicom - Calculadora Solar">
  <main class="bg-[linear-gradient(180deg,#FFF9F8_0%,#FFF4EE_42%,#ffffff_100%)] pb-24 pt-10 dark:bg-[linear-gradient(180deg,#170802_0%,#2A0F0F_50%,#170202_100%)]">
    <section class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center rounded-full border border-red-200 bg-red-50 px-4 py-1 text-xs font-semibold uppercase tracking-[0.28em] text-red-700 dark:border-red-400/20 dark:bg-red-400/10 dark:text-red-100">
          Calculadora solar
        </span>
        <h1 class="mt-5 text-balance text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl dark:text-white">
          Selecciona primero el tipo de sistema que quieres instalar
        </h1>
      </div>

      <div class="overflow-hidden rounded-[2.25rem] border border-slate-500/20 bg-white/90 shadow-[0_30px_80px_-32px_rgba(42,15,15,0.35)] backdrop-blur dark:border-white/10 dark:bg-slate-950/80">
        <div class="grid min-h-[680px] lg:grid-cols-[1fr_auto_1fr]" data-calculator-shell>
          <article
            class="group relative isolate flex min-h-[340px] flex-col items-center justify-between overflow-hidden px-6 py-10 text-center transition duration-300 sm:px-10 lg:min-h-[680px]"
            data-calculator-option
            data-mode="on-grid"
          >
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,141,50,0.18),transparent_38%),linear-gradient(180deg,#ffffff_0%,#fff8f0_100%)] dark:bg-[radial-gradient(circle_at_top,rgba(255,141,50,0.22),transparent_38%),linear-gradient(180deg,#4a0808_0%,#170902_100%)]"></div>
            <div class="absolute inset-x-8 bottom-10 h-20 rounded-full bg-rose-300/45 blur-3xl dark:bg-rose-400/10"></div>
            <div class="relative flex w-full justify-center">
              <a
                type="button"
                class=" cursor-not-allowed inline-flex items-center justify-center rounded-xl bg-gradient-to-b from-orange-400 to-red-700 px-8 py-4 text-base font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-red-600/30 transition duration-300 hover:-translate-y-1 hover:shadow-red-500/40"
              >
                Muy pronto ...
              </a>
            </div>

            <div class="relative flex w-full flex-1 items-center justify-center py-10">
              <div class="relative h-[320px] w-[240px] rounded-[2rem] border border-slate-200 bg-white shadow-[0_30px_70px_-35px_rgba(6,95,70,0.45)] transition duration-500 group-hover:-translate-y-2 group-hover:rotate-[-1.5deg] dark:border-slate-700 dark:bg-slate-100">
                <div class="absolute top-20 left-1/2 h-20 w-16 -translate-x-1/2 rounded-2xl border-[6px] border-slate-900 bg-slate-200 shadow-inner"></div>
                <div class="absolute left-1/2 top-[7.4rem] flex -translate-x-1/2 items-center gap-2 text-slate-900">
                  <div class="absolute right-7 bottom-15 text-xl font-black tracking-widest text-cyan-600">FYTEC</div>
                  <div class="absolute top-20 flex -translate-x-1/2 items-center gap-2 text-slate-900">
                    <span class="size-3 rounded-full border border-slate-700"></span>
                    <span class="size-3 rounded-full border border-slate-700"></span>
                    <span class="size-3 rounded-full border border-slate-700"></span>
                  </div>

                </div>
                <div class="absolute inset-x-0 bottom-0 h-11 rounded-b-[2rem] bg-slate-900"></div>
                <div class="absolute bottom-11 left-1/2 h-5 w-20 -translate-x-1/2 rounded-t-xl bg-slate-700"></div>
              </div>
              <div class="absolute bottom-2 h-24 w-[72%] rounded-[50%] bg-gradient-to-b from-slate-200/80 to-transparent opacity-75 blur-sm"></div>
            </div>

            <div class="relative max-w-md space-y-3">
              <p class="text-xs font-semibold uppercase tracking-[0.34em] text-orange-700 dark:text-cyan-200">Conectado a la red</p>
              <h2 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">On-Grid</h2>
              <p class="text-sm leading-7 text-slate-600 dark:text-slate-300 sm:text-base">
                Optimiza ahorro, retorno de inversión y dimensionamiento para sistemas interconectados.
              </p>
            </div>
          </article>

          <div class="hidden w-[3px] bg-gradient-to-b from-transparent via-slate-900 to-transparent lg:block"></div>

          <article
            class="group relative isolate flex min-h-[340px] flex-col items-center justify-between overflow-hidden border-t border-slate-200/80 px-6 py-10 text-center transition duration-300 sm:px-10 lg:min-h-[680px] lg:border-l lg:border-t-0 lg:border-slate-200/80 dark:border-white/10"
            data-calculator-option
            data-mode="off-grid"
          >
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(16,185,129,0.18),transparent_38%),linear-gradient(180deg,#ffffff_0%,#f0fdf4_100%)] dark:bg-[radial-gradient(circle_at_top,rgba(16,185,129,0.25),transparent_38%),linear-gradient(180deg,#052e2b_0%,#020617_100%)]"></div>
            <div class="absolute inset-x-8 bottom-10 h-20 rounded-full bg-amber-200/45 blur-3xl dark:bg-amber-400/10"></div>
            <div class="relative flex w-full justify-center">
              <a
                type="button"
                class="inline-flex items-center justify-center rounded-xl bg-gradient-to-b from-orange-400 to-red-700 px-8 py-4 text-base font-black uppercase tracking-[0.12em] text-white shadow-lg shadow-red-600/30 transition duration-300 hover:-translate-y-1 hover:shadow-red-500/40"
                href="/off-grid"
              >
                Haz clic aquí
              </a>
            </div>

            <div class="relative flex w-full flex-1 items-center justify-center py-10">
              <div class="relative h-[320px] w-[220px] rounded-[2rem] border border-slate-200 bg-white shadow-[0_30px_70px_-35px_rgba(8,47,73,0.45)] transition duration-500 group-hover:-translate-y-2 group-hover:rotate-[1.5deg] dark:border-slate-700 dark:bg-slate-100">
                <div class="absolute left-4 top-0 h-full w-4 rounded-l-[2rem] bg-slate-800"></div>
                <div class="absolute right-6 top-10 text-xl font-black tracking-widest text-rose-600">MUST</div>
                <div class="absolute left-1/2 top-1/2 h-7 w-[4.5rem] -translate-x-1/2 rounded-xl bg-slate-900"></div>
                <div class="absolute left-1/2 top-[57%] flex -translate-x-1/2 items-center gap-1">
                  <span class="size-2 rounded-full bg-emerald-400"></span>
                  <span class="size-2 rounded-full bg-slate-400"></span>
                  <span class="size-2 rounded-full bg-rose-500"></span>
                </div>
                <div class="absolute bottom-7 left-1/2 h-8 w-24 -translate-x-1/2 rounded-b-2xl rounded-t-lg bg-slate-900"></div>
                <div class="absolute bottom-[4.25rem] left-1/2 -translate-x-1/2 text-sm font-bold uppercase tracking-[0.2em] text-slate-500">Green Energy</div>
              </div>
              <div class="absolute bottom-2 h-24 w-[72%] rounded-[50%] bg-gradient-to-b from-slate-200/80 to-transparent opacity-75 blur-sm"></div>
            </div>

            <div class="relative max-w-md space-y-3">
              <p class="text-xs font-semibold uppercase tracking-[0.34em] text-emerald-700 dark:text-emerald-200">Autonomía energética</p>
              <h2 class="text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">Off-Grid</h2>
              <p class="text-sm leading-7 text-slate-600 dark:text-slate-300 sm:text-base">
                Calcula respaldo, autonomía y bancos de baterías para instalaciones aisladas de la red.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>


</Layout>
