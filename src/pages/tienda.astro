                <a
                  href={Astro.url.pathname + buildQueryString({ page: pageNumber })}
                  class={`flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold transition ${
                    isActive
                      ? "bg-primary text-white"
                      : "bg-white text-zinc-700 hover:border-primary hover:text-primary dark:bg-zinc-900 dark:text-zinc-200"
                  }`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {pageNumber}
                </a>
              );
            })}

            {showRightDots && (
              <>
                <span class="px-1 text-zinc-400">…</span>
                <a
                  href={Astro.url.pathname + buildQueryString({ page: totalPages })}
                  class={`flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold transition ${
                    currentPage === totalPages
                      ? "bg-primary text-white"
                      : "bg-white text-zinc-700 hover:border-primary hover:text-primary dark:bg-zinc-900 dark:text-zinc-200"
                  }`}
                  aria-label={`Página ${totalPages}`}
                >{totalPages}</a>
              </>
            )}
          </div>

        </section>
      </div>
    </article>
  </Container>

  <script is:inline>
    (() => {
      const CATALOG_ENDPOINT = "/api/catalogo/catalogo-productos";
      const STORAGE_KEY = "unicomec:catalogo-compacto:v3";
      const MAX_AGE = 10 * 60 * 1000;
      const MAX_SUGGESTIONS = 6;
      const SUGGESTION_DELAY = 70;

      const searchScope = document.querySelector("[data-search-suggestions]");
      const searchInput = searchScope?.querySelector("input[type='search']");
      const suggestionsPanel = searchScope?.querySelector("[data-suggestions-panel]");
      const suggestionsList = searchScope?.querySelector("[data-suggestions-list]");

      let catalogProducts = [];
      let catalogReady = false;
      let catalogPromise = null;
      let suggestionTimer = 0;
      let renderVersion = 0;

      const normalizeText = (value) =>
        String(value ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();

      const escapeHTML = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const prepareCatalog = (products) =>
        products.map((product) => ({
          ...product,
          _name: product?.nombre || product?.codigo || "Producto",
          _code: product?.codigo || "",
          _slug: String(product?.slug ?? product?.id ?? ""),
          _searchIndex: normalizeText(
            product?.searchIndex ||
              [product?.nombre, product?.codigo, product?.identifier]
                .filter(Boolean)
                .join(" "),
          ),
        }));

      const readStoredCatalog = () => {
        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (!raw) return null;

          const stored = JSON.parse(raw);
          const isFresh =
            stored &&
            Array.isArray(stored.products) &&
            Date.now() - Number(stored.savedAt ?? 0) <= MAX_AGE;

          if (!isFresh) {
            sessionStorage.removeItem(STORAGE_KEY);
            return null;
          }

          return stored.products;
        } catch {
          return null;
        }
      };

      const saveCatalog = (products) => {
        try {
          sessionStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ savedAt: Date.now(), products }),
          );
        } catch {
          // La tienda sigue funcionando sin sessionStorage.
        }
      };

      const loadCatalog = async () => {
        if (catalogReady) return catalogProducts;
        if (catalogPromise) return catalogPromise;

        const stored = readStoredCatalog();
        if (stored) {
          catalogProducts = prepareCatalog(stored);
          catalogReady = true;
          return catalogProducts;
        }

        catalogPromise = fetch(CATALOG_ENDPOINT, {
          headers: { Accept: "application/json" },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error(`No se pudo cargar el catálogo (${response.status})`);
            }
            return response.json();
          })
          .then((payload) => {
            const products = Array.isArray(payload?.products)
              ? payload.products
              : [];
            saveCatalog(products);
            catalogProducts = prepareCatalog(products);
            catalogReady = true;
            return catalogProducts;
          })
          .finally(() => {
            catalogPromise = null;
          });

        return catalogPromise;
      };

      const hideSuggestions = () => {
        renderVersion += 1;
        suggestionsPanel?.classList.add("hidden");
        suggestionsList?.replaceChildren();
      };

      const findMatches = (products, terms) => {
        const matches = [];

        for (const product of products) {
          if (!product._slug) continue;
          if (!terms.every((term) => product._searchIndex.includes(term))) continue;

          matches.push(product);
          if (matches.length === MAX_SUGGESTIONS) break;
        }

        return matches;
      };

      const renderSuggestions = async () => {
        if (
          !(searchInput instanceof HTMLInputElement) ||
          !(suggestionsPanel instanceof HTMLElement) ||
          !(suggestionsList instanceof HTMLElement)
        ) {
          return;
        }

        const terms = normalizeText(searchInput.value).split(/\s+/).filter(Boolean);
        if (terms.length === 0) {
          hideSuggestions();
          return;
        }

        const currentVersion = ++renderVersion;

        try {
          const products = await loadCatalog();
          if (currentVersion !== renderVersion) return;

          const currentTerms = normalizeText(searchInput.value)
            .split(/\s+/)
            .filter(Boolean);
          if (currentTerms.join("|") !== terms.join("|")) return;

          const matches = findMatches(products, terms);
          suggestionsList.innerHTML = matches
            .map((product) => {
              const name = escapeHTML(product._name);
              const code = escapeHTML(product._code);
              const slug = encodeURIComponent(product._slug);
              const image = product?.imagenUrl
                ? `<img src="${escapeHTML(product.imagenUrl)}" alt="" width="40" height="40" loading="lazy" class="h-10 w-10 rounded-lg bg-white object-contain" />`
                : `<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 text-[11px] font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">${escapeHTML((code || name.slice(0, 2)).toUpperCase())}</span>`;

              return `<li><a href="/producto/${slug}" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-zinc-700 transition hover:bg-primary/10 hover:text-primary dark:text-zinc-200">${image}<span class="min-w-0"><span class="block truncate font-medium">${name}</span>${code ? `<span class="block truncate text-xs text-zinc-500">${code}</span>` : ""}</span></a></li>`;
            })
            .join("");

          suggestionsPanel.classList.toggle("hidden", matches.length === 0);
        } catch (error) {
          console.warn("No se pudieron cargar las sugerencias:", error);
          hideSuggestions();
        }
      };

      if (searchInput instanceof HTMLInputElement) {
        searchInput.addEventListener("input", () => {
          window.clearTimeout(suggestionTimer);
          suggestionTimer = window.setTimeout(renderSuggestions, SUGGESTION_DELAY);
        });
        searchInput.addEventListener("focus", renderSuggestions);
        searchInput.addEventListener("blur", () => {
          window.setTimeout(hideSuggestions, 160);
        });
      }

      document.querySelectorAll("[data-filter-select]").forEach((element) => {
        if (!(element instanceof HTMLSelectElement)) return;
        element.addEventListener("change", () => {
          if (element.value) window.location.assign(element.value);
        });
      });

      const currencyFormatter = new Intl.NumberFormat("es-PE", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });

      document.querySelectorAll("[data-price-input]").forEach((element) => {
        if (!(element instanceof HTMLInputElement)) return;

        element.addEventListener("input", () => {
          const output = element
            .closest("[data-price-range]")
            ?.querySelector("[data-price-range-output]");
          if (output) output.textContent = currencyFormatter.format(Number(element.value));
        });

        element.addEventListener("change", () => element.form?.requestSubmit());
      });

      const warmCatalog = () => loadCatalog().catch(() => {});
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(warmCatalog, { timeout: 1500 });
      } else {
        window.setTimeout(warmCatalog, 300);
      }
    })();
  </script>

   <script is:inline>
    const preloader = document.querySelector("[data-preloader]");
    if (preloader) {
      let preloaderHidden = false;
      const hidePreloader = () => {
        if (preloaderHidden) return;
        preloaderHidden = true;
        preloader.classList.add("opacity-0");
        preloader.setAttribute("aria-busy", "false");
        setTimeout(() => {
          preloader.classList.add("hidden");
        }, 200);
      };

      const showPreloader = () => {
        preloaderHidden = false;
        preloader.classList.remove("hidden", "opacity-0");
        preloader.setAttribute("aria-busy", "true");
      };

      const waitForCurrentAssets = async () => {
        const images = Array.from(document.images).filter(
          (image) => image instanceof HTMLImageElement && image.loading !== "lazy" && !image.complete,
        );

        await Promise.allSettled(
          images.map(
            (image) =>
              new Promise((resolve) => {
                image.addEventListener("load", resolve, { once: true });
                image.addEventListener("error", resolve, { once: true });
              }),
          ),
        );

        if (document.fonts?.ready) {
          await document.fonts.ready.catch(() => undefined);
        }
      };

      const hideAfterFullPageLoad = () => {
        waitForCurrentAssets().finally(hidePreloader);
      };

      if (document.readyState === "complete") {
        hideAfterFullPageLoad();
      } else {
        window.addEventListener("load", hideAfterFullPageLoad, { once: true });
      }

      window.addEventListener("pageshow", (event) => {
        if (event.persisted || document.readyState === "complete") {
          hideAfterFullPageLoad();
        }
      });

      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (form instanceof HTMLFormElement) {
          showPreloader();
        }
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a");
        if (!link || link.target === "_blank" || link.hasAttribute("download")) {
          return;
        }
        const href = link.getAttribute("href") ?? "";
        if (href.startsWith("#")) return;
        if (link.hasAttribute("data-no-preloader")) return;
        showPreloader();
      });
    }
  </script>
</BaseLayout>