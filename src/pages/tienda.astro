        >
          <label for="mobileStock" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por stock:
          </label>
          <select
            id="mobileStock"
            class="mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-white"
            data-filter-select
          >
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "all", bodega: "all", page: 1, search: null})}
              selected={stockParam === "all"}
            >
              TODOS
            </option>
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "in", bodega: "all", page: 1, search: null })}
              selected={stockParam === "in" && !hasSelectedBodegas}
            >
              En stock (todas las bodegas)
            </option>
            {bodegaOptions.map((bodegaNombre) => (
              <option
                value={Astro.url.pathname + buildQueryString({ stock: "in", bodega: bodegaNombre, page: 1, search: null })}
                selected={stockParam === "in" && selectedBodegas.includes(bodegaNombre)}
              >
                En stock · {bodegaNombre}
              </option>
            ))}
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "out", bodega: "all", page: 1, search: null })}
              selected={stockParam === "out"}
            >
              Sin stock
            </option>
          </select>
        </div>

        <div class="group relative block" data-admin-visible>
          <label for="mobileImage" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por imagen:
          </label>
          <select
            id="mobileImage"
            class="mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-white"
            data-filter-select
          >
            <option
              value={Astro.url.pathname + buildQueryString({ image: "all", page: 1, search: null })}
              selected={imageParam === "all"}
            >
              TODOS
            </option>
            <option
              value={Astro.url.pathname + buildQueryString({ image: "with", page: 1, search: null })}
              selected={imageParam === "with"}
            >
              Con imagen
            </option>
            <option
              value={Astro.url.pathname + buildQueryString({ image: "without", page: 1, search: null })}
              selected={imageParam === "without"}
            >
              Sin imagen
            </option>
          </select>
        </div>

        <div class="group relative block" data-admin-visible>
          <label for="mobileDatasheets" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por datasheets:
          </label>
