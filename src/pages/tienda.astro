---
import BaseLayout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Container from "../components/Container.astro";
import { getCategorias, getGlobalData, getMarcas } from "../lib/api";
import { getCachedCatalogProducts, normalizeCatalogText } from "../lib/catalogCache";



const ua = Astro.request.headers.get("user-agent") ?? "";
const isCrawler = /meta-externalagent|facebookexternalhit|WhatsApp|Twitterbot|Slackbot/i.test(ua);


const ITEMS_PER_PAGE = 40;
const MAX_PRICE = 5000;
const MIN_PRICE = 0;

const normalizeWithAttributes = (item: any) => (item?.attributes ? { id: item.id, ...item.attributes } : item);
const normalizeCollection = (collection: any[] = []) => collection.map(normalizeWithAttributes);

const url = new URL(Astro.request.url);
const hasQuery = Array.from(url.searchParams.keys()).length > 0;

const stopIndexing = isCrawler && hasQuery;
if (stopIndexing) {
  Astro.response.headers.set("Cache-Control", "no-store");
}


const searchParam = url.searchParams.get("search")?.toLowerCase().trim() ?? "";
const searchTerms = searchParam.split(/\s+/).filter(Boolean);
const normalizedSearchParam = searchTerms.join(" ");
const categoryParam = url.searchParams.get("category") ?? "all";
const brandParam = url.searchParams.get("brand") ?? "all";
const stockParam = url.searchParams.get("stock") ?? "all";
const bodegaParams = url.searchParams
  .getAll("bodega")
  .map((value) => value.trim())
  .filter(Boolean);
const selectedBodegas = Array.from(new Set(bodegaParams.filter((value) => value !== "all")));
const selectedBodegasNormalized = selectedBodegas.map((value) => value.toLowerCase().trim());
const hasSelectedBodegas = selectedBodegas.length > 0;
const bodegaHiddenValues = hasSelectedBodegas ? selectedBodegas : ["all"];
const imageParam = url.searchParams.get("image") ?? "all";
const datasheetsParam = url.searchParams.get("datasheets") ?? "all";
const descriptionParam = url.searchParams.get("description") ?? "all";
const pageParam = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
const requestedPage = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const priceParamRaw = Number.parseInt(url.searchParams.get("price") ?? String(MAX_PRICE), 10);
const priceFilterValue = Number.isFinite(priceParamRaw)
  ? Math.min(Math.max(priceParamRaw, MIN_PRICE), MAX_PRICE)
  : MAX_PRICE;

const productMatchesFilters = (product: any) => {
  if (categoryParam !== "all" && String(product?.categoriaId ?? product?.ID_Categoria ?? "") !== categoryParam) return false;
  if (brandParam !== "all" && String(product?.marcaId ?? product?.ID_Marca ?? "") !== brandParam) return false;

const stock = Number(product?.stock ?? product?.cantidad_stock ?? 0);
  if (stockParam === "in" && !(Number.isFinite(stock) && stock > 0)) return false;
  if (stockParam === "out" && Number.isFinite(stock) && stock > 0) return false;

const price = Number(product?.precio ?? 0);
  if (priceFilterValue < MAX_PRICE && Number.isFinite(price) && price > priceFilterValue) return false;
  if (imageParam === "with" && !product?.tieneImagen) return false;
  if (imageParam === "without" && product?.tieneImagen) return false;
  if (datasheetsParam === "with" && !product?.tieneDatasheet) return false;
  if (datasheetsParam === "without" && product?.tieneDatasheet) return false;
  if (descriptionParam === "with" && !product?.tieneDescripcion) return false;
  if (descriptionParam === "without" && product?.tieneDescripcion) return false;
  if (searchTerms.length > 0) {
    const searchIndex = String(product?.searchIndex ?? normalizeCatalogText([product?.nombre, product?.codigo, product?.identifier].filter(Boolean).join(" ")));
    if (!searchTerms.every((term) => searchIndex.includes(normalizeCatalogText(term)))) return false;
  }
  return true;
};

const paginateProducts = (items: any[]) => {
  const pages = Math.max(1, Math.ceil(items.length / ITEMS_PER_PAGE));
  const page = Math.min(Math.max(requestedPage, 1), pages);
  const start = (page - 1) * ITEMS_PER_PAGE;

  return {
      page,
      pages,
      total: items.length,
      items: items.slice(start, start + ITEMS_PER_PAGE),
    };
};

const bodegaStockCache = new Map<string, Promise<any[]>>();

const fetchBodegaStockRows = (identifier: string | null): Promise<any[]> => {
  if (!identifier) return Promise.resolve([]);

  const cacheKey = String(identifier);
  const cached = bodegaStockCache.get(cacheKey);
  if (cached) return cached;

  const request = (async () => {
    try {
      const endpoint = new URL(
        `/api/bodega-stock/${encodeURIComponent(cacheKey)}`,
        url.origin,
      ).toString();
      const response = await fetch(endpoint, { cache: "no-store" });
      if (!response.ok) return [];

      const data = await response.json();
      return Array.isArray(data) ? data : [];
    } catch {
      return [];
    }
  })();

  bodegaStockCache.set(cacheKey, request);
  return request;
};

const mapWithConcurrency = async <T, R>(
  items: T[],
  concurrency: number,
  mapper: (item: T, index: number) => Promise<R>,
): Promise<R[]> => {
  const results = new Array<R>(items.length);
  let nextIndex = 0;

  const workers = Array.from(
    { length: Math.min(Math.max(concurrency, 1), items.length) },
    async () => {
      while (nextIndex < items.length) {
        const currentIndex = nextIndex;
        nextIndex += 1;
        results[currentIndex] = await mapper(items[currentIndex], currentIndex);
      }
    },
  );

  await Promise.all(workers);
  return results;
};

// Wrapper para fallar silenciosamente en fetches
const safeAsyncFetch = async <T,>(fn: () => Promise<T>, defaultValue: T, label: string): Promise<T> => {
  try {
    return await fn();
  } catch (error) {
    console.error(`Error in ${label}:`, error);
    return defaultValue;
  }
};

const [categoriasResponse, marcasResponse, global, catalogResponse] = await Promise.all([
  safeAsyncFetch(() => getCategorias(), { data: [] }, "getCategorias"),
  safeAsyncFetch(() => getMarcas(), { data: [] }, "getMarcas"),
  safeAsyncFetch(() => getGlobalData(), {}, "getGlobalData"),
  safeAsyncFetch(() => getCachedCatalogProducts(), {
    products: [],
    version: "",
    total: 0
  }, "getCachedCatalogProducts"),
]);

const bodegaNamesSet = new Set<string>();
let productos: any[] = [];
let totalPages = 1;
let currentPage = requestedPage;
let totalItems = 0;

const cachedProducts = Array.isArray(catalogResponse?.products) ? catalogResponse.products : [];
const filteredCandidates = cachedProducts.filter(productMatchesFilters);

if (stockParam === "in" && hasSelectedBodegas) {
  const matchChecks = await mapWithConcurrency(
    filteredCandidates,
    12,
    async (item) => {
      const identifier = item?.identifier ? String(item.identifier) : null;
      const bodegaRows = await fetchBodegaStockRows(identifier);

      bodegaRows.forEach((row) => {
        const nombre = String(row?.bodega_nombre ?? "").trim();
        if (nombre) bodegaNamesSet.add(nombre);
      });

      const hasStockInSelectedBodega = bodegaRows.some((row) => {
        const nombre = String(row?.bodega_nombre ?? "").trim().toLowerCase();
        const cantidad = Number(row?.cantidad ?? 0);
        return selectedBodegasNormalized.includes(nombre) && Number.isFinite(cantidad) && cantidad > 0;
      });

      return hasStockInSelectedBodega ? item : null;
    },
  );

  const paginated = paginateProducts(matchChecks.filter(Boolean) as any[]);
  productos = paginated.items;
  totalItems = paginated.total;
  totalPages = paginated.pages;
  currentPage = paginated.page;
} else {
  const paginated = paginateProducts(filteredCandidates);
  productos = paginated.items;
  totalItems = paginated.total;
  totalPages = paginated.pages;
  currentPage = paginated.page;

  const rowsByProduct = await Promise.all(
    productos.map(async (item) => {
      const identifier = item?.identifier ? String(item.identifier) : null;
      return fetchBodegaStockRows(identifier);
    }),
  );

  rowsByProduct.flat().forEach((row) => {
    const nombre = String(row?.bodega_nombre ?? "").trim();
    if (nombre) bodegaNamesSet.add(nombre);
  });
}

const bodegaOptions = Array.from(bodegaNamesSet).sort((a, b) => a.localeCompare(b, "es", { sensitivity: "base" }));


const getStrapiFileUrl = (file: any) => {
  const data = file?.data ?? file;
  const url = data?.attributes?.url ?? data?.url;

  if (!url) return null;
  if (url.startsWith("https")) return url;

  return `${import.meta.env.VITE_STRAPI_URL ?? ""}${url}`;
};

const categorias = normalizeCollection(categoriasResponse?.data ?? []);
const marcas = normalizeCollection(marcasResponse?.data ?? []);

const buildQueryString = (updates: Record<string, string | number | null>) => {
  const params = new URLSearchParams(url.searchParams);

  Object.entries(updates).forEach(([key, value]) => {
    if (value === null || value === "") {
      params.delete(key);
    } else {
      params.set(key, String(value));
    }
  });

  const query = params.toString();
  return query ? `?${query}` : "";
};

type HiddenField = { name: string; value: string | number };

const buildHiddenFields = (
  overrides: Record<string, string | number | string[]> = {},
): HiddenField[] => {
  const state: Record<string, string | number | string[]> = {
    category: categoryParam,
    brand: brandParam,
    stock: stockParam,
    bodega: bodegaHiddenValues,
    image: imageParam,
    datasheets: datasheetsParam,
    description: descriptionParam,
    price: priceFilterValue,
    page: 1,
    ...overrides,
  };

  return Object.entries(state).flatMap(([name, value]) =>
    (Array.isArray(value) ? value : [value]).map((item) => ({
      name,
      value: item,
    })),
  );
};

const priceFilterHiddenFields = buildHiddenFields({ price: [] });
const bodegaFilterHiddenFields = buildHiddenFields({
  stock: "in",
  bodega: ["all"],
});
const searchResetHiddenFields = buildHiddenFields({
  category: "all",
  brand: "all",
  stock: "all",
  bodega: ["all"],
  image: "all",
  datasheets: "all",
  description: "all",
  price: "all",
});

const datasheetOptions = [
  { label: "Todos", value: "all" },
  { label: "Con datasheets", value: "with" },
  { label: "Sin datasheets", value: "without" },
];
const imageOptions = [
  { label: "Todos", value: "all" },
  { label: "Con imagen", value: "with" },
  { label: "Sin imagen", value: "without" },
];
const descriptionOptions = [
  { label: "Todas", value: "all" },
  { label: "Con descripción", value: "with" },
  { label: "Sin descripción", value: "without" },
];

const getRelationArray = (relation: any) => {
  const dataArray = Array.isArray(relation?.data) ? relation.data : relation?.data ? [relation.data] : relation;
  const values = Array.isArray(dataArray) ? dataArray : [dataArray];

  return values.filter(Boolean).map(normalizeWithAttributes);
};

const getParentRelation = (categoria: any) => getRelationArray(categoria?.padre_id)[0] ?? null;
const getChildrenRelations = (categoria: any) => getRelationArray(categoria?.hijo_id);

const formatCategoryItem = (categoria: any) => ({
  label: categoria?.nombre ?? "Sin nombre",
  value: categoria?.ID_Categoria ?? categoria?.id,
  image: getStrapiFileUrl(categoria?.cat_img),
});

const parentCategoryItems = categorias
  .filter((categoria) => !getParentRelation(categoria))
  .map((categoria) => ({
    ...formatCategoryItem(categoria),
    children: getChildrenRelations(categoria).map(formatCategoryItem),
  }))
  .filter((categoria) => categoria.children.length > 0);

const brandItems = marcas
  .map((marca) => ({
    label: marca?.nombre ?? "Sin nombre",
    value: marca?.ID_Marca ?? marca?.id,
    image: getStrapiFileUrl(marca?.logo ?? marca?.imagen),
  }))
  .filter((marca) => Boolean(marca.value))
  .sort((a, b) =>
    a.label.localeCompare(b.label, "es", {
      sensitivity: "base",
    })
  );

const priceFormatter = new Intl.NumberFormat("es-PE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
  minimumFractionDigits: 0,
});

type ActiveFilter = {
  key: string;
  label: string;
  removeHref: string;
};

const selectedCategory = parentCategoryItems
  .flatMap((parent) => parent.children)
  .find((category) => String(category.value) === categoryParam);

const selectedBrand = brandItems.find(
  (brand) => String(brand.value) === brandParam,
);

const activeFilters: ActiveFilter[] = [];

if (categoryParam !== "all") {
  activeFilters.push({
    key: "category",
    label: `Categoría: ${selectedCategory?.label ?? categoryParam}`,
    removeHref:
      Astro.url.pathname +
      buildQueryString({ category: "all", page: 1 }),
  });
}

if (brandParam !== "all") {
  activeFilters.push({
    key: "brand",
    label: `Marca: ${selectedBrand?.label ?? brandParam}`,
    removeHref:
      Astro.url.pathname + buildQueryString({ brand: "all", page: 1 }),
  });
}

if (stockParam !== "all") {
  const stockLabel =
    stockParam === "out"
      ? "Stock: Sin stock"
      : hasSelectedBodegas
        ? `Stock: En stock · ${selectedBodegas.join(", ")}`
        : "Stock: En stock";

  activeFilters.push({
    key: "stock",
    label: stockLabel,
    removeHref:
      Astro.url.pathname +
      buildQueryString({ stock: "all", bodega: null, page: 1 }),
  });
}

const simpleActiveFilterConfigs = [
  {
    key: "image",
    value: imageParam,
    labels: { with: "Imagen: Con imagen", without: "Imagen: Sin imagen" },
  },
  {
    key: "datasheets",
    value: datasheetsParam,
    labels: {
      with: "Datasheet: Con datasheet",
      without: "Datasheet: Sin datasheet",
    },
  },
  {
    key: "description",
    value: descriptionParam,
    labels: {
      with: "Descripción: Con descripción",
      without: "Descripción: Sin descripción",
    },
  },
] as const;

simpleActiveFilterConfigs.forEach(({ key, value, labels }) => {
  if (value === "all") return;

  activeFilters.push({
    key,
    label: value === "with" ? labels.with : labels.without,
    removeHref:
      Astro.url.pathname + buildQueryString({ [key]: "all", page: 1 }),
  });
});

if (priceFilterValue < MAX_PRICE) {
  activeFilters.push({
    key: "price",
    label: `Precio máximo: ${priceFormatter.format(priceFilterValue)}`,
    removeHref:
      Astro.url.pathname + buildQueryString({ price: null, page: 1 }),
  });
}

//Paginacion
const maxVisible = 10;
const half = Math.floor(maxVisible / 2);

let startPage = Math.max(1, currentPage - half);
let endPage = startPage + maxVisible - 1;
if (endPage > totalPages) {
  endPage = totalPages;
  startPage = Math.max(1, endPage - maxVisible + 1);
}

const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
const pages = range(startPage, endPage);

const showLeftDots = startPage > 1;
const showRightDots = endPage < totalPages;



