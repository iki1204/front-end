---
import BaseLayout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Container from "../components/Container.astro";
import { getCategorias, getGlobalData, getMarcas, getProductos } from "../lib/api";

const ua = Astro.request.headers.get("user-agent") ?? "";
const isCrawler = /meta-externalagent|facebookexternalhit|WhatsApp|Twitterbot|Slackbot/i.test(ua);


const ITEMS_PER_PAGE = 40;
const MAX_PRICE = 5000;
const MIN_PRICE = 0;

const normalizeWithAttributes = (item: any) => (item?.attributes ? { id: item.id, ...item.attributes } : item);
const normalizeCollection = (collection: any[] = []) => collection.map(normalizeWithAttributes);

const url = new URL(Astro.request.url);
const hasQuery = Array.from(url.searchParams.keys()).length > 0;

const stopIndexing = isCrawler && hasQuery;
if (stopIndexing) {
  Astro.response.headers.set("Cache-Control", "no-store");
}


const searchParam = url.searchParams.get("search")?.toLowerCase().trim() ?? "";
const searchTerms = searchParam.split(/\s+/).filter(Boolean);
const normalizedSearchParam = searchTerms.join(" ");
const categoryParam = url.searchParams.get("category") ?? "all";
const brandParam = url.searchParams.get("brand") ?? "all";
const stockParam = url.searchParams.get("stock") ?? "all";
const pageParam = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
const requestedPage = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;
const priceParamRaw = Number.parseInt(url.searchParams.get("price") ?? String(MAX_PRICE), 10);
const priceFilterValue = Number.isFinite(priceParamRaw)
  ? Math.min(Math.max(priceParamRaw, MIN_PRICE), MAX_PRICE)
  : MAX_PRICE;

const strapiParams = new URLSearchParams({
  "pagination[page]": String(requestedPage),
  "pagination[pageSize]": String(ITEMS_PER_PAGE),
  sort: "nombre:asc",
});

const applySearchFilters = (params: URLSearchParams, terms: string[]) => {
  terms.forEach((term, index) => {
    params.set(`filters[$and][${index}][$or][0][nombre][$containsi]`, term);
    params.set(`filters[$and][${index}][$or][1][codigo][$containsi]`, term);
  });
};

const hasSearch = searchTerms.length > 0;

if (hasSearch) {
  applySearchFilters(strapiParams, searchTerms);
} else {
  if (categoryParam !== "all") {
    strapiParams.set("filters[ID_Categoria][$eq]", categoryParam);
  }

  if (brandParam !== "all") {
    strapiParams.set("filters[ID_Marca][$eq]", brandParam);
  }

  if (stockParam === "in") {
    strapiParams.set("filters[cantidad_stock][$gt]", "0");
  }

  if (stockParam === "out") {
    strapiParams.set("filters[cantidad_stock][$lte]", "0");
  }

  if (priceFilterValue < MAX_PRICE) {
    strapiParams.set("filters[precio][$lte]", String(priceFilterValue));
  }
}

const getAllProductsForSuggestions = async () => {
  const suggestionParams = new URLSearchParams({
    "pagination[page]": "1",
    "pagination[pageSize]": "100",
    "fields[0]": "nombre",
    "fields[1]": "codigo",
    sort: "nombre:asc",
  });

  const items: any[] = [];
  let page = 1;
  let pageCount = 1;

  do {
    suggestionParams.set("pagination[page]", String(page));
    const response = await getProductos(suggestionParams);
    items.push(...normalizeCollection(response?.data ?? []));
    pageCount = response?.meta?.pagination?.pageCount ?? 1;
    page += 1;
  } while (page <= pageCount);

  return items;
};

const [productosResponse, categoriasResponse, marcasResponse, global, suggestionProducts] = await Promise.all([
  getProductos(strapiParams),
  getCategorias(),
  getMarcas(),
  getGlobalData(),
  isCrawler ? Promise.resolve([]) : getAllProductsForSuggestions(),
]);

const getStrapiFileUrl = (file: any) => {
  const data = file?.data ?? file;
  const url = data?.attributes?.url ?? data?.url;

  if (!url) return null;
  if (url.startsWith("http")) return url;

  return `${import.meta.env.VITE_STRAPI_URL ?? ""}${url}`;
};

const productos = normalizeCollection(productosResponse?.data ?? []);
const categorias = normalizeCollection(categoriasResponse?.data ?? []);
const marcas = normalizeCollection(marcasResponse?.data ?? []);

const paginationMeta = productosResponse?.meta?.pagination ?? {};
const totalPages = Math.max(1, paginationMeta.pageCount ?? 1);
const currentPage = Math.min(Math.max(paginationMeta.page ?? requestedPage, 1), totalPages);
const totalItems = paginationMeta.total ?? productos.length;

const buildQueryString = (updates: Record<string, string | number | null>) => {
  const params = new URLSearchParams(url.searchParams);

  Object.entries(updates).forEach(([key, value]) => {
    if (value === null || value === "") {
      params.delete(key);
      return;
    }
    params.set(key, String(value));
  });

  if ("page" in updates) {
    if (updates.page === null) {
      params.delete("page");
    } else {
      params.set("page", String(updates.page));
    }
  }

  const query = params.toString();
  return query ? `?${query}` : "";
};

const getRelationArray = (relation: any) => {
  const dataArray = Array.isArray(relation?.data) ? relation.data : relation?.data ? [relation.data] : relation;
  const values = Array.isArray(dataArray) ? dataArray : [dataArray];

  return values.filter(Boolean).map(normalizeWithAttributes);
};

const getParentRelation = (categoria: any) => getRelationArray(categoria?.padre_id)[0] ?? null;
const getChildrenRelations = (categoria: any) => getRelationArray(categoria?.hijo_id);

const formatCategoryItem = (categoria: any) => ({
  label: categoria?.nombre ?? "Sin nombre",
  value: categoria?.ID_Categoria ?? categoria?.id,
  image: getStrapiFileUrl(categoria?.cat_img),
});

const parentCategoryItems = categorias
  .filter((categoria) => !getParentRelation(categoria))
  .map((categoria) => ({
    ...formatCategoryItem(categoria),
    children: getChildrenRelations(categoria).map(formatCategoryItem),
  }))
  .filter((categoria) => categoria.children.length > 0);

const brandItems = marcas
  .map((marca) => ({
    label: marca?.nombre ?? "Sin nombre",
    value: marca?.ID_Marca ?? marca?.id,
    image: getStrapiFileUrl(marca?.logo ?? marca?.imagen),
  }))
  .filter((marca) => Boolean(marca.value));

const searchSuggestions = Array.from(
  new Map(
    suggestionProducts
      .map((producto) => {
        const nombre = producto?.nombre?.trim() ?? "";
        const codigo = producto?.codigo?.trim() ?? "";

        if (!nombre && !codigo) {
          return null;
        }

        const label =
          nombre && codigo ? `${nombre} · ${codigo}` : nombre || codigo;
        const value = nombre || codigo;
        const searchValue = [nombre, codigo].filter(Boolean).join(" ").toLowerCase();
        const key = (codigo || nombre).toLowerCase();

        return [
          key,
          {
            label,
            value,
            searchValue,
            code: codigo,
          },
        ];
      })
  ).values(),
);

const priceFormatter = new Intl.NumberFormat("es-PE", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
  minimumFractionDigits: 0,
});

//Paginacion
const maxVisible = 10;
const half = Math.floor(maxVisible / 2);

let startPage = Math.max(1, currentPage - half);
let endPage = startPage + maxVisible - 1;
if (endPage > totalPages) {
  endPage = totalPages;
  startPage = Math.max(1, endPage - maxVisible + 1);
}

const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
const pages = range(startPage, endPage);

const showLeftDots = startPage > 1;
const showRightDots = endPage < totalPages;



---


<BaseLayout global={global} stopIndexing={stopIndexing}>

{stopIndexing ? (
  <>
    <meta name="robots" content="noindex, nofollow" slot="head" />
    <link rel="canonical" href="https://sistema.unicomec.com/tienda" slot="head" />
  </>
) : null}

  <div
    class="fixed inset-0 z-[999] flex items-center justify-center bg-white/80 text-zinc-900 backdrop-blur-sm transition-opacity dark:bg-zinc-950/80 dark:text-white"
    data-preloader
    role="status"
    aria-live="polite"
    aria-busy="true"
  >
    <div class="flex flex-col items-center gap-4 rounded-3xl bg-white/90 px-8 py-6 shadow-xl dark:bg-zinc-900/90">
      <div class="loader"></div>
      <p class="text-sm font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-300">
        Cargando productos
      </p>
    </div>
  </div>

  <Container>
    <article class="flex flex-col gap-10 py-10 w-full">
      <!-- Filtro responsive -->
      <div class="md:hidden">
        <details class="group rounded-3xl border border-zinc-200 bg-white/90 p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/90">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl bg-zinc-100 px-4 py-3 text-sm font-semibold uppercase tracking-wide text-zinc-800 transition hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700">
            <span class="inline-flex items-center gap-2">
              <svg class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 6H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M7 12H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M10 18H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              Filtros de búsqueda
            </span>
            <svg class="h-5 w-5 shrink-0 text-zinc-500 transition-transform duration-300 group-open:rotate-180 dark:text-zinc-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
            </svg>
          </summary>

          <div class="mt-4 flex flex-col gap-6">

        <div class="group relative block">
          <label for="mobileCategory" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por categoría:
          </label>
          <select
            id="mobileCategory"
            class="mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-white"
            onchange="var selectedUrl = this.value; if (selectedUrl) window.location.href = selectedUrl;"
          >
            <option
              value={Astro.url.pathname + buildQueryString({ category: "all", page: 1, search: null })}
              selected={categoryParam === "all"}
            >
              TODAS
            </option>
            {parentCategoryItems.map((parent) => (
              parent.children.length > 0 ? (
                <optgroup label={parent.label}>
                  {parent.children.map((child) => (
                    <option
                      value={Astro.url.pathname + buildQueryString({ category: child.value, page: 1, search: null })}
                      selected={child.value === categoryParam}
                    >
                      {child.label}
                    </option>
                  ))}
                </optgroup>
              ) : (
                <optgroup label={parent.label}>
                  <option value="" disabled>
                    Sin subcategorías disponibles
                  </option>
               </optgroup>
              )
            ))}
          </select>
        </div>

        <div class="group relative block">
          <label for="mobileBrand" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por marca:
          </label>
          <select
            id="mobileBrand"
            class="mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-white"
            onchange="var selectedUrl = this.value; if (selectedUrl) window.location.href = selectedUrl;"
          >
            <option
              value={Astro.url.pathname + buildQueryString({ brand: "all", page: 1, search: null })}
              selected={brandParam === "all"}
            >
              TODAS
            </option>
            {brandItems.length > 0 ? (
              brandItems.map((brand) => (
                <option
                  value={Astro.url.pathname + buildQueryString({ brand: brand.value, page: 1, search: null })}
                  selected={brand.value === brandParam}
                >
                  {brand.label}
                </option>
              ))
            ) : (
              <option value="" disabled>
                No hay marcas disponibles
              </option>
            )}
          </select>
        </div>

        <div class="group relative block"
          data-auth-visible="authenticated"
        >
          <label for="mobileStock" class="text-base font-semibold text-zinc-900 dark:text-white mb-4">
            Filtrar por stock:
          </label>
          <select
            id="mobileStock"
            class="mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-sm dark:border-zinc-700 dark:bg-zinc-800 dark:text-white"
            onchange="var selectedUrl = this.value; if (selectedUrl) window.location.href = selectedUrl;"
          >
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "all", page: 1, search: null })}
              selected={stockParam === "all"}
            >
              TODOS
            </option>
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "in", page: 1 })}
              selected={stockParam === "in"}
            >
              En stock
            </option>
            <option
              value={Astro.url.pathname + buildQueryString({ stock: "out", page: 1, search: null })}
              selected={stockParam === "out"}
            >
              Sin stock
            </option>
          </select>
        </div>

        <div class="group relative block"
          data-auth-visible="authenticated"
        >
            <h3 class="text-base font-semibold text-zinc-900 dark:text-white mb-4">Precio máximo</h3>
            <form method="get" class="flex flex-col gap-4">
              <input type="hidden" name="search" value={searchParam} />
              <input type="hidden" name="category" value={categoryParam} />
              <input type="hidden" name="brand" value={brandParam} />
              <input type="hidden" name="stock" value={stockParam} />
              <input type="hidden" name="page" value="1" />
              <label for="priceRangeMobile" class="text-sm text-zinc-600 dark:text-zinc-300">Ajusta el rango de precio:</label>
              <div class="flex flex-col gap-3" data-price-range>
                <input
                  id="priceRangeMobile"
                  type="range"
                  min={MIN_PRICE}
                  max={MAX_PRICE}
                  step="50"
                  name="price"
                  value={priceFilterValue}
                  class="w-full cursor-pointer accent-primary"
                  oninput="const scope = this.closest('[data-price-range]'); const output = scope?.querySelector('[data-price-range-output]'); if (output) { output.textContent = new Intl.NumberFormat('es-PE',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(this.value); }"
                  onchange="this.form.requestSubmit()"
                />
                <div class="flex items-center justify-between text-sm text-zinc-600 dark:text-zinc-300">
                  <span>{priceFormatter.format(MIN_PRICE)}</span>
                  <span data-price-range-output aria-live="polite">{priceFormatter.format(priceFilterValue)}</span>
                </div>
              </div>
            </form>
        </div>
          </div>
        </details>
      </div>

      <!-- Contenido principal -->
      <div class="flex flex-col md:flex-row gap-5 w-full">
        <!-- Aside de Navbar visible en escritorio -->
        <aside
          class="hidden md:block md:w-64 shrink-0 sticky top-24 z-50 max-h-[calc(100vh-9rem)] overflow-y-auto rounded-3xl border border-zinc-300 bg-zinc-100 p-6 shadow-sm no-scrollbar dark:border-red-900 dark:bg-zinc-900"
          data-aos="fade-right"
          data-aos-duration="1000"
        >

        <!-- Categorías -->
          <h2 class="sticky inline-flex text-lg font-semibold mb-4 text-zinc-900 dark:text-white">
            <svg class="h-6 w-6 pt-1 pr-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ff0000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path opacity="0.4" d="M18.6695 2H16.7695C14.5895 2 13.4395 3.15 13.4395 5.33V7.23C13.4395 9.41 14.5895 10.56 16.7695 10.56H18.6695C20.8495 10.56 21.9995 9.41 21.9995 7.23V5.33C21.9995 3.15 20.8495 2 18.6695 2Z" fill="#ffffff"></path> <path opacity="0.4" d="M7.24 13.4302H5.34C3.15 13.4302 2 14.5802 2 16.7602V18.6602C2 20.8502 3.15 22.0002 5.33 22.0002H7.23C9.41 22.0002 10.56 20.8502 10.56 18.6702V16.7702C10.57 14.5802 9.42 13.4302 7.24 13.4302Z" fill="#ffffff"></path> <path d="M6.29 10.58C8.6593 10.58 10.58 8.6593 10.58 6.29C10.58 3.9207 8.6593 2 6.29 2C3.9207 2 2 3.9207 2 6.29C2 8.6593 3.9207 10.58 6.29 10.58Z" fill="#ffffff"></path> <path d="M17.7099 21.9999C20.0792 21.9999 21.9999 20.0792 21.9999 17.7099C21.9999 15.3406 20.0792 13.4199 17.7099 13.4199C15.3406 13.4199 13.4199 15.3406 13.4199 17.7099C13.4199 20.0792 15.3406 21.9999 17.7099 21.9999Z" fill="#ffffff"></path> </g></svg>
            Categorías
          </h2>
          <div class="flex-1 pr-2">
            <ul class="flex flex-col gap-3 pb-2">
              <li class="relative">
                <a
                  href={Astro.url.pathname + buildQueryString({ category: "all", page: 1 })}
                  class={`block w-full rounded-lg border px-4 py-2 text-sm font-medium text-left transition ${
                    categoryParam === "all"
                      ? "border-primary bg-primary text-white"
                      : "border-zinc-300 bg-white text-zinc-700 hover:border-primary hover:text-primary dark:border-red-900 dark:bg-zinc-800 dark:text-zinc-200"
                  }`}
                  aria-current={categoryParam === "all" ? "true" : undefined}
                >
                  TODAS
                </a>
              </li>
              {parentCategoryItems.length > 0 ? (
                parentCategoryItems.map((parent) => {
                  const hasActiveChild = parent.children.some((child) => child.value === categoryParam);
                  const isParentActive = parent.value === categoryParam;
                  const isActive = isParentActive || hasActiveChild;

                  return (
                    <li class="relative">
                      <details
                        class={`group rounded-2xl border px-1 py-1 transition ${
                          isActive
                            ? "border-primary bg-primary/5 shadow-sm dark:border-red-700 dark:bg-red-950/40"
                            : "border-zinc-300 bg-white hover:border-primary/60 dark:border-red-900 dark:bg-zinc-900"
                        }`}
                        open={isActive}
                      >
                        <summary
                          class={`flex w-full cursor-pointer select-none items-center justify-between rounded-xl px-3 py-2 text-sm font-medium list-none ${
                            isActive
                              ? "text-primary"
                              : "text-zinc-700 hover:text-primary dark:text-zinc-200"
                          }`}
                          aria-expanded={isActive ? "true" : "false"}
                        >
                          <span class="flex-1 text-left">{parent.label}</span>
                          <svg
                            class="h-4 w-4 text-current transition-transform duration-200 group-open:rotate-180"
                            viewBox="0 0 20 20"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                          >
                            <path
                              d="M5 7.5L10 12.5L15 7.5"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </summary>

                        <div class="grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-4000 ease-out group-open:grid-rows-[1fr]">
                          <div class="opacity-0 transition-opacity duration-1000 ease-out group-open:opacity-100">
                            {parent.children.length > 0 ? (
                              <ul class="flex flex-col gap-2 rounded-xl bg-transparent p-3 text-sm shadow-inner">
                                {parent.children.map((child) => {
                                  const isChildActive = child.value === categoryParam;
                                  return (
                                    <li>
                                      <a
                                        href={Astro.url.pathname + buildQueryString({ category: child.value, page: 1 })}
                                        class={`flex items-center gap-3 rounded-2xl border px-3 py-2 font-medium transition ${
                                          isChildActive
                                            ? "border-primary bg-primary/10 text-primary"
                                            : "border-transparent text-zinc-700 hover:border-primary/40 hover:text-primary dark:text-zinc-200"
                                        }`}
                                      >
                                        {child.image ? (
                                          <img
                                            src={child.image}
                                            alt={`Imagen de ${child.label}`}
                                            class="h-8 w-8 shrink-0 rounded-xl object-cover"
                                            loading="lazy"
                                          />
                                        ) : (
                                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-zinc-100 text-xs font-semibold text-zinc-500 dark:bg-zinc-800 dark:text-zinc-300">
                                            {child.label.slice(0, 2).toUpperCase()}
                                          </span>
                                        )}
                                        <span class="flex-1 wrap-break-word text-left inline-flex">{child.label}</span>
                                      </a>
                                    </li>
                                  );
                                })}
                                </ul>
                            ) : (
                              <p class="px-3 pb-3 text-sm text-zinc-500 dark:text-zinc-400">Sin subcategorías disponibles</p>
                            )}
                          </div>
                        </div>
                      </details>
                    </li>
                  );
                })
              ) : (
                <li class="text-sm text-zinc-500 dark:text-zinc-400">No hay categorías disponibles.</li>
              )}
            </ul>
          </div>


          <!-- Marcas -->
