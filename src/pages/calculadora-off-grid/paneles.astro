                </div>

                <div class="flex flex-col items-center gap-2 self-center sm:-mt-1">            
                  <p class="m-0 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Eficiencia del panel</p>
                  <div class="rounded-full bg-red-50 px-3 py-1 text-sm font-semibold text-[#cc2f1f]" id="resumen-eficiencia">
                    {panelInicial.eficiencia}
                  </div>
                </div>
              </div>
            </section>

            <section class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm">
              <label for="porcentaje-perdida" class="m-0 block text-xs uppercase tracking-[0.12em] text-slate-500">
                Pérdida energética estimada
              </label>
              <select
                id="porcentaje-perdida"
                class="mt-3 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-base font-semibold text-slate-800 outline-none focus:border-[#cc2f1f]"
              >
                <option value="15">15%</option>
                <option value="20">20%</option>
                <option value="25">25%</option>
                <option value="30">30%</option>
                <option value="35">35%</option>
                <option value="40">40%</option>
              </select>
              <p class="m-0 mt-2 text-xs text-slate-500">Selecciona un margen de pérdida que se ajuste a tus necesidades.</p>
            </section>
          </div>
          <section class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="m-0 text-xs uppercase tracking-[0.12em] text-[#cc2f1f]">Paneles totales:</p>
            <p class="m-0 mt-2 text-3xl font-black text-slate-900" id="resultado-paneles">0 paneles de {panelInicial.watts} W</p>

            <button
              id="resultado-paneles-toggle"
              type="button"
              class="mt-3 inline-flex cursor-pointer items-center rounded-full border border-red-200 bg-white px-3 py-1 text-sm font-semibold text-[#b9301d] transition hover:border-[#cc2f1f] hover:text-[#cc2f1f]"
              aria-expanded="false"
              aria-controls="resultado-paneles-detalle-wrap"
            >
              + info
            </button>

            <div id="resultado-paneles-detalle-wrap" class="hidden">
              <p class="m-0 mt-3 whitespace-pre-line rounded-lg border border-red-100 bg-white/70 p-3 text-sm leading-6 text-slate-600" id="resultado-paneles-detalle"></p>
            </div>
          </section>

          <div class="mt-8 flex flex-wrap gap-3">
              <a
              href="/calculadora-off-grid/localidad"
              data-nav-loading
              class="inline-flex h-11 items-center rounded bg-slate-700 px-6 text-base font-semibold text-white transition hover:bg-slate-800"
              >
              Volver a localidad
              </a>
              <a
              id="confirmar-localidad"
              href="/calculadora-off-grid/baterias"
              data-nav-loading
              class="inline-flex h-11 items-center rounded bg-[#cc3b26] px-6 text-base font-semibold text-white transition hover:bg-[#b9301d]"
              >
              Continuar 
              </a>
          </div>
        </div>
      </aside>
    </section>
  </main>
</Layout>

<script>
  import { registerNavigationPreloader } from "../../lib/navigationPreloader";

    type ConsumoStorage = {
      totalEnergiaConsumo?: number;
      totalEnergia?: number;
      totalEnergiaConsumoLoss?: number;
      totalEnergiaLoss?: number;
      panelesSolares?: number;
      panelVatios?: number;
      porcentajePerdida?: number;
    };

    type LocalidadStorage = {
      nombre: string;
      lat: number;
      lng: number;
      horas_sol: number;
    };

    const CONSUMO_STORAGE_KEY = "unicom.offgrid.consumos";
    const LOCALIDAD_STORAGE_KEY = "unicom.offgrid.localidad";
    const PANEL_PLACEHOLDER_CLIENT = "/images/placeholder.png";

    let dots: HTMLButtonElement[] = [];
    let resumenWatts: HTMLElement | null = null;
    let resumenEficiencia: HTMLElement | null = null;
    let resumenUso: HTMLElement | null = null;
    let resumenDescripcion: HTMLElement | null = null;
    let porcentajePerdidaEl: HTMLSelectElement | null = null;
    let resultadoPanelesEl: HTMLElement | null = null;
    let resultadoTotalEnergiaEl: HTMLElement | null = null;
    let resultadoPanelesDetalleEl: HTMLElement | null = null;
    let resultadoPanelesToggleEl: HTMLButtonElement | null = null;
    let resultadoPanelesDetalleWrapEl: HTMLElement | null = null;
    let panelPrevEl: HTMLButtonElement | null = null;
    let panelNextEl: HTMLButtonElement | null = null;
    let carouselPanelWattsEl: HTMLElement | null = null;
    let carouselPanelUsoEl: HTMLElement | null = null;
    let carouselPanelImageEl: HTMLImageElement | null = null;
    let carouselPanelLoaderEl: HTMLElement | null = null;

    let totalEnergiaHora = 0;
    let totalEnergia = 0;
    let horasSol = 0;
    let nombreProvincia = "No seleccionada";
    let panelVatios = 0;
    let panelVatiosGuardado = 0;
    let porcentajePerdidaGuardado = 15;
    let indicePanelActivo = 0;
    let imageLoadRequestId = 0;

    const formatearNumero = (valor: number): string => Number.isInteger(valor) ? `${valor}` : valor.toFixed(2);

    const sincronizarElementos = (): void => {
      dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".panel-dot"));
      resumenWatts = document.getElementById("resumen-watts");
      resumenEficiencia = document.getElementById("resumen-eficiencia");
      resumenUso = document.getElementById("resumen-uso");
      resumenDescripcion = document.getElementById("resumen-descripcion");
      porcentajePerdidaEl = document.querySelector<HTMLSelectElement>("#porcentaje-perdida");
      resultadoPanelesEl = document.getElementById("resultado-paneles");
      resultadoTotalEnergiaEl = document.getElementById("resultado-total-energia");
      resultadoPanelesDetalleEl = document.getElementById("resultado-paneles-detalle");
      resultadoPanelesToggleEl = document.querySelector<HTMLButtonElement>("#resultado-paneles-toggle");
      resultadoPanelesDetalleWrapEl = document.getElementById("resultado-paneles-detalle-wrap");
      panelPrevEl = document.querySelector<HTMLButtonElement>("#panel-prev");
      panelNextEl = document.querySelector<HTMLButtonElement>("#panel-next");
      carouselPanelWattsEl = document.getElementById("carousel-panel-watts");
      carouselPanelUsoEl = document.getElementById("carousel-panel-uso");
      carouselPanelImageEl = document.querySelector<HTMLImageElement>("#carousel-panel-image");
      carouselPanelLoaderEl = document.getElementById("carousel-panel-loader");
    };

    const leerDatosGuardados = (): void => {
      totalEnergiaHora = 0;
      totalEnergia = 0;
      horasSol = 0;
      nombreProvincia = "No seleccionada";
      panelVatiosGuardado = 0;
      porcentajePerdidaGuardado = 15;

      try {
        const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
        if (consumoGuardado) {
          const consumo = JSON.parse(consumoGuardado) as ConsumoStorage;
          totalEnergiaHora = typeof consumo.totalEnergiaConsumo === "number" ? consumo.totalEnergiaConsumo : 0;
          totalEnergia = typeof consumo.totalEnergia === "number"
            ? consumo.totalEnergia
            : 0;
          panelVatiosGuardado = typeof consumo.panelVatios === "number" ? consumo.panelVatios : 0;
          porcentajePerdidaGuardado = typeof consumo.porcentajePerdida === "number"
            ? consumo.porcentajePerdida
            : 15;
        }

        const localidadGuardada = window.localStorage.getItem(LOCALIDAD_STORAGE_KEY);
        if (localidadGuardada) {
          const localidad = JSON.parse(localidadGuardada) as Partial<LocalidadStorage>;
          nombreProvincia = typeof localidad.nombre === "string" ? localidad.nombre : "No seleccionada";
          horasSol = typeof localidad.horas_sol === "number" ? localidad.horas_sol : 0;
        }
      } catch (error) {
        console.error("No se pudieron leer los datos guardados para el cálculo de paneles.", error);
      }
    };

    const guardarDatos = (
      totalEnergiaLoss: number,
      totalEnergiaHoraLoss: number,
      panelesSolares: number,
      panelVatios: number,
      porcentajePerdida: number,
    ): void => {
      try {
        const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
        const consumoActual = consumoGuardado
          ? JSON.parse(consumoGuardado) as ConsumoStorage
          : {};

        const consumoActualizado: ConsumoStorage = {
          ...consumoActual,
          totalEnergiaLoss: totalEnergiaLoss,
          totalEnergiaConsumoLoss: totalEnergiaHoraLoss,
          panelesSolares: panelesSolares,
          panelVatios: panelVatios,
          porcentajePerdida: porcentajePerdida,
        };

        window.localStorage.setItem(CONSUMO_STORAGE_KEY, JSON.stringify(consumoActualizado));
      } catch (error) {
        console.error("No se pudo guardar el consumo con pérdida en localStorage.", error);
      }
    };

    const toggleResultadoDetalle = (abierto?: boolean): void => {
      if (!resultadoPanelesToggleEl || !resultadoPanelesDetalleWrapEl) return;

      const shouldOpen = typeof abierto === "boolean"
        ? abierto
        : resultadoPanelesDetalleWrapEl.classList.contains("hidden");

      resultadoPanelesDetalleWrapEl.classList.toggle("hidden", !shouldOpen);
      resultadoPanelesToggleEl.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
      resultadoPanelesToggleEl.textContent = shouldOpen ? "- info" : "+ info";
    };

    const actualizarResultadoPaneles = (): void => {
      if (!resultadoPanelesEl || !resultadoPanelesDetalleEl) return;

      const porcentajeSeleccionado = porcentajePerdidaEl ? Number(porcentajePerdidaEl.value) : 15;
      const porcentajePerdida = Number.isFinite(porcentajeSeleccionado) ? porcentajeSeleccionado / 100 : 0.15;
      const totalEnergiaHoraLoss = totalEnergiaHora * (1 + porcentajePerdida);
      const totalEnergiaLoss = totalEnergia * (1 + porcentajePerdida);
      console.log("Cálculo de paneles:", {
        totalEnergiaHora,
        totalEnergia,
        porcentajeSeleccionado,
        porcentajePerdida,
        totalEnergiaHoraLoss,
        totalEnergiaLoss,
        horasSol,
        panelVatios,
      });
      const totalEnergiaSolar = horasSol > 0 ? totalEnergiaHoraLoss / horasSol : 0;
      const panelesExactos = panelVatios > 0 ? totalEnergiaSolar / panelVatios : 0;
      const paneles = panelVatios > 0 ? Math.ceil(panelesExactos) : 0;

      guardarDatos(totalEnergiaLoss, totalEnergiaHoraLoss, paneles, panelVatios, porcentajeSeleccionado);


      if (totalEnergiaHora <= 0 || horasSol <= 0) {
        resultadoPanelesEl.textContent = `0 paneles de ${panelVatios} W`;
        resultadoPanelesDetalleEl.textContent = [
          `• Pérdida: ${porcentajeSeleccionado}%`,
          `• Consumo considerando pérdidas: ${formatearNumero(totalEnergiaLoss)} W`,
          `• Energia considerando pérdidas: ${formatearNumero(totalEnergiaHoraLoss)} Wh`,
          `• Potencia solar requerida: ${formatearNumero(totalEnergiaSolar)} W`,
          `• Horas de sol pico necesarias: ${horasSol}`,
        ].join("\n");
        return;
      }

      resultadoPanelesEl.textContent = `${paneles} paneles de ${panelVatios} W`;
      resultadoPanelesDetalleEl.textContent = [
        `• Pérdida: ${porcentajeSeleccionado}%`,
        `• Consumo considerando pérdidas: ${formatearNumero(totalEnergiaLoss)} W`,
        `• Energia considerando pérdidas: ${formatearNumero(totalEnergiaHoraLoss)} Wh`,
        `• Potencia solar requerida: ${formatearNumero(totalEnergiaSolar)} W`,
        `• Horas de sol pico necesarias: ${horasSol}`,
      ].join("\n");
    };

    const actualizarCarrusel = (): void => {
      if (dots.length === 0) return;

      dots.forEach((dot, index) => {
        const isActive = index === indicePanelActivo;
        dot.classList.toggle("bg-[#cc2f1f]", isActive);
        dot.classList.toggle("bg-slate-300", !isActive);
        dot.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      if (panelPrevEl) panelPrevEl.disabled = indicePanelActivo === 0;
      if (panelNextEl) panelNextEl.disabled = indicePanelActivo === dots.length - 1;
    };

    const actualizarEstadoPreloader = (cargando: boolean): void => {
      if (carouselPanelLoaderEl) {
        carouselPanelLoaderEl.classList.toggle("hidden", !cargando);
      }

      if (carouselPanelImageEl) {
        carouselPanelImageEl.classList.toggle("opacity-0", cargando);
        carouselPanelImageEl.classList.toggle("opacity-100", !cargando);
      }
    };

    const actualizarImagenCarrusel = (imagen: string): void => {
      if (!carouselPanelImageEl) return;

      const imageUrl = imagen?.trim() ? imagen : PANEL_PLACEHOLDER_CLIENT;
      const currentImage = carouselPanelImageEl.dataset.currentSrc || "";

      if (currentImage === imageUrl && carouselPanelImageEl.complete && carouselPanelImageEl.naturalWidth > 0) {
        actualizarEstadoPreloader(false);
        return;
      }

      imageLoadRequestId += 1;
      const requestId = imageLoadRequestId;
      const preloadedImage = new Image();

      actualizarEstadoPreloader(true);

      preloadedImage.onload = () => {
        if (!carouselPanelImageEl || requestId !== imageLoadRequestId) return;
        carouselPanelImageEl.src = imageUrl;
        carouselPanelImageEl.dataset.currentSrc = imageUrl;
        actualizarEstadoPreloader(false);
      };

      preloadedImage.onerror = () => {
        if (!carouselPanelImageEl || requestId !== imageLoadRequestId) return;
        carouselPanelImageEl.src = PANEL_PLACEHOLDER_CLIENT;
        carouselPanelImageEl.dataset.currentSrc = PANEL_PLACEHOLDER_CLIENT;
        actualizarEstadoPreloader(false);
      };

      preloadedImage.src = imageUrl;
    };

    const updateSelection = (dot: HTMLButtonElement): void => {
      indicePanelActivo = Number(dot.dataset.index || 0);
      panelVatios = Number(dot.dataset.watts || 0);

      const imagenPanel = dot.dataset.imagen || PANEL_PLACEHOLDER_CLIENT;

      if (carouselPanelWattsEl) carouselPanelWattsEl.textContent = `${panelVatios}W`;
      if (carouselPanelUsoEl) carouselPanelUsoEl.textContent = dot.dataset.uso || "";
      actualizarImagenCarrusel(imagenPanel);

      if (resumenWatts) resumenWatts.textContent = `${panelVatios}W`;
      if (resumenEficiencia) resumenEficiencia.textContent = dot.dataset.eficiencia || "";
      if (resumenUso) resumenUso.textContent = dot.dataset.uso || "";
      if (resumenDescripcion) resumenDescripcion.textContent = dot.dataset.descripcion || "";

      actualizarCarrusel();
      actualizarResultadoPaneles();
    };

    const registrarEventos = (): void => {
      dots.forEach((dot) => {
        if (dot.dataset.listenerBound === "1") return;
        dot.addEventListener("click", () => updateSelection(dot));
        dot.dataset.listenerBound = "1";
      });

      if (panelPrevEl && panelPrevEl.dataset.listenerBound !== "1") {
        panelPrevEl.addEventListener("click", () => {
          if (indicePanelActivo <= 0) return;
          const siguienteDot = dots[indicePanelActivo - 1];
          if (siguienteDot) updateSelection(siguienteDot);
        });
        panelPrevEl.dataset.listenerBound = "1";
      }

      if (panelNextEl && panelNextEl.dataset.listenerBound !== "1") {
        panelNextEl.addEventListener("click", () => {
          if (indicePanelActivo >= dots.length - 1) return;
          const siguienteDot = dots[indicePanelActivo + 1];
          if (siguienteDot) updateSelection(siguienteDot);
        });
        panelNextEl.dataset.listenerBound = "1";
      }

      if (porcentajePerdidaEl && porcentajePerdidaEl.dataset.listenerBound !== "1") {
        porcentajePerdidaEl.addEventListener("change", actualizarResultadoPaneles);
        porcentajePerdidaEl.addEventListener("input", actualizarResultadoPaneles);
        porcentajePerdidaEl.dataset.listenerBound = "1";
      }

      if (resultadoPanelesToggleEl && resultadoPanelesToggleEl.dataset.listenerBound !== "1") {
        resultadoPanelesToggleEl.addEventListener("click", () => toggleResultadoDetalle());
        resultadoPanelesToggleEl.dataset.listenerBound = "1";
      }
    };

    const inicializarPaginaPaneles = (): void => {
      sincronizarElementos();
      if (dots.length === 0) return;

      leerDatosGuardados();

      if (porcentajePerdidaEl) {
        const optionExists = Array.from(porcentajePerdidaEl.options)
          .some((option) => Number(option.value) === porcentajePerdidaGuardado);
        porcentajePerdidaEl.value = optionExists ? String(porcentajePerdidaGuardado) : "15";
      }

      registrarEventos();
      registerNavigationPreloader();
      toggleResultadoDetalle(false);

      const dotSeleccionado = dots.find((dot) => Number(dot.dataset.watts || 0) === panelVatiosGuardado)
        ?? dots.find((dot) => dot.getAttribute("aria-pressed") === "true")
        ?? dots[0];
      if (dotSeleccionado) {
        updateSelection(dotSeleccionado);
      } else {
        actualizarResultadoPaneles();
      }
    };

    document.addEventListener("astro:page-load", inicializarPaginaPaneles);
    window.addEventListener("pageshow", inicializarPaginaPaneles);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", inicializarPaginaPaneles, { once: true });
    } else {
      inicializarPaginaPaneles();
    }
  </script>