---
import Layout from '../../layouts/LayoutCalculadora.astro';
import { getPanelsData } from "../../lib/api";

type PanelOption = {
  watts: number;
  eficiencia: string;
  uso: string;
  descripcion: string;
  imagen: string;
};

type StrapiMediaItem = {
  url?: string | null;
};

type StrapiMediaField =
  | StrapiMediaItem
  | StrapiMediaItem[]
  | { data?: StrapiMediaItem | StrapiMediaItem[] | null }
  | null
  | undefined;

const STRAPI_BASE_URL = import.meta.env.VITE_STRAPI_URL ?? "https://api.unicomec.com";
const PANEL_PLACEHOLDER = "/images/placeholder.png";

const resolvePanelImage = (imageField: StrapiMediaField): string => {
  const normalizedField = imageField as {
    data?: StrapiMediaItem | StrapiMediaItem[] | null;
    url?: string | null;
  } | null | undefined;

  const candidateUrl = Array.isArray(imageField)
    ? imageField[0]?.url
    : Array.isArray(normalizedField?.data)
      ? normalizedField.data[0]?.url
      : normalizedField?.data && !Array.isArray(normalizedField.data)
        ? normalizedField.data.url
        : normalizedField?.url;

  if (!candidateUrl) return PANEL_PLACEHOLDER;
  return candidateUrl.startsWith("http") ? candidateUrl : `${STRAPI_BASE_URL}${candidateUrl}`;
};

const ordenarPanelesPorWatts = (paneles: PanelOption[]): PanelOption[] => {
  return [...paneles].sort((a, b) => a.watts - b.watts);
};

const opcionesVatios: PanelOption[] = await getPanelsData().then((response) => {
  if (response?.data) {
    const panelesMapeados = response.data.map((item: any): PanelOption => ({
      watts: Number(item.Potencia ?? 0),
      eficiencia: String(item.PorcentajeEficiencia ?? "--"),
      uso: String(item.Uso ?? item.Descripcion ?? "Panel solar"),
      descripcion: String(item.Descripcion ?? "Panel solar disponible."),
      imagen: resolvePanelImage(item.Imagen),
    }));

    return ordenarPanelesPorWatts(panelesMapeados);
  }

  return [];
}).catch((error) => {
  console.error("Error al obtener los datos de los paneles:", error);
  return [];
});

const panelInicial: PanelOption = opcionesVatios[0] ?? {
  watts: 0,
  eficiencia: "--",
  uso: "Sin paneles disponibles",
  descripcion: "No hay paneles disponibles por el momento.",
  imagen: PANEL_PLACEHOLDER,
};


