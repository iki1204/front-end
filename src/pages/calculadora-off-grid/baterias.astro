---
import Layout from '../../layouts/LayoutCalculadora.astro';
---

<Layout title="Unicom - Off Grid">
  <main class="min-h-screen bg-[#ececec]">
    <section class="mx-auto grid min-h-screen min-w-screen w-full max-w-[1520px] grid-cols-1 lg:grid-cols-[minmax(340px,30%)_1fr]">
      <aside class="relative hidden lg:flex items-baseline px-[clamp(2.5rem,3.8vw,4rem)] text-white min-h-screen" style="background: radial-gradient(ellipse at top left, #c92a2a 0%, #5a0a0a 60%, #2a0303 100%);">
        <div class="pointer-events-none absolute inset-0 z-0">
          <svg width="100%" height="100%" viewBox="0 0 400 900" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full opacity-40" preserveAspectRatio="xMidYMid slice">
            <defs>
              <radialGradient id="bgGrad" cx="0.3" cy="0.1" r="1">
                <stop offset="0%" stop-color="#c92a2a"/>
                <stop offset="60%" stop-color="#5a0a0a"/>
                <stop offset="100%" stop-color="#2a0303"/>
              </radialGradient>
              <linearGradient id="lineGrad" x1="0" y1="0" x2="400" y2="900" gradientUnits="userSpaceOnUse">
                <stop stop-color="#fff" stop-opacity="0.12"/>
                <stop offset="1" stop-color="#fff" stop-opacity="0.02"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="400" height="900" fill="url(#bgGrad)"/>
            <path d="M20 200 Q200 100 380 220" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <path d="M0 400 Q200 300 400 500" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <path d="M40 700 Q200 850 360 700" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <g opacity="0.13">
              <circle cx="350" cy="100" r="80" fill="#fff"/>
              <circle cx="100" cy="800" r="120" fill="#fff"/>
              <circle cx="350" cy="300" r="60" fill="#fff"/>
              <circle cx="60" cy="600" r="40" fill="#fff"/>
            </g>
            <g opacity="0.22">
              <circle cx="40" cy="80" r="3" fill="#fff"/>
              <circle cx="40" cy="160" r="3" fill="#fff"/>
              <circle cx="40" cy="240" r="3" fill="#fff"/>
              <circle cx="40" cy="320" r="3" fill="#fff"/>
              <circle cx="40" cy="400" r="3" fill="#fff"/>
              <circle cx="40" cy="480" r="3" fill="#fff"/>
              <circle cx="40" cy="560" r="3" fill="#fff"/>
              <circle cx="40" cy="640" r="3" fill="#fff"/>
              <circle cx="40" cy="720" r="3" fill="#fff"/>
              <circle cx="40" cy="800" r="3" fill="#fff"/>
              <circle cx="100" cy="120" r="3" fill="#fff"/>
              <circle cx="100" cy="200" r="3" fill="#fff"/>
              <circle cx="100" cy="280" r="3" fill="#fff"/>
              <circle cx="100" cy="360" r="3" fill="#fff"/>
              <circle cx="100" cy="440" r="3" fill="#fff"/>
              <circle cx="100" cy="520" r="3" fill="#fff"/>
              <circle cx="100" cy="600" r="3" fill="#fff"/>
              <circle cx="100" cy="680" r="3" fill="#fff"/>
              <circle cx="100" cy="760" r="3" fill="#fff"/>
              <circle cx="180" cy="80" r="3" fill="#fff"/>
              <circle cx="180" cy="160" r="3" fill="#fff"/>
              <circle cx="180" cy="240" r="3" fill="#fff"/>
              <circle cx="180" cy="320" r="3" fill="#fff"/>
              <circle cx="180" cy="400" r="3" fill="#fff"/>
              <circle cx="180" cy="480" r="3" fill="#fff"/>
              <circle cx="180" cy="560" r="3" fill="#fff"/>
              <circle cx="180" cy="640" r="3" fill="#fff"/>
              <circle cx="180" cy="720" r="3" fill="#fff"/>
              <circle cx="180" cy="800" r="3" fill="#fff"/>
              <circle cx="260" cy="120" r="3" fill="#fff"/>
              <circle cx="260" cy="200" r="3" fill="#fff"/>
              <circle cx="260" cy="280" r="3" fill="#fff"/>
              <circle cx="260" cy="360" r="3" fill="#fff"/>
              <circle cx="260" cy="440" r="3" fill="#fff"/>
              <circle cx="260" cy="520" r="3" fill="#fff"/>
              <circle cx="260" cy="600" r="3" fill="#fff"/>
              <circle cx="260" cy="680" r="3" fill="#fff"/>
              <circle cx="260" cy="760" r="3" fill="#fff"/>
              <circle cx="340" cy="80" r="3" fill="#fff"/>
              <circle cx="340" cy="160" r="3" fill="#fff"/>
              <circle cx="340" cy="240" r="3" fill="#fff"/>
              <circle cx="340" cy="320" r="3" fill="#fff"/>
              <circle cx="340" cy="400" r="3" fill="#fff"/>
              <circle cx="340" cy="480" r="3" fill="#fff"/>
              <circle cx="340" cy="560" r="3" fill="#fff"/>
              <circle cx="340" cy="640" r="3" fill="#fff"/>
              <circle cx="340" cy="720" r="3" fill="#fff"/>
              <circle cx="340" cy="800" r="3" fill="#fff"/>
            </g>
          </svg>
        </div>
        <div class="sticky top-28 lg:top-30 z-10 space-y-8 sm:space-y-10">
          <div class="mb-4 flex justify-start">
            <svg class="h-20 w-20" fill="#ffffff" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 260 244" enable-background="new 0 0 260 244" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M258,54v-8h-25.176c-0.596-3.416-1.941-6.576-3.86-9.307l17.806-17.806l-5.656-5.657l-17.803,17.802 c-2.731-1.926-5.892-3.275-9.311-3.876V2h-8v25.148c-3.433,0.596-6.609,1.947-9.35,3.879L178.87,13.248l-5.656,5.657l17.781,17.78 c-1.922,2.733-3.269,5.896-3.866,9.315H162v8h25.129c0.598,3.428,1.95,6.597,3.88,9.335L173.23,81.112l5.656,5.657l17.783-17.782 c2.737,1.924,5.906,3.271,9.331,3.865V98h8V72.844c3.41-0.599,6.565-1.944,9.292-3.862l17.804,17.805l5.656-5.656l-17.803-17.804 c1.927-2.735,3.276-5.902,3.874-9.326H258z M209.976,34.8c8.382,0,15.2,6.819,15.2,15.2s-6.818,15.2-15.2,15.2 c-8.381,0-15.199-6.819-15.199-15.2S201.595,34.8,209.976,34.8z M80,236v6H43v-6h15v-22h6v22H80z M63.537,82l9.723,38h24.545 l-9.773-38H63.537z M84.518,164h24.603l-9.773-38H74.795L84.518,164z M78.325,164l-9.723-38h-24.52l9.723,38H78.325z M26.632,82H2 l9.772,38h24.582L26.632,82z M67.067,120l-9.723-38H32.825l9.723,38H67.067z M95.776,208h24.661l-9.773-38H86.053L95.776,208z M55.34,170l9.723,38h24.52l-9.723-38H55.34z M37.89,126H13.315l9.772,38h24.525L37.89,126z M24.631,170l9.772,38H58.87l-9.723-38 H24.631z M178.667,190h17.055l6.686,26h-17.089L178.667,190z M163,237v-16h-5v16h-11v5h27v-5H163z M155.259,185l-7.164-28h16.968 l7.164,28H155.259z M146.815,152l-6.652-26h16.968l6.652,26H146.815z M173.506,190l6.652,26H163.19l-6.652-26H173.506z M151.377,190 l6.652,26h-16.834l-6.686-26H151.377z M141.654,152h-16.917l-6.686-26h16.951L141.654,152z M150.098,185h-16.874l-7.201-28h16.911 L150.098,185z M179.264,126l6.686,26h-17.006l-6.652-26H179.264z M170.223,157h17.013l7.201,28h-17.049L170.223,157z M240,238v4h-16 v-4h6v-9h4v9H240z M230.721,210l3.838,15h9.591l-3.838-15H230.721z M248.279,225H258l-3.858-15h-9.702L248.279,225z M217.049,210 l3.858,15h9.524l-3.838-15H217.049z M243.417,206h9.696l-4.115-16h-9.675L243.417,206z M216.358,170h-9.596l4.115,16h9.575 L216.358,170z M234.206,170l4.094,16h9.67l-4.115-16H234.206z M221.475,190h-9.57l4.115,16h9.549L221.475,190z M239.288,206 l-4.094-16h-9.591l4.094,16H239.288z M234.171,186l-4.094-16h-9.591l4.094,16H234.171z"></path> </g></svg>
          </div>
          <h1 class="m-0 text-[clamp(2.2rem,4vw,3.2rem)] leading-[1.05] font-black tracking-[-0.07em] text-balance">
            Simulador de<br />Proyectos<br />Fotovoltaicos<br />
            <span class="text-[#ff5c39]">Off-Grid.</span>
          </h1>
          <h2 class="mt-2 text-[clamp(1.1rem,1.5vw,1.5rem)] font-semibold">Diseña tu autonomía total</h2>
          <div class="w-32 h-1 bg-[#ff5c39] rounded-full mb-10"></div>
          <p class="max-w-[38ch] text-[clamp(1rem,1.2vw,1.35rem)] leading-normal font-medium text-white/90">Calcula el sistema solar ideal para operar sin red eléctrica: paneles, inversor y baterías según tu demanda diaria.</p>
          <div class="mt-8">
            <div class="flex items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/20">
                <svg class="h-6 w-6" fill="#ffffff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.488 21.754c.294.157.663.156.957-.001 8.012-4.304 8.581-12.713 8.574-15.104a.988.988 0 0 0-.596-.903l-8.05-3.566a1.005 1.005 0 0 0-.813.001L3.566 5.747a.99.99 0 0 0-.592.892c-.034 2.379.445 10.806 8.514 15.115zM8.674 10.293l2.293 2.293 4.293-4.293 1.414 1.414-5.707 5.707-3.707-3.707 1.414-1.414z"></path></g></svg>
              </span>
              <span class="text-base font-medium text-white">Energía independiente, libertad sin límites.</span>
            </div>
          </div>
        </div>
      </aside>

      <section class="mx-auto w-full rounded-md border border-slate-300 bg-slate-100 shadow-lg">
        <header class="flex items-center justify-between rounded-t-md bg-[#cc2f1f] px-6 py-4 text-white">
          <h2 class="font-mono text-xl tracking-wide">Dimensionamiento de Baterías</h2>
        </header>

        <div class="border-b border-slate-300 bg-white/70 px-6 py-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Modo de cálculo</p>
          <div
            id="battery-mode-menu"
            class="inline-flex rounded-full border border-slate-300 bg-white p-1 shadow-sm"
            role="tablist"
            aria-label="Modo de cálculo de baterías"
          >
            <button
              type="button"
              class="battery-mode-btn rounded-full bg-[#cc3b26] px-5 py-2 text-sm font-semibold text-white transition"
              data-mode="calculo-baterias"
              aria-pressed="true"
            >
              Calculo de baterias
            </button>
            <button
              type="button"
              class="battery-mode-btn rounded-full px-5 py-2 text-sm font-semibold text-slate-600 transition hover:text-slate-900"
              data-mode="tiempo-autonomia"
              aria-pressed="false"
            >
              Tiempo de autonomia
            </button>
          </div>
        </div>

        <div id="calculo-baterias-view">
          <div class="px-6 py-7">
            <div class="mb-5 rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
              <p class="mb-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Energía Ajustada del sistema</p>
              <h3 id="energiaAjustada" class="text-3xl font-black text-slate-900">-- Wh</h3>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje del sistema (V)</span>
                <select id="voltajeSistema" disabled class="h-11 w-full rounded border border-slate-400 bg-slate-200 px-3 text-lg text-slate-500 outline-none focus:border-[#cc3b26] disabled:cursor-not-allowed">
                  <option value="12">12 V</option>
                  <option value="24" selected>24 V</option>
                  <option value="48">48 V</option>
                </select>
                <label for="activarVoltajeManual" class="mt-3 flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
                  <input id="activarVoltajeManual" type="checkbox" class="h-4 w-4 rounded border-slate-400 text-[#cc3b26] focus:ring-[#cc3b26]" />
                  Yo se dimensionar mi sistema
                </label>
                <p id="voltajeRecomendadoInfo" class="mt-2 text-xs text-slate-500"></p>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Profundidad de descarga (%)</span>
                <input id="profDescarga" type="number" min="10" max="100" value="80" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]" />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje de batería (V)</span>
                <select id="voltajeSelect" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="12">12 V</option>
                  <option value="24">24 V</option>
                  <option value="48">48 V</option>
                </select>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Capacidad de batería (Ah)</span>
                <select id="capacidadSelect" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="100">100 Ah</option>
                  <option value="150">150 Ah</option>
                  <option value="200">200 Ah</option>
                  <option value="250">250 Ah</option>
                </select>
              </label>
            </div>
          </div>

          <!-- Resultados -->
          <div id="resultados" class="hidden border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Resultados</h2>
            </header>
            <div class="grid grid-cols-2 gap-4 px-6 py-6 sm:grid-cols-4">
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Baterías en serie</p>
                <p id="batteriasSerie" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Strings en paralelo</p>
                <p id="batteriasParalelo" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Total baterías</p>
                <p id="totalBaterias" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Tiempo de autonomía</p>
                <p id="tiempoAutonomia" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
            </div>

            <div class="px-6 pb-6">
              <button
                id="infoBateriaToggle"
                type="button"
                class="inline-flex cursor-pointer items-center rounded-full border border-red-200 bg-white px-3 py-1 text-sm font-semibold text-[#b9301d] transition hover:border-[#cc2f1f] hover:text-[#cc2f1f]"
                aria-expanded="false"
                aria-controls="infoBateriaSistemaWrap"
              >
                + info completa
              </button>

              <div id="infoBateriaSistemaWrap" class="hidden mt-3 rounded-xl border border-red-100 bg-white p-4 shadow-sm">
                <p class="m-0 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Resumen del sistema</p>
                <p id="infoBateriaSistema" class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-700"></p>
              </div>
            </div>
          </div>

          <!-- Diagrama GoJS -->
          <div id="diagramaContainer" class="hidden border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Diagrama de Conexión</h2>
            </header>
            <div class="px-6 py-6">
              <div id="myDiagramDiv" class="w-full rounded border border-slate-300 bg-white" style="height: 480px;"></div>
            </div>
          </div>
        </div>

        <div id="tiempo-autonomia-view" class="hidden border-t border-slate-300 bg-slate-50">
          <div class="px-6 py-7">
            <div class="mb-5 rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
              <p class="mb-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Consumo base del sistema</p>
              <h3 id="consumoAutonomiaValor" class="text-3xl font-black text-slate-900">-- Wh</h3>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje del sistema (V)</span>
                <select id="voltajeSistemaAutonomia" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="12">12 V</option>
                  <option value="24" selected>24 V</option>
                  <option value="48">48 V</option>
                </select>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Autonomia deseada (horas)</span>
                <input id="autonomiaDeseada" type="number" min="1" step="0.1" value="6" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]" />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje de bateria (V)</span>
                <select id="voltajeAutonomia" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="12">12 V</option>
                  <option value="24">24 V</option>
                  <option value="48">48 V</option>
                </select>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Capacidad de bateria (Ah)</span>
                <select id="capacidadAutonomia" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="100">100 Ah</option>
                  <option value="150">150 Ah</option>
                  <option value="200">200 Ah</option>
                  <option value="250">250 Ah</option>
                </select>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Profundidad de descarga (%)</span>
                <input id="profDescargaAutonomia" type="number" min="10" max="100" value="80" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]" />
              </label>
            </div>
          </div>

          <div id="resultadosAutonomia" class="mt-6 border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Resultados</h2>
              <span aria-hidden="true" class="text-lg">📊</span>
            </header>
            <div class="grid grid-cols-1 gap-4 px-6 py-6 sm:grid-cols-3">
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Baterias en paralelo</p>
                <p id="paraleloAutonomia" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Total baterias</p>
                <p id="totalAutonomia" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Configuracion</p>
                <p id="configAutonomia" class="mt-1 text-lg font-bold text-slate-700">--</p>
              </div>
            </div>
          </div>

          <div id="diagramaContainerAutonomia" class="border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Diagrama de Conexión</h2>
              <span aria-hidden="true" class="text-lg">⚡</span>
            </header>
            <div class="px-6 py-6">
              <div id="myDiagramDivAutonomia" class="w-full rounded border border-slate-300 bg-white" style="height: 480px;"></div>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-300 px-6 py-6">
          <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-start">
            <a
              href="/calculadora-off-grid/paneles"
              data-nav-loading
              class="inline-flex h-11 w-full items-center justify-center rounded-md border border-slate-500 bg-slate-700 px-6 text-base font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 sm:w-auto"
            >
              Volver a paneles
            </a>
            <a
              id="confirmar-baterias"
              href="/calculadora-off-grid/inversores"
              data-nav-loading
              class="inline-flex h-11 w-full items-center justify-center rounded-md border border-[#b92f1e] bg-[#cc3b26] px-8 text-base font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-[#b9301d] sm:w-auto"
            >
              Continuar
            </a>
          </div>
        </div>

      </section>
      
    </section>
    
  </main>
</Layout>

<script>
  import { registerNavigationPreloader } from "../../lib/navigationPreloader";

  // ======================= Lógica de cálculo =======================
  type ConsumoStorage = {
    totalEnergiaConsumoLoss?: number;
    totalEnergiaConsumo?: number;
    totalEnergia?: number;
  };

  const CONSUMO_STORAGE_KEY = "unicom.offgrid.consumos";
  let modoBateriaActivo: "calculo-baterias" | "tiempo-autonomia" = "calculo-baterias";

  const leerDatosGuardados = (): ConsumoStorage => {
    const valoresIniciales: ConsumoStorage = {
      totalEnergiaConsumoLoss: 0,
      totalEnergiaConsumo: 0,
      totalEnergia: 0,
    };

    try {
      const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
      if (!consumoGuardado) return valoresIniciales;

      const consumo = JSON.parse(consumoGuardado) as ConsumoStorage;
      return {
        totalEnergiaConsumoLoss: typeof consumo.totalEnergiaConsumoLoss === "number" ? consumo.totalEnergiaConsumoLoss : 0,
        totalEnergiaConsumo: typeof consumo.totalEnergiaConsumo === "number" ? consumo.totalEnergiaConsumo : 0,
        totalEnergia: typeof consumo.totalEnergia === "number" ? consumo.totalEnergia : 0,
      };
    } catch (error) {
      console.error("No se pudieron leer los datos guardados para el cálculo de paneles.", error);
      return valoresIniciales;
    }
  };

  function actualizarCampoEnergiaConsumo(): number {
    const { totalEnergiaConsumo = 0 , totalEnergiaConsumoLoss = 0 } = leerDatosGuardados();
    const totalEnergiaConsumoEl = document.getElementById("energiaAjustada") as HTMLElement | null;
    const profDescarga = parseFloat((document.getElementById("profDescarga") as HTMLInputElement).value) / 100;
    const energiaAjustada = totalEnergiaConsumo / profDescarga;
    if (totalEnergiaConsumoEl) {
      totalEnergiaConsumoEl.textContent = `${Number.isInteger(energiaAjustada) ? energiaAjustada : energiaAjustada.toFixed(2)} Wh`;
    }
    return energiaAjustada;
  }

  function actualizarConsumoAutonomia(): void {
    const { totalEnergia = 0 } = leerDatosGuardados();
    const consumoAutonomiaEl = document.getElementById("consumoAutonomiaValor") as HTMLElement | null;
    if (!consumoAutonomiaEl) return;
    consumoAutonomiaEl.textContent = `${Number.isInteger(totalEnergia) ? totalEnergia : totalEnergia.toFixed(2)} Wh`;
  }

  function recomendarVoltajeSistema(totalEnergiaConsumoLoss: number): number {
    if (totalEnergiaConsumoLoss < 2000) return 12;
    if (totalEnergiaConsumoLoss <= 5000) return 24;
    return 48;
  }

  function actualizarControlVoltajeSistema(): void {
    const voltajeSistemaEl = document.getElementById("voltajeSistema") as HTMLSelectElement | null;
    const voltajeBateriaEl = document.getElementById("voltajeSelect") as HTMLSelectElement | null;
    const activarVoltajeManualEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;
    const voltajeRecomendadoInfoEl = document.getElementById("voltajeRecomendadoInfo") as HTMLElement | null;
    if (!voltajeSistemaEl || !activarVoltajeManualEl) return;

    const { totalEnergiaConsumoLoss = 0 } = leerDatosGuardados();
    const voltajeRecomendado = recomendarVoltajeSistema(totalEnergiaConsumoLoss);
    const edicionManualActiva = activarVoltajeManualEl.checked;

    if (!edicionManualActiva) {
      voltajeSistemaEl.value = String(voltajeRecomendado);
    }

    voltajeSistemaEl.disabled = !edicionManualActiva;
    voltajeSistemaEl.classList.toggle("bg-slate-200", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("text-slate-500", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("cursor-not-allowed", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("bg-white", edicionManualActiva);
    voltajeSistemaEl.classList.toggle("text-slate-700", edicionManualActiva);

    if (voltajeBateriaEl) {
      const voltajeSistemaActual = voltajeSistemaEl.value;
      const ultimaReferenciaSistema = voltajeBateriaEl.dataset.systemVoltageRef;

      // Sincroniza por defecto con el sistema al cargar o cuando cambia el voltaje del sistema.
      if (ultimaReferenciaSistema !== voltajeSistemaActual) {
        voltajeBateriaEl.value = voltajeSistemaActual;
        voltajeBateriaEl.dataset.systemVoltageRef = voltajeSistemaActual;
      }
    }

    if (voltajeRecomendadoInfoEl) {
      voltajeRecomendadoInfoEl.textContent = edicionManualActiva
        ? `Modo manual activo. Recomendado: ${voltajeRecomendado} V (para consumo ajustado: ${Number.isInteger(totalEnergiaConsumoLoss) ? totalEnergiaConsumoLoss : totalEnergiaConsumoLoss.toFixed(2)} Wh).`
        : `Voltaje recomendado automáticamente: ${voltajeRecomendado} V (para consumo ajustado: ${Number.isInteger(totalEnergiaConsumoLoss) ? totalEnergiaConsumoLoss : totalEnergiaConsumoLoss.toFixed(2)} Wh).`;
    }
  }


  function calculateBattery() {
    actualizarControlVoltajeSistema();
    const energiaAjustada = actualizarCampoEnergiaConsumo();
    const voltajeSistema = parseInt((document.getElementById("voltajeSistema") as HTMLSelectElement).value);
    const { totalEnergiaConsumo = 0}  = leerDatosGuardados();
    const { totalEnergia = 0 } = leerDatosGuardados();
    const profDescarga = parseFloat((document.getElementById("profDescarga") as HTMLInputElement).value) / 100;
    const voltajeBateria = parseInt((document.getElementById("voltajeSelect") as HTMLSelectElement).value);
    const capacidadBatAh = parseInt((document.getElementById("capacidadSelect") as HTMLSelectElement).value);

    if (!voltajeSistema || !totalEnergiaConsumo || !profDescarga || !voltajeBateria || !capacidadBatAh) return;

    const capacidadBancoBaterias = energiaAjustada / voltajeSistema;
    const bateriasParalelo = Math.max(1, Math.ceil(capacidadBancoBaterias / capacidadBatAh));
    const bateriasSerie = Math.max(1, Math.ceil(voltajeSistema / voltajeBateria));
    const totalBaterias = bateriasSerie * bateriasParalelo;
    
    const tiempoAutonomia = totalEnergia > 0
      ? (capacidadBatAh * voltajeBateria * profDescarga * totalBaterias) / totalEnergia
      : 0;

    // Mostrar resultados
    (document.getElementById("batteriasSerie") as HTMLElement).textContent = `${bateriasSerie} baterias`;
    (document.getElementById("batteriasParalelo") as HTMLElement).textContent = `${bateriasParalelo} baterias`;
    (document.getElementById("totalBaterias") as HTMLElement).textContent = String(totalBaterias);
    (document.getElementById("tiempoAutonomia") as HTMLElement).textContent = `${tiempoAutonomia.toFixed(2)} horas`;
    (document.getElementById("infoBateriaSistema") as HTMLElement).textContent =
      `- Sistema ${voltajeSistema}V
       - Banco de batería(s): ${totalBaterias} batería(s) en paralelo con ${bateriasSerie} en serie
       - Tiempo de autonomía: ${tiempoAutonomia.toFixed(2)} horas
       - ${capacidadBancoBaterias.toFixed(2)} Ah de capacidad total
       
       `;

    document.getElementById("resultados")!.classList.remove("hidden");
    document.getElementById("diagramaContainer")!.classList.remove("hidden");

    const datosActuales = JSON.parse(
      localStorage.getItem(CONSUMO_STORAGE_KEY) || "{}"
    );

    datosActuales.bateriaConfiguracion = {
      calculoBaterias: {
        totalBaterias,
        capacidadBancoAh: capacidadBancoBaterias,
        bateriasSerie,
        bateriasParalelo,
        tiempoAutonomia,
        voltajeSistema,
        voltajeBateria,
        capacidadBatAh,
        profundidadDescarga: profDescarga
      }
    };

    localStorage.setItem(
      CONSUMO_STORAGE_KEY,
      JSON.stringify(datosActuales)
    );

    return { bateriasSerie, bateriasParalelo, voltajeBateria, capacidadBatAh };
  }

  function inicializarEnergia(): void {
    actualizarCampoEnergiaConsumo();
    actualizarConsumoAutonomia();
    actualizarControlVoltajeSistema();
  }

  function ejecutarCalculoBaterias(): void {
    const result = calculateBattery();
    if (!result) return;

    actualizarDiagramaDesdeValores(
      result.bateriasSerie,
      result.bateriasParalelo,
      result.voltajeBateria,
      result.capacidadBatAh,
    );
  }

  function registrarEventosCalculoBaterias(): void {
    const fieldIds = ["voltajeSistema", "horasAutonomia", "profDescarga", "voltajeSelect", "capacidadSelect"];

    fieldIds.forEach((fieldId) => {
      const field = document.getElementById(fieldId) as HTMLInputElement | HTMLSelectElement | null;
      if (!field || field.dataset.batteryBound === "1") return;

      const eventName = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(eventName, ejecutarCalculoBaterias);
      field.dataset.batteryBound = "1";
    });

    const activarVoltajeManualEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;
    if (activarVoltajeManualEl && activarVoltajeManualEl.dataset.batteryBound !== "1") {
      activarVoltajeManualEl.addEventListener("change", () => {
        actualizarControlVoltajeSistema();
        ejecutarCalculoBaterias();
      });
      activarVoltajeManualEl.dataset.batteryBound = "1";
    }
  }

  function calcularTiempoAutonomiaObjetivo() {
    const { totalEnergia = 0 } = leerDatosGuardados();
    actualizarConsumoAutonomia();

    const autonomiaDeseada = parseFloat((document.getElementById("autonomiaDeseada") as HTMLInputElement | null)?.value ?? "0");
    const voltajeSistema = parseFloat((document.getElementById("voltajeSistemaAutonomia") as HTMLSelectElement | null)?.value ?? "0");
    const capacidadAh = parseFloat((document.getElementById("capacidadAutonomia") as HTMLSelectElement | null)?.value ?? "0");
    const voltaje = parseFloat((document.getElementById("voltajeAutonomia") as HTMLSelectElement | null)?.value ?? "0");
    const dod = parseFloat((document.getElementById("profDescargaAutonomia") as HTMLInputElement | null)?.value ?? "0") / 100;
    if (!autonomiaDeseada || !voltajeSistema || !capacidadAh || !voltaje || !dod || !totalEnergia || dod <= 0 || dod > 1) return;

    const serie = Math.max(1, Math.ceil(voltajeSistema / voltaje));

    const totalBaterias = (autonomiaDeseada * totalEnergia) / (capacidadAh * voltaje * dod);
    const paralelo = Math.max(1, Math.ceil(totalBaterias / serie));
    const totalFinal = paralelo * serie;

    const paraleloEl = document.getElementById("paraleloAutonomia") as HTMLElement | null;
    const totalEl = document.getElementById("totalAutonomia") as HTMLElement | null;
    const configEl = document.getElementById("configAutonomia") as HTMLElement | null;

    if (paraleloEl) paraleloEl.textContent = String(paralelo);
    if (totalEl) totalEl.textContent = String(totalFinal);
    if (configEl) configEl.textContent = `${serie} en serie x ${paralelo} en paralelo`;

    actualizarDiagramaDesdeValores(serie, paralelo, voltaje, capacidadAh, "myDiagramDivAutonomia");
  }

  function registrarEventosCalculoAutonomia(): void {
    const fieldIds = ["voltajeSistemaAutonomia", "autonomiaDeseada", "voltajeAutonomia", "capacidadAutonomia", "profDescargaAutonomia"];

    fieldIds.forEach((fieldId) => {
      const field = document.getElementById(fieldId) as HTMLInputElement | HTMLSelectElement | null;
      if (!field || field.dataset.autonomiaBound === "1") return;

      const eventName = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(eventName, calcularTiempoAutonomiaObjetivo);
      field.dataset.autonomiaBound = "1";
    });
  }

  function registrarEventosMenuModoBateria(): void {
    const menu = document.getElementById("battery-mode-menu") as HTMLDivElement | null;
    if (!menu || menu.dataset.modeBound === "1") return;

    const botones = Array.from(menu.querySelectorAll<HTMLButtonElement>(".battery-mode-btn"));
    if (botones.length === 0) return;

    const aplicarModoInterfaz = (modo: "calculo-baterias" | "tiempo-autonomia"): void => {
      const vistaCalculo = document.getElementById("calculo-baterias-view");
      const vistaAutonomia = document.getElementById("tiempo-autonomia-view");
      modoBateriaActivo = modo;

      vistaCalculo?.classList.toggle("hidden", modo !== "calculo-baterias");
      vistaAutonomia?.classList.toggle("hidden", modo !== "tiempo-autonomia");

      if (modo === "calculo-baterias") {
        ejecutarCalculoBaterias();
        return;
      }

      calcularTiempoAutonomiaObjetivo();
    };

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const modo = (boton.dataset.mode === "tiempo-autonomia" ? "tiempo-autonomia" : "calculo-baterias") as "calculo-baterias" | "tiempo-autonomia";

        botones.forEach((item) => {
          const activo = item === boton;
          item.setAttribute("aria-pressed", activo ? "true" : "false");
          item.classList.toggle("bg-[#cc3b26]", activo);
          item.classList.toggle("text-white", activo);
          item.classList.toggle("text-slate-600", !activo);
          item.classList.toggle("hover:text-slate-900", !activo);
        });

        aplicarModoInterfaz(modo);
      });
    });

    const botonInicialActivo = botones.find((item) => item.getAttribute("aria-pressed") === "true") ?? botones[0];
    const modoInicial = (botonInicialActivo?.dataset.mode === "tiempo-autonomia" ? "tiempo-autonomia" : "calculo-baterias") as "calculo-baterias" | "tiempo-autonomia";
    aplicarModoInterfaz(modoInicial);

    menu.dataset.modeBound = "1";
  }

  function registrarToggleInfoResultados(): void {
    const toggleEl = document.getElementById("infoBateriaToggle") as HTMLButtonElement | null;
    const wrapEl = document.getElementById("infoBateriaSistemaWrap") as HTMLElement | null;
    if (!toggleEl || !wrapEl || toggleEl.dataset.bound === "1") return;

    toggleEl.addEventListener("click", () => {
      const abierto = wrapEl.classList.contains("hidden");
      wrapEl.classList.toggle("hidden", !abierto);
      toggleEl.setAttribute("aria-expanded", abierto ? "true" : "false");
      toggleEl.textContent = abierto ? "- info completa" : "+ info completa";
    });

    toggleEl.dataset.bound = "1";
  }

  document.addEventListener("astro:page-load", inicializarEnergia);
  window.addEventListener("pageshow", inicializarEnergia);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarEnergia, { once: true });
  } else {
    inicializarEnergia();
  }

  document.addEventListener("astro:page-load", () => {
    registerNavigationPreloader();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  });

  window.addEventListener("pageshow", () => {
    registerNavigationPreloader();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      registerNavigationPreloader();
      registrarEventosMenuModoBateria();
      registrarEventosCalculoBaterias();
      registrarEventosCalculoAutonomia();
      registrarToggleInfoResultados();
      ejecutarCalculoBaterias();
      calcularTiempoAutonomiaObjetivo();
    }, { once: true });
  } else {
    registerNavigationPreloader();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  }

  // ======================= GoJS - Diagrama de Baterías =======================
  function actualizarDiagramaDesdeValores(series: number, parallel: number, voltajeBateria: number, capacidadBatAh: number, diagramDivId = "myDiagramDiv") {
    const go = (window as any).go;
    if (!go) {
      void loadGoJS()
        .then(() => {
          actualizarDiagramaDesdeValores(series, parallel, voltajeBateria, capacidadBatAh, diagramDivId);
        })
        .catch((error) => {
          console.error("No se pudo inicializar GoJS para el diagrama de baterias.", error);
        });
      return;
    }
    initDiagram(go, series, parallel, voltajeBateria, capacidadBatAh, diagramDivId);
  }

  function initDiagram(go: any, series: number, parallel: number, voltajeBateria: number, capacidadBatAh: number, diagramDivId: string) {
    const $ = go.GraphObject.make;

    // Destruir instancia previa si existe
    const existingDiagram = go.Diagram.fromDiv(diagramDivId);
    if (existingDiagram) existingDiagram.div = null;

    const myDiagram = $(go.Diagram, diagramDivId, {
      "undoManager.isEnabled": false,
      "isReadOnly": true,
      "allowMove": false,
      initialAutoScale: go.Diagram.Uniform,
      padding: 20,
    });

    myDiagram.nodeTemplate =
      $(go.Node, "Spot",
        { locationSpot: go.Spot.Center },
        $(go.Shape, "RoundedRectangle", {
          fill: "#ff8989",
          stroke: "#cc0000",
          strokeWidth: 3,
          width: 110,
          height: 70,
        }),
        $(go.TextBlock, {
          margin: new go.Margin(0, 0, 0, 0),
          font: "bold 9pt sans-serif",
          textAlign: "center",
          stroke: "#333",
          wrap: go.TextBlock.WrapFit,
          width: 90,
        }, new go.Binding("text")),
        // Terminal negativo (-)
        $(go.Panel, "Spot",
          { alignment: new go.Spot(0, 0.5, -15, 0) },
          $(go.Shape, "Rectangle", {
            fill: "#222", stroke: "white", width: 22, height: 22,
            portId: "neg",
            fromSpot: go.Spot.Top, toSpot: go.Spot.Bottom,
            fromLinkable: true, toLinkable: true,
          }),
          $(go.TextBlock, { font: "bold 11pt sans-serif", stroke: "white" },
            new go.Binding("text", "smallText1"))
        ),
        // Terminal positivo (+)
        $(go.Panel, "Spot",
          { alignment: new go.Spot(1, 0.5, 15, 0) },
          $(go.Shape, "Rectangle", {
            fill: "#cc0000", stroke: "#222", width: 22, height: 22,
            portId: "pos",
            fromSpot: go.Spot.Top, toSpot: go.Spot.Bottom,
            fromLinkable: true, toLinkable: true,
          }),
          $(go.TextBlock, { font: "bold 11pt sans-serif", stroke: "white" },
            new go.Binding("text", "smallText2"))
        )
      );

    myDiagram.linkTemplate =
      $(go.Link,
        { routing: go.Link.Orthogonal, corner: 5 },
        $(go.Shape, { strokeWidth: 3 }, new go.Binding("stroke", "color"))
      );

    // Construir nodos y enlaces
    const nodeDataArray: any[] = [];
    const linkDataArray: any[] = [];
    let batCounter = 1;

    for (let p = 0; p < parallel; p++) {
      for (let s = 0; s < series; s++) {
        nodeDataArray.push({
          key: `bat${batCounter}`,
          text: `Bat ${batCounter}\n${voltajeBateria}V · ${capacidadBatAh}Ah`,
          smallText1: "−",
          smallText2: "+",
          row: p,
          column: s,
        });

        // Enlace serie: pos de anterior → neg del actual
        if (s > 0) {
          linkDataArray.push({
            from: `bat${batCounter - 1}`, fromPort: "pos",
            to: `bat${batCounter}`, toPort: "neg",
            color: "#111111",
          });
        }

        batCounter++;
      }

      // Enlaces en paralelo: unir extremos de cada string
      // negativo con negativo (extremo izquierdo) y positivo con positivo (extremo derecho)
      if (p > 0) {
        const currentRowStart = p * series + 1;
        const previousRowStart = (p - 1) * series + 1;
        const currentRowEnd = currentRowStart + series - 1;
        const previousRowEnd = previousRowStart + series - 1;

        linkDataArray.push({
          from: `bat${previousRowStart}`, fromPort: "neg",
          to: `bat${currentRowStart}`, toPort: "neg",
          color: "#0055cc",
        });

        linkDataArray.push({
          from: `bat${previousRowEnd}`, fromPort: "pos",
          to: `bat${currentRowEnd}`, toPort: "pos",
          color: "#0055cc",
        });
      }
    }

    myDiagram.model = new go.GraphLinksModel(nodeDataArray, linkDataArray);

    myDiagram.layout = $(go.GridLayout, {
      wrappingColumn: series,
      alignment: go.GridLayout.Position,
      cellSize: new go.Size(60, 20),
      spacing: new go.Size(30, 20),
    });

    myDiagram.layoutDiagram();
  }

  // Cargar GoJS dinámicamente
  function loadGoJS(): Promise<void> {
    const w = window as any;

    if (w.go) return Promise.resolve();
    if (w.__gojsLoadingPromise) return w.__gojsLoadingPromise;

    w.__gojsLoadingPromise = new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://unpkg.com/gojs/release/go.js";
      script.onload = () => {
        if (w.go) {
          resolve();
          return;
        }

        reject(new Error("GoJS se cargo sin exponer window.go."));
      };
      script.onerror = () => {
        reject(new Error("No se pudo cargar GoJS desde el CDN."));
      };
      document.head.appendChild(script);
    });

    return w.__gojsLoadingPromise;
  }

  void loadGoJS();
</script>
