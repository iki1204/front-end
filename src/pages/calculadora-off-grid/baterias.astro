        </div>

      </section>
      
    </section>
    
  </main>
</Layout>

<script>
  import { registerNavigationPreloader } from "../../lib/navigationPreloader";

  // ======================= Lógica de cálculo =======================
  type ConsumoStorage = {
    totalEnergiaConsumoLoss?: number;
    totalEnergiaConsumo?: number;
    totalEnergia?: number;
    bateriaConfiguracion?: BatteryStoredState;
  };

  type BatteryMode = "calculo-baterias" | "tiempo-autonomia";

  type BatteryModeState = {
    voltajeSistema: number;
    voltajeBateria: number;
    capacidadBateriaAh: number;
    profDescarga: number;
    modoManualVoltaje: boolean;
    bateriasSerie: number;
    bateriasParalelo: number;
    capacidadBancoAh: number;
    totalBaterias: number;
    tiempoAutonomiaHoras: number;
    autonomiaDeseada: number;
  };

  type BatteryStoredState = {
    modoActivo: BatteryMode;
    calculoBaterias: BatteryModeState;
    tiempoAutonomia: BatteryModeState;
  };

  const CONSUMO_STORAGE_KEY = "unicom.offgrid.consumos";
  const DEFAULT_BATTERY_MODE_STATE: BatteryModeState = {
    voltajeSistema: 12,
    voltajeBateria: 12,
    capacidadBateriaAh: 100,
    profDescarga: 80,
    modoManualVoltaje: false,
    bateriasSerie: 0,
    bateriasParalelo: 0,
    capacidadBancoAh: 0,
    totalBaterias: 0,
    tiempoAutonomiaHoras: 0,
    autonomiaDeseada: 6,
  };

  const DEFAULT_BATTERY_STATE: BatteryStoredState = {
    modoActivo: "calculo-baterias",
    calculoBaterias: { ...DEFAULT_BATTERY_MODE_STATE },
    tiempoAutonomia: { ...DEFAULT_BATTERY_MODE_STATE },
  };

  let modoBateriaActivo: BatteryMode = "calculo-baterias";

  const esNumeroValido = (value: unknown): value is number => typeof value === "number" && Number.isFinite(value);

  const normalizarModoBateria = (value: unknown): BatteryMode => value === "tiempo-autonomia" ? "tiempo-autonomia" : "calculo-baterias";

  const normalizarEstadoModo = (value: unknown): BatteryModeState => {
    const source = (value ?? {}) as Partial<BatteryModeState>;
    return {
      voltajeSistema: esNumeroValido(source.voltajeSistema) ? source.voltajeSistema : DEFAULT_BATTERY_MODE_STATE.voltajeSistema,
      voltajeBateria: esNumeroValido(source.voltajeBateria) ? source.voltajeBateria : DEFAULT_BATTERY_MODE_STATE.voltajeBateria,
      capacidadBateriaAh: esNumeroValido(source.capacidadBateriaAh) ? source.capacidadBateriaAh : DEFAULT_BATTERY_MODE_STATE.capacidadBateriaAh,
      profDescarga: esNumeroValido(source.profDescarga) ? source.profDescarga : DEFAULT_BATTERY_MODE_STATE.profDescarga,
      modoManualVoltaje: source.modoManualVoltaje === true,
      bateriasSerie: esNumeroValido(source.bateriasSerie) ? source.bateriasSerie : DEFAULT_BATTERY_MODE_STATE.bateriasSerie,
      bateriasParalelo: esNumeroValido(source.bateriasParalelo) ? source.bateriasParalelo : DEFAULT_BATTERY_MODE_STATE.bateriasParalelo,
      capacidadBancoAh: esNumeroValido(source.capacidadBancoAh) ? source.capacidadBancoAh : DEFAULT_BATTERY_MODE_STATE.capacidadBancoAh,
      totalBaterias: esNumeroValido(source.totalBaterias) ? source.totalBaterias : DEFAULT_BATTERY_MODE_STATE.totalBaterias,
      tiempoAutonomiaHoras: esNumeroValido(source.tiempoAutonomiaHoras) ? source.tiempoAutonomiaHoras : DEFAULT_BATTERY_MODE_STATE.tiempoAutonomiaHoras,
      autonomiaDeseada: esNumeroValido(source.autonomiaDeseada) ? source.autonomiaDeseada : DEFAULT_BATTERY_MODE_STATE.autonomiaDeseada,
    };
  };

  const leerEstadoBateriaGuardado = (): BatteryStoredState => {
    try {
      const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
      if (!consumoGuardado) {
        return {
          modoActivo: DEFAULT_BATTERY_STATE.modoActivo,
          calculoBaterias: { ...DEFAULT_BATTERY_STATE.calculoBaterias },
          tiempoAutonomia: { ...DEFAULT_BATTERY_STATE.tiempoAutonomia },
        };
      }

      const consumo = JSON.parse(consumoGuardado) as ConsumoStorage;
      const estado = (consumo.bateriaConfiguracion ?? {}) as Partial<BatteryStoredState>;

      return {
        modoActivo: normalizarModoBateria(estado.modoActivo),
        calculoBaterias: normalizarEstadoModo(estado.calculoBaterias),
        tiempoAutonomia: normalizarEstadoModo(estado.tiempoAutonomia),
      };
    } catch (error) {
      console.error("No se pudo leer la configuración de baterías guardada.", error);
      return {
        modoActivo: DEFAULT_BATTERY_STATE.modoActivo,
        calculoBaterias: { ...DEFAULT_BATTERY_STATE.calculoBaterias },
        tiempoAutonomia: { ...DEFAULT_BATTERY_STATE.tiempoAutonomia },
      };
    }
  };

  const guardarEstadoBateria = (updater: (current: BatteryStoredState) => BatteryStoredState): void => {
    try {
      const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
      const consumoActual = consumoGuardado
        ? JSON.parse(consumoGuardado) as ConsumoStorage
        : {};

      const estadoActual = leerEstadoBateriaGuardado();
      const estadoSiguiente = updater(estadoActual);

      const consumoActualizado: ConsumoStorage = {
        ...consumoActual,
        bateriaConfiguracion: {
          modoActivo: normalizarModoBateria(estadoSiguiente.modoActivo),
          calculoBaterias: normalizarEstadoModo(estadoSiguiente.calculoBaterias),
          tiempoAutonomia: normalizarEstadoModo(estadoSiguiente.tiempoAutonomia),
        },
      };

      window.localStorage.setItem(CONSUMO_STORAGE_KEY, JSON.stringify(consumoActualizado));
    } catch (error) {
      console.error("No se pudo guardar la configuración de baterías.", error);
    }
  };

  const setSelectValueIfExists = (elementId: string, value: number): void => {
    const selectEl = document.getElementById(elementId) as HTMLSelectElement | null;
    if (!selectEl) return;
    const target = String(value);
    const exists = Array.from(selectEl.options).some((option) => option.value === target);
    if (exists) selectEl.value = target;
  };

  const setInputNumberValue = (elementId: string, value: number): void => {
    const inputEl = document.getElementById(elementId) as HTMLInputElement | null;
    if (!inputEl || !Number.isFinite(value)) return;
    inputEl.value = String(value);
  };

  const aplicarEstadoCalculoEnFormulario = (state: BatteryModeState): void => {
    setSelectValueIfExists("voltajeSistemaAutonomia", state.voltajeSistema);
    setSelectValueIfExists("voltajeSelect", state.voltajeBateria);
    setSelectValueIfExists("capacidadSelect", state.capacidadBateriaAh);
    setInputNumberValue("profDescarga", state.profDescarga);

    const manualCalculoEl = document.getElementById("activarVoltajeManualAutonomia") as HTMLInputElement | null;
    const manualAutonomiaEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;
    if (manualCalculoEl) manualCalculoEl.checked = state.modoManualVoltaje;
    if (manualAutonomiaEl) manualAutonomiaEl.checked = state.modoManualVoltaje;

    actualizarControlVoltajeSistema(state.modoManualVoltaje);
  };

  const aplicarEstadoAutonomiaEnFormulario = (state: BatteryModeState): void => {
    setSelectValueIfExists("voltajeSistema", state.voltajeSistema);
    setSelectValueIfExists("voltajeAutonomia", state.voltajeBateria);
    setSelectValueIfExists("capacidadAutonomia", state.capacidadBateriaAh);
    setInputNumberValue("profDescargaAutonomia", state.profDescarga);
    setInputNumberValue("autonomiaDeseada", state.autonomiaDeseada);

    const manualCalculoEl = document.getElementById("activarVoltajeManualAutonomia") as HTMLInputElement | null;
    const manualAutonomiaEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;
    if (manualCalculoEl) manualCalculoEl.checked = state.modoManualVoltaje;
    if (manualAutonomiaEl) manualAutonomiaEl.checked = state.modoManualVoltaje;

    actualizarControlVoltajeSistema(state.modoManualVoltaje);
  };

  const restaurarFormularioBateriasDesdeStorage = (): void => {
    const estadoGuardado = leerEstadoBateriaGuardado();
    aplicarEstadoCalculoEnFormulario(estadoGuardado.calculoBaterias);
    aplicarEstadoAutonomiaEnFormulario(estadoGuardado.tiempoAutonomia);
  };

  const leerDatosGuardados = (): ConsumoStorage => {
    const valoresIniciales: ConsumoStorage = {
      totalEnergiaConsumoLoss: 0,
      totalEnergiaConsumo: 0,
      totalEnergia: 0,
    };

    try {
      const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
      if (!consumoGuardado) return valoresIniciales;

      const consumo = JSON.parse(consumoGuardado) as ConsumoStorage;
      return {
        totalEnergiaConsumoLoss: typeof consumo.totalEnergiaConsumoLoss === "number" ? consumo.totalEnergiaConsumoLoss : 0,
        totalEnergiaConsumo: typeof consumo.totalEnergiaConsumo === "number" ? consumo.totalEnergiaConsumo : 0,
        totalEnergia: typeof consumo.totalEnergia === "number" ? consumo.totalEnergia : 0,
      };
    } catch (error) {
      console.error("No se pudieron leer los datos guardados para el cálculo de paneles.", error);
      return valoresIniciales;
    }
  };

  function actualizarCampoEnergiaConsumo(): number {
    const { totalEnergiaConsumo = 0 } = leerDatosGuardados();
    const totalEnergiaConsumoEl = document.getElementById("energiaAjustada") as HTMLElement | null;
    const profDescargaEl = document.getElementById("profDescarga") as HTMLInputElement | null;
    const profDescargaValor = obtenerDod(profDescargaEl);
    const profDescarga = validarDodParaCalculo(profDescargaValor) ? (profDescargaValor! / 100) : 0.8;
    const energiaAjustada = totalEnergiaConsumo / profDescarga;
    if (totalEnergiaConsumoEl) {
      totalEnergiaConsumoEl.textContent = `${Number.isInteger(energiaAjustada) ? energiaAjustada : energiaAjustada.toFixed(2)} Wh`;
    }
    return energiaAjustada;
  }

  function actualizarConsumoAutonomia(): void {
    const { totalEnergia = 0 } = leerDatosGuardados();
    const consumoAutonomiaEl = document.getElementById("consumoAutonomiaValor") as HTMLElement | null;
    if (!consumoAutonomiaEl) return;
    consumoAutonomiaEl.textContent = `${Number.isInteger(totalEnergia) ? totalEnergia : totalEnergia.toFixed(2)} W`;
  }

  function recomendarVoltajeSistema(totalEnergiaConsumoLoss: number): number {
    if (totalEnergiaConsumoLoss < 2000) return 12;
    if (totalEnergiaConsumoLoss <= 5000) return 24;
    return 48;
  }

  // Obtiene el valor de DOD del input sin validar (permite campos vacíos)
  function obtenerDod(inputEl: HTMLInputElement | null): number | null {
    if (!inputEl || inputEl.value.trim() === "") return null;
    const valor = Number.parseFloat(inputEl.value);
    return Number.isFinite(valor) ? valor : null;
  }

  // Valida que el DOD sea válido para cálculos (no 0, null, NaN)
  function validarDodParaCalculo(dodValue: number | null): boolean {
    return dodValue !== null && dodValue !== 0 && Number.isFinite(dodValue) && dodValue > 0;
  }

  // Normaliza DOD a rango 10-100 (solo en blur para UI)
  function normalizarDodEnBlur(inputEl: HTMLInputElement | null): void {
    if (!inputEl || inputEl.value.trim() === "") return; // Permite campo vacío

    const valor = Number.parseFloat(inputEl.value);
    if (!Number.isFinite(valor)) return; // Si no es número, no modifica

    let normalizado = valor;
    if (normalizado < 10) normalizado = 10;
    if (normalizado > 100) normalizado = 100;

    inputEl.value = String(normalizado);
  }

  function actualizarControlVoltajeSistema(edicionManualForzada?: boolean): void {
    const voltajeSistemaEl = document.getElementById("voltajeSistemaAutonomia") as HTMLSelectElement | null;
    const voltajeSistemaAutonomiaEl = document.getElementById("voltajeSistema") as HTMLSelectElement | null;
    const voltajeBateriaEl = document.getElementById("voltajeSelect") as HTMLSelectElement | null;
    const activarVoltajeManualEl = document.getElementById("activarVoltajeManualAutonomia") as HTMLInputElement | null;
    const activarVoltajeManualAutonomiaEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;
    const voltajeRecomendadoInfoEl = document.getElementById("voltajeRecomendadoInfoAutonomia") as HTMLElement | null;
    const voltajeRecomendadoInfoAutonomiaEl = document.getElementById("voltajeRecomendadoInfo") as HTMLElement | null;
    if (!voltajeSistemaEl || !activarVoltajeManualEl) return;

    const { totalEnergiaConsumoLoss = 0 } = leerDatosGuardados();
    const voltajeRecomendado = recomendarVoltajeSistema(totalEnergiaConsumoLoss);
    const edicionManualActiva = edicionManualForzada ?? activarVoltajeManualEl.checked;

    activarVoltajeManualEl.checked = edicionManualActiva;
    if (activarVoltajeManualAutonomiaEl) {
      activarVoltajeManualAutonomiaEl.checked = edicionManualActiva;
    }

    if (!edicionManualActiva) {
      voltajeSistemaEl.value = String(voltajeRecomendado);
      if (voltajeSistemaAutonomiaEl) {
        voltajeSistemaAutonomiaEl.value = String(voltajeRecomendado);
      }
    }

    voltajeSistemaEl.disabled = !edicionManualActiva;
    voltajeSistemaEl.classList.toggle("bg-slate-200", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("text-slate-500", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("cursor-not-allowed", !edicionManualActiva);
    voltajeSistemaEl.classList.toggle("bg-white", edicionManualActiva);
    voltajeSistemaEl.classList.toggle("text-slate-700", edicionManualActiva);

    if (voltajeSistemaAutonomiaEl) {
      voltajeSistemaAutonomiaEl.disabled = !edicionManualActiva;
      voltajeSistemaAutonomiaEl.classList.toggle("bg-slate-200", !edicionManualActiva);
      voltajeSistemaAutonomiaEl.classList.toggle("text-slate-500", !edicionManualActiva);
      voltajeSistemaAutonomiaEl.classList.toggle("cursor-not-allowed", !edicionManualActiva);
      voltajeSistemaAutonomiaEl.classList.toggle("bg-white", edicionManualActiva);
      voltajeSistemaAutonomiaEl.classList.toggle("text-slate-700", edicionManualActiva);
    }

    if (voltajeBateriaEl) {
      const voltajeSistemaActual = voltajeSistemaEl.value;
      const ultimaReferenciaSistema = voltajeBateriaEl.dataset.systemVoltageRef;

      // Sincroniza por defecto con el sistema al cargar o cuando cambia el voltaje del sistema.
      if (ultimaReferenciaSistema !== voltajeSistemaActual) {
        voltajeBateriaEl.value = voltajeSistemaActual;
        voltajeBateriaEl.dataset.systemVoltageRef = voltajeSistemaActual;
      }
    }

    const textoVoltaje = edicionManualActiva
      ? `Modo manual activo. Recomendado: ${voltajeRecomendado} V (para consumo ajustado: ${Number.isInteger(totalEnergiaConsumoLoss) ? totalEnergiaConsumoLoss : totalEnergiaConsumoLoss.toFixed(2)} Wh).`
      : `Voltaje recomendado automáticamente: ${voltajeRecomendado} V (para consumo ajustado: ${Number.isInteger(totalEnergiaConsumoLoss) ? totalEnergiaConsumoLoss : totalEnergiaConsumoLoss.toFixed(2)} Wh).`;

    if (voltajeRecomendadoInfoEl) {
      voltajeRecomendadoInfoEl.textContent = textoVoltaje;
    }

    if (voltajeRecomendadoInfoAutonomiaEl) {
      voltajeRecomendadoInfoAutonomiaEl.textContent = textoVoltaje;
    }
  }


  function calculateBattery() {
    actualizarControlVoltajeSistema();
    const energiaAjustada = actualizarCampoEnergiaConsumo();
    const voltajeSistema = parseInt((document.getElementById("voltajeSistemaAutonomia") as HTMLSelectElement).value);
    const { totalEnergiaConsumo = 0}  = leerDatosGuardados();
    const { totalEnergia = 0 } = leerDatosGuardados();
    const profDescargaEl = document.getElementById("profDescarga") as HTMLInputElement | null;
    const profDescargaValor = obtenerDod(profDescargaEl);
    
    // Valida que DOD sea válido (no 0, null, NaN)
    if (!validarDodParaCalculo(profDescargaValor)) {
      console.warn("DOD (Profundidad de Descarga) inválida o vacía. Ingrese un valor entre 10 y 100.");
      document.getElementById("resultados")?.classList.add("hidden");
      document.getElementById("diagramaContainer")?.classList.add("hidden");
      return;
    }
    
    const profDescarga = profDescargaValor! / 100;
    const voltajeBateria = parseInt((document.getElementById("voltajeSelect") as HTMLSelectElement).value);
    const capacidadBatAh = parseInt((document.getElementById("capacidadSelect") as HTMLSelectElement).value);

    if (!voltajeSistema || !totalEnergiaConsumo || !voltajeBateria || !capacidadBatAh) return;

    const capacidadBancoBaterias = energiaAjustada / voltajeSistema;
    const bateriasParalelo = Math.max(1, Math.ceil(capacidadBancoBaterias / capacidadBatAh));
    const bateriasSerie = Math.max(1, Math.ceil(voltajeSistema / voltajeBateria));
    const totalBaterias = bateriasSerie * bateriasParalelo;
    
    const tiempoAutonomia = totalEnergia > 0
      ? (capacidadBatAh * voltajeBateria * profDescarga * totalBaterias) / totalEnergia
      : 0;

    // Mostrar resultados
    (document.getElementById("batteriasSerie") as HTMLElement).textContent = `${bateriasSerie} baterias`;
    (document.getElementById("batteriasParalelo") as HTMLElement).textContent = `${bateriasParalelo} baterias`;
    (document.getElementById("totalBaterias") as HTMLElement).textContent = String(totalBaterias);
    (document.getElementById("tiempoAutonomia") as HTMLElement).textContent = `${tiempoAutonomia.toFixed(2)} horas`;
    (document.getElementById("infoBateriaSistema") as HTMLElement).textContent =
      `- Sistema ${voltajeSistema}V
       - Banco de batería(s): ${totalBaterias} batería(s) en paralelo con ${bateriasSerie} en serie
       - Tiempo de autonomía: ${tiempoAutonomia.toFixed(2)} horas
       - ${capacidadBancoBaterias.toFixed(2)} Ah de capacidad total
       `;

    guardarEstadoBateria((actual) => ({
      ...actual,
      modoActivo: modoBateriaActivo,
      calculoBaterias: {
        ...actual.calculoBaterias,
        voltajeSistema,
        voltajeBateria,
        capacidadBateriaAh: capacidadBatAh,
        profDescarga: profDescargaValor ?? actual.calculoBaterias.profDescarga,
        modoManualVoltaje: (document.getElementById("activarVoltajeManualAutonomia") as HTMLInputElement | null)?.checked === true,
        bateriasSerie,
        bateriasParalelo,
        capacidadBancoAh: Number(capacidadBancoBaterias.toFixed(2)),
        totalBaterias,
        tiempoAutonomiaHoras: Number(tiempoAutonomia.toFixed(2)),
      },
    }));

    document.getElementById("resultados")!.classList.remove("hidden");
    document.getElementById("diagramaContainer")!.classList.remove("hidden");

    return { bateriasSerie, bateriasParalelo, voltajeBateria, capacidadBatAh };
  }

  function inicializarEnergia(): void {
    restaurarFormularioBateriasDesdeStorage();
    actualizarCampoEnergiaConsumo();
    actualizarConsumoAutonomia();
    actualizarControlVoltajeSistema();
  }

  function ejecutarCalculoBaterias(): void {
    const result = calculateBattery();
    if (!result) return;

    actualizarDiagramaDesdeValores(
      result.bateriasSerie,
      result.bateriasParalelo,
      result.voltajeBateria,
      result.capacidadBatAh,
    );
  }

  function registrarEventosCalculoBaterias(): void {
    const fieldIds = ["voltajeSistemaAutonomia", "profDescarga", "voltajeSelect", "capacidadSelect"];

    fieldIds.forEach((fieldId) => {
      const field = document.getElementById(fieldId) as HTMLInputElement | HTMLSelectElement | null;
      if (!field || field.dataset.batteryBound === "1") return;

      const eventName = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(eventName, () => {
        guardarEstadoBateria((actual) => ({
          ...actual,
          calculoBaterias: {
            ...actual.calculoBaterias,
            voltajeSistema: Number((document.getElementById("voltajeSistemaAutonomia") as HTMLSelectElement | null)?.value ?? actual.calculoBaterias.voltajeSistema),
            voltajeBateria: Number((document.getElementById("voltajeSelect") as HTMLSelectElement | null)?.value ?? actual.calculoBaterias.voltajeBateria),
            capacidadBateriaAh: Number((document.getElementById("capacidadSelect") as HTMLSelectElement | null)?.value ?? actual.calculoBaterias.capacidadBateriaAh),
            profDescarga: Number((document.getElementById("profDescarga") as HTMLInputElement | null)?.value ?? actual.calculoBaterias.profDescarga),
          },
        }));
        ejecutarCalculoBaterias();
      });
      field.dataset.batteryBound = "1";
    });

    const activarVoltajeManualEl = document.getElementById("activarVoltajeManualAutonomia") as HTMLInputElement | null;
    const activarVoltajeManualAutonomiaEl = document.getElementById("activarVoltajeManual") as HTMLInputElement | null;

    [activarVoltajeManualEl, activarVoltajeManualAutonomiaEl].forEach((checkbox) => {
      if (!checkbox || checkbox.dataset.batteryBound === "1") return;

      checkbox.addEventListener("change", () => {
        actualizarControlVoltajeSistema(checkbox.checked);
        guardarEstadoBateria((actual) => ({
          ...actual,
          calculoBaterias: {
            ...actual.calculoBaterias,
            modoManualVoltaje: checkbox.checked,
          },
          tiempoAutonomia: {
            ...actual.tiempoAutonomia,
            modoManualVoltaje: checkbox.checked,
          },
        }));
        ejecutarCalculoBaterias();
        calcularTiempoAutonomiaObjetivo();
      });
      checkbox.dataset.batteryBound = "1";
    });
  }

  function registrarValidadoresDod(): void {
    const dodIds = ["profDescarga", "profDescargaAutonomia"];

    dodIds.forEach((dodId) => {
      const inputEl = document.getElementById(dodId) as HTMLInputElement | null;
      if (!inputEl || inputEl.dataset.dodBound === "1") return;

      // Solo valida/normaliza en blur para permitir edición temporal
      inputEl.addEventListener("blur", () => {
        normalizarDodEnBlur(inputEl);
      });
      
      inputEl.dataset.dodBound = "1";
    });
  }

  function obtenerElementoAutonomia<T extends HTMLElement>(selector: string): T | null {
    const vistaAutonomia = document.getElementById("tiempo-autonomia-view");
    if (!vistaAutonomia) return null;
    return vistaAutonomia.querySelector(selector) as T | null;
  }

  function calcularTiempoAutonomiaObjetivo() {
    const { totalEnergia = 0 } = leerDatosGuardados();
    actualizarConsumoAutonomia();

    const energiaAjustada = actualizarCampoEnergiaConsumo();
    const autonomiaDeseada = parseFloat((document.getElementById("autonomiaDeseada") as HTMLInputElement | null)?.value ?? "0");
    const voltajeSistema = parseFloat(obtenerElementoAutonomia<HTMLSelectElement>("#voltajeSistema")?.value ?? "0");
    const capacidadAh = parseFloat((document.getElementById("capacidadAutonomia") as HTMLSelectElement | null)?.value ?? "0");
    const voltaje = parseFloat((document.getElementById("voltajeAutonomia") as HTMLSelectElement | null)?.value ?? "0");
    const dodEl = document.getElementById("profDescargaAutonomia") as HTMLInputElement | null;
    const dodValor = obtenerDod(dodEl);
    
    // Valida que DOD sea válido (no 0, null, NaN)
    if (!validarDodParaCalculo(dodValor)) {
      console.warn("DOD (Profundidad de Descarga) inválida o vacía. Ingrese un valor entre 10 y 100.");
      document.getElementById("resultadosAutonomia")?.classList.add("hidden");
      return;
    }
    
    const dod = dodValor! / 100;
    if (!autonomiaDeseada || !voltajeSistema || !capacidadAh || !voltaje || !totalEnergia) return;

    const capacidadBancoBaterias = energiaAjustada / voltajeSistema;
    const serie = Math.max(1, Math.ceil(voltajeSistema / voltaje));

    const totalBaterias = (autonomiaDeseada * totalEnergia) / (capacidadAh * voltaje * dod);
    const paralelo = Math.max(1, Math.ceil(totalBaterias / serie));
    const totalFinal = paralelo * serie;

    const bancoBateriasEl = document.getElementById("bancoBaterias") as HTMLElement | null;
    const totalEl = document.getElementById("totalAutonomia") as HTMLElement | null;
    const configEl = document.getElementById("configAutonomia") as HTMLElement | null;

    if (bancoBateriasEl) bancoBateriasEl.textContent = String(capacidadBancoBaterias.toFixed(2));
    if (totalEl) totalEl.textContent = String(totalFinal);
    if (configEl) configEl.textContent = `${serie} en serie x ${paralelo} en paralelo`;

    guardarEstadoBateria((actual) => ({
      ...actual,
      modoActivo: modoBateriaActivo,
      tiempoAutonomia: {
        ...actual.tiempoAutonomia,
        voltajeSistema,
        voltajeBateria: voltaje,
        capacidadBateriaAh: capacidadAh,
        profDescarga: dodValor ?? actual.tiempoAutonomia.profDescarga,
        autonomiaDeseada,
        modoManualVoltaje: (document.getElementById("activarVoltajeManual") as HTMLInputElement | null)?.checked === true,
        bateriasSerie: serie,
        bateriasParalelo: paralelo,
        capacidadBancoAh: Number(capacidadBancoBaterias.toFixed(2)),
        totalBaterias: totalFinal,
      },
    }));

    actualizarDiagramaDesdeValores(serie, paralelo, voltaje, capacidadAh, "myDiagramDivAutonomia");
  }

  function registrarEventosCalculoAutonomia(): void {
    const selectores = ["#voltajeSistema", "#autonomiaDeseada", "#voltajeAutonomia", "#capacidadAutonomia", "#profDescargaAutonomia"];

    selectores.forEach((selector) => {
      const field = obtenerElementoAutonomia<HTMLInputElement | HTMLSelectElement>(selector);
      if (!field || field.dataset.autonomiaBound === "1") return;

      const eventName = field instanceof HTMLSelectElement ? "change" : "input";
      field.addEventListener(eventName, () => {
        guardarEstadoBateria((actual) => ({
          ...actual,
          tiempoAutonomia: {
            ...actual.tiempoAutonomia,
            voltajeSistema: Number(obtenerElementoAutonomia<HTMLSelectElement>("#voltajeSistema")?.value ?? actual.tiempoAutonomia.voltajeSistema),
            voltajeBateria: Number((document.getElementById("voltajeAutonomia") as HTMLSelectElement | null)?.value ?? actual.tiempoAutonomia.voltajeBateria),
            capacidadBateriaAh: Number((document.getElementById("capacidadAutonomia") as HTMLSelectElement | null)?.value ?? actual.tiempoAutonomia.capacidadBateriaAh),
            profDescarga: Number((document.getElementById("profDescargaAutonomia") as HTMLInputElement | null)?.value ?? actual.tiempoAutonomia.profDescarga),
            autonomiaDeseada: Number((document.getElementById("autonomiaDeseada") as HTMLInputElement | null)?.value ?? actual.tiempoAutonomia.autonomiaDeseada),
          },
        }));
        calcularTiempoAutonomiaObjetivo();
      });
      field.dataset.autonomiaBound = "1";
    });
  }

  function registrarEventosMenuModoBateria(): void {
    const menu = document.getElementById("battery-mode-menu") as HTMLDivElement | null;
    if (!menu || menu.dataset.modeBound === "1") return;

    const botones = Array.from(menu.querySelectorAll<HTMLButtonElement>(".battery-mode-btn"));
    if (botones.length === 0) return;

    const actualizarBotonesModo = (modo: BatteryMode): void => {
      botones.forEach((item) => {
        const activo = item.dataset.mode === modo;
        item.setAttribute("aria-pressed", activo ? "true" : "false");
        item.classList.toggle("bg-[#cc3b26]", activo);
        item.classList.toggle("text-white", activo);
        item.classList.toggle("text-slate-600", !activo);
        item.classList.toggle("hover:text-slate-900", !activo);
      });
    };

    const aplicarModoInterfaz = (modo: BatteryMode): void => {
      const vistaCalculo = document.getElementById("calculo-baterias-view");
      const vistaAutonomia = document.getElementById("tiempo-autonomia-view");
      modoBateriaActivo = modo;

       guardarEstadoBateria((actual) => ({
        ...actual,
        modoActivo: modo,
      }));

      const estado = leerEstadoBateriaGuardado();
      if (modo === "calculo-baterias") {
        aplicarEstadoCalculoEnFormulario(estado.calculoBaterias);
      } else {
        aplicarEstadoAutonomiaEnFormulario(estado.tiempoAutonomia);
      }

      vistaCalculo?.classList.toggle("hidden", modo !== "calculo-baterias");
      vistaAutonomia?.classList.toggle("hidden", modo !== "tiempo-autonomia");

      if (modo === "calculo-baterias") {
        ejecutarCalculoBaterias();
        return;
      }

      calcularTiempoAutonomiaObjetivo();
    };

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const modo = normalizarModoBateria(boton.dataset.mode);
        actualizarBotonesModo(modo);

        aplicarModoInterfaz(modo);
      });
    });

    const modoInicial = leerEstadoBateriaGuardado().modoActivo;
    actualizarBotonesModo(modoInicial);
    aplicarModoInterfaz(modoInicial);

    menu.dataset.modeBound = "1";
  }

  function registrarToggleInfoResultados(): void {
    const toggleEl = document.getElementById("infoBateriaToggle") as HTMLButtonElement | null;
    const wrapEl = document.getElementById("infoBateriaSistemaWrap") as HTMLElement | null;
    if (!toggleEl || !wrapEl || toggleEl.dataset.bound === "1") return;

    toggleEl.addEventListener("click", () => {
      const abierto = wrapEl.classList.contains("hidden");
      wrapEl.classList.toggle("hidden", !abierto);
      toggleEl.setAttribute("aria-expanded", abierto ? "true" : "false");
      toggleEl.textContent = abierto ? "- info completa" : "+ info completa";
    });

    toggleEl.dataset.bound = "1";
  }

  document.addEventListener("astro:page-load", inicializarEnergia);
  window.addEventListener("pageshow", inicializarEnergia);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", inicializarEnergia, { once: true });
  } else {
    inicializarEnergia();
  }

  document.addEventListener("astro:page-load", () => {
    registerNavigationPreloader();
    registrarValidadoresDod();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  });

  window.addEventListener("pageshow", () => {
    registerNavigationPreloader();
    registrarValidadoresDod();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      registerNavigationPreloader();
      registrarValidadoresDod();
      registrarEventosMenuModoBateria();
      registrarEventosCalculoBaterias();
      registrarEventosCalculoAutonomia();
      registrarToggleInfoResultados();
      ejecutarCalculoBaterias();
      calcularTiempoAutonomiaObjetivo();
    }, { once: true });
  } else {
    registerNavigationPreloader();
    registrarValidadoresDod();
    registrarEventosMenuModoBateria();
    registrarEventosCalculoBaterias();
    registrarEventosCalculoAutonomia();
    registrarToggleInfoResultados();
    ejecutarCalculoBaterias();
    calcularTiempoAutonomiaObjetivo();
  }

  // ======================= GoJS - Diagrama de Baterías =======================
  function actualizarDiagramaDesdeValores(series: number, parallel: number, voltajeBateria: number, capacidadBatAh: number, diagramDivId = "myDiagramDiv") {
    const go = (window as any).go;
    if (!go) {
      void loadGoJS()
        .then(() => {
          actualizarDiagramaDesdeValores(series, parallel, voltajeBateria, capacidadBatAh, diagramDivId);
        })
        .catch((error) => {
          console.error("No se pudo inicializar GoJS para el diagrama de baterias.", error);
        });
      return;
    }
    initDiagram(go, series, parallel, voltajeBateria, capacidadBatAh, diagramDivId);
  }

  function initDiagram(go: any, series: number, parallel: number, voltajeBateria: number, capacidadBatAh: number, diagramDivId: string) {
    const $ = go.GraphObject.make;

    // Destruir instancia previa si existe
    const existingDiagram = go.Diagram.fromDiv(diagramDivId);
    if (existingDiagram) existingDiagram.div = null;

    const myDiagram = $(go.Diagram, diagramDivId, {
      "undoManager.isEnabled": false,
      "isReadOnly": true,
      "allowMove": false,
      initialAutoScale: go.Diagram.Uniform,
      contentAlignment: go.Spot.Center,
      minScale: 0.08,
      maxScale: 1.2,
      padding: 20,
    });

    myDiagram.nodeTemplate =
      $(go.Node, "Spot",
        { locationSpot: go.Spot.Center },
        $(go.Shape, "RoundedRectangle", {
          fill: "#ff8989",
          stroke: "#cc0000",
          strokeWidth: 3,
          width: 110,
          height: 70,
        }),
        $(go.TextBlock, {
          margin: new go.Margin(0, 0, 0, 0),
          font: "bold 9pt sans-serif",
          textAlign: "center",
          stroke: "#333",
          wrap: go.TextBlock.WrapFit,
          width: 90,
        }, new go.Binding("text")),
        // Terminal negativo (-)
        $(go.Panel, "Spot",
          { alignment: new go.Spot(0, 0.5, -15, 0) },
          $(go.Shape, "Rectangle", {
            fill: "#222", stroke: "white", width: 22, height: 22,
            portId: "neg",
            fromSpot: go.Spot.Top, toSpot: go.Spot.Bottom,
            fromLinkable: true, toLinkable: true,
          }),
          $(go.TextBlock, { font: "bold 11pt sans-serif", stroke: "white" },
            new go.Binding("text", "smallText1"))
        ),
        // Terminal positivo (+)
        $(go.Panel, "Spot",
          { alignment: new go.Spot(1, 0.5, 15, 0) },
          $(go.Shape, "Rectangle", {
            fill: "#cc0000", stroke: "#222", width: 22, height: 22,
            portId: "pos",
            fromSpot: go.Spot.Top, toSpot: go.Spot.Bottom,
            fromLinkable: true, toLinkable: true,
          }),
          $(go.TextBlock, { font: "bold 11pt sans-serif", stroke: "white" },
            new go.Binding("text", "smallText2"))
        )
      );

    myDiagram.linkTemplate =
      $(go.Link,
        { routing: go.Link.Orthogonal, corner: 5 },
        $(go.Shape, { strokeWidth: 3 }, new go.Binding("stroke", "color"))
      );

    // Construir nodos y enlaces
    const nodeDataArray: any[] = [];
    const linkDataArray: any[] = [];
    let batCounter = 1;

    for (let p = 0; p < parallel; p++) {
      for (let s = 0; s < series; s++) {
        nodeDataArray.push({
          key: `bat${batCounter}`,
          text: `Bat ${batCounter}\n${voltajeBateria}V · ${capacidadBatAh}Ah`,
          smallText1: "−",
          smallText2: "+",
          row: p,
          column: s,
        });

        // Enlace serie: pos de anterior → neg del actual
        if (s > 0) {
          linkDataArray.push({
            from: `bat${batCounter - 1}`, fromPort: "pos",
            to: `bat${batCounter}`, toPort: "neg",
            color: "#111111",
          });
        }

        batCounter++;
      }

      // Enlaces en paralelo: unir extremos de cada string
      // negativo con negativo (extremo izquierdo) y positivo con positivo (extremo derecho)
      if (p > 0) {
        const currentRowStart = p * series + 1;
        const previousRowStart = (p - 1) * series + 1;
        const currentRowEnd = currentRowStart + series - 1;
        const previousRowEnd = previousRowStart + series - 1;

        linkDataArray.push({
          from: `bat${previousRowStart}`, fromPort: "neg",
          to: `bat${currentRowStart}`, toPort: "neg",
          color: "#0055cc",
        });

        linkDataArray.push({
          from: `bat${previousRowEnd}`, fromPort: "pos",
          to: `bat${currentRowEnd}`, toPort: "pos",
          color: "#0055cc",
        });
      }
    }

    myDiagram.model = new go.GraphLinksModel(nodeDataArray, linkDataArray);

    myDiagram.layout = $(go.GridLayout, {
      wrappingColumn: series,
      alignment: go.GridLayout.Position,
      cellSize: new go.Size(60, 20),
      spacing: new go.Size(30, 20),
    });

    myDiagram.layoutDiagram();

    const ajustarZoomParaDiagramaGrande = (): void => {
      const bounds = myDiagram.documentBounds;
      const viewport = myDiagram.viewportBounds;
      if (bounds.width <= 0 || bounds.height <= 0 || viewport.width <= 0 || viewport.height <= 0) return;

      const scaleX = viewport.width / bounds.width;
      const scaleY = viewport.height / bounds.height;
      let fitScale = Math.min(scaleX, scaleY, 1) * 0.95;

      // Cuando hay 4 baterías en serie, fuerza un poco más de zoom out para mejorar visibilidad.
      if (series === 4) {
        fitScale = Math.min(fitScale, 0.78);
      }

      const clampedScale = Math.max(myDiagram.minScale, Math.min(myDiagram.maxScale, fitScale));

      myDiagram.scale = clampedScale;
      myDiagram.centerRect(bounds);
    };

    requestAnimationFrame(() => {
      ajustarZoomParaDiagramaGrande();
    });
  }

  // Cargar GoJS dinámicamente
  function loadGoJS(): Promise<void> {
    const w = window as any;

    if (w.go) return Promise.resolve();
    if (w.__gojsLoadingPromise) return w.__gojsLoadingPromise;

    w.__gojsLoadingPromise = new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://unpkg.com/gojs/release/go.js";
      script.onload = () => {
        if (w.go) {
          resolve();
          return;
        }

        reject(new Error("GoJS se cargo sin exponer window.go."));
      };
      script.onerror = () => {
        reject(new Error("No se pudo cargar GoJS desde el CDN."));
      };
      document.head.appendChild(script);
    });

    return w.__gojsLoadingPromise;
  }

  void loadGoJS();
</script>
