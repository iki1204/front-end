---
import Layout from '../../layouts/LayoutCalculadora.astro';
---

<Layout title="Unicom - Off Grid">
  <main class="min-h-screen bg-white">
    <section class="mx-auto grid min-h-screen min-w-screen w-full max-w-[1520px] grid-cols-1 lg:grid-cols-[minmax(340px,30%)_1fr]">
      <aside class="relative hidden lg:flex items-baseline px-[clamp(2.5rem,3.8vw,4rem)] text-white min-h-screen" style="background: radial-gradient(ellipse at top left, #c92a2a 0%, #5a0a0a 60%, #2a0303 100%);">
        <div class="pointer-events-none absolute inset-0 z-0">
          <svg width="100%" height="100%" viewBox="0 0 400 900" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full opacity-40" preserveAspectRatio="xMidYMid slice">
            <defs>
              <radialGradient id="bgGrad" cx="0.3" cy="0.1" r="1">
                <stop offset="0%" stop-color="#c92a2a"/>
                <stop offset="60%" stop-color="#5a0a0a"/>
                <stop offset="100%" stop-color="#2a0303"/>
              </radialGradient>
              <linearGradient id="lineGrad" x1="0" y1="0" x2="400" y2="900" gradientUnits="userSpaceOnUse">
                <stop stop-color="#fff" stop-opacity="0.12"/>
                <stop offset="1" stop-color="#fff" stop-opacity="0.02"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="400" height="900" fill="url(#bgGrad)"/>
            <path d="M20 200 Q200 100 380 220" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <path d="M0 400 Q200 300 400 500" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <path d="M40 700 Q200 850 360 700" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
            <g opacity="0.13">
              <circle cx="350" cy="100" r="80" fill="#fff"/>
              <circle cx="100" cy="800" r="120" fill="#fff"/>
              <circle cx="350" cy="300" r="60" fill="#fff"/>
              <circle cx="60" cy="600" r="40" fill="#fff"/>
            </g>
            <g opacity="0.22">
              <circle cx="40" cy="80" r="3" fill="#fff"/>
              <circle cx="40" cy="160" r="3" fill="#fff"/>
              <circle cx="40" cy="240" r="3" fill="#fff"/>
              <circle cx="40" cy="320" r="3" fill="#fff"/>
              <circle cx="40" cy="400" r="3" fill="#fff"/>
              <circle cx="40" cy="480" r="3" fill="#fff"/>
              <circle cx="40" cy="560" r="3" fill="#fff"/>
              <circle cx="40" cy="640" r="3" fill="#fff"/>
              <circle cx="40" cy="720" r="3" fill="#fff"/>
              <circle cx="40" cy="800" r="3" fill="#fff"/>
              <circle cx="100" cy="120" r="3" fill="#fff"/>
              <circle cx="100" cy="200" r="3" fill="#fff"/>
              <circle cx="100" cy="280" r="3" fill="#fff"/>
              <circle cx="100" cy="360" r="3" fill="#fff"/>
              <circle cx="100" cy="440" r="3" fill="#fff"/>
              <circle cx="100" cy="520" r="3" fill="#fff"/>
              <circle cx="100" cy="600" r="3" fill="#fff"/>
              <circle cx="100" cy="680" r="3" fill="#fff"/>
              <circle cx="100" cy="760" r="3" fill="#fff"/>
              <circle cx="180" cy="80" r="3" fill="#fff"/>
              <circle cx="180" cy="160" r="3" fill="#fff"/>
              <circle cx="180" cy="240" r="3" fill="#fff"/>
              <circle cx="180" cy="320" r="3" fill="#fff"/>
              <circle cx="180" cy="400" r="3" fill="#fff"/>
              <circle cx="180" cy="480" r="3" fill="#fff"/>
              <circle cx="180" cy="560" r="3" fill="#fff"/>
              <circle cx="180" cy="640" r="3" fill="#fff"/>
              <circle cx="180" cy="720" r="3" fill="#fff"/>
              <circle cx="180" cy="800" r="3" fill="#fff"/>
              <circle cx="260" cy="120" r="3" fill="#fff"/>
              <circle cx="260" cy="200" r="3" fill="#fff"/>
              <circle cx="260" cy="280" r="3" fill="#fff"/>
              <circle cx="260" cy="360" r="3" fill="#fff"/>
              <circle cx="260" cy="440" r="3" fill="#fff"/>
              <circle cx="260" cy="520" r="3" fill="#fff"/>
              <circle cx="260" cy="600" r="3" fill="#fff"/>
              <circle cx="260" cy="680" r="3" fill="#fff"/>
              <circle cx="260" cy="760" r="3" fill="#fff"/>
              <circle cx="340" cy="80" r="3" fill="#fff"/>
              <circle cx="340" cy="160" r="3" fill="#fff"/>
              <circle cx="340" cy="240" r="3" fill="#fff"/>
              <circle cx="340" cy="320" r="3" fill="#fff"/>
              <circle cx="340" cy="400" r="3" fill="#fff"/>
              <circle cx="340" cy="480" r="3" fill="#fff"/>
              <circle cx="340" cy="560" r="3" fill="#fff"/>
              <circle cx="340" cy="640" r="3" fill="#fff"/>
              <circle cx="340" cy="720" r="3" fill="#fff"/>
              <circle cx="340" cy="800" r="3" fill="#fff"/>
            </g>
          </svg>
        </div>
        <div class="sticky top-28 lg:top-30 z-10 space-y-8 sm:space-y-10">
          <div class="mb-4 flex justify-start">
            <svg class="h-20 w-20" fill="#ffffff" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 260 244" enable-background="new 0 0 260 244" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M258,54v-8h-25.176c-0.596-3.416-1.941-6.576-3.86-9.307l17.806-17.806l-5.656-5.657l-17.803,17.802 c-2.731-1.926-5.892-3.275-9.311-3.876V2h-8v25.148c-3.433,0.596-6.609,1.947-9.35,3.879L178.87,13.248l-5.656,5.657l17.781,17.78 c-1.922,2.733-3.269,5.896-3.866,9.315H162v8h25.129c0.598,3.428,1.95,6.597,3.88,9.335L173.23,81.112l5.656,5.657l17.783-17.782 c2.737,1.924,5.906,3.271,9.331,3.865V98h8V72.844c3.41-0.599,6.565-1.944,9.292-3.862l17.804,17.805l5.656-5.656l-17.803-17.804 c1.927-2.735,3.276-5.902,3.874-9.326H258z M209.976,34.8c8.382,0,15.2,6.819,15.2,15.2s-6.818,15.2-15.2,15.2 c-8.381,0-15.199-6.819-15.199-15.2S201.595,34.8,209.976,34.8z M80,236v6H43v-6h15v-22h6v22H80z M63.537,82l9.723,38h24.545 l-9.773-38H63.537z M84.518,164h24.603l-9.773-38H74.795L84.518,164z M78.325,164l-9.723-38h-24.52l9.723,38H78.325z M26.632,82H2 l9.772,38h24.582L26.632,82z M67.067,120l-9.723-38H32.825l9.723,38H67.067z M95.776,208h24.661l-9.773-38H86.053L95.776,208z M55.34,170l9.723,38h24.52l-9.723-38H55.34z M37.89,126H13.315l9.772,38h24.525L37.89,126z M24.631,170l9.772,38H58.87l-9.723-38 H24.631z M178.667,190h17.055l6.686,26h-17.089L178.667,190z M163,237v-16h-5v16h-11v5h27v-5H163z M155.259,185l-7.164-28h16.968 l7.164,28H155.259z M146.815,152l-6.652-26h16.968l6.652,26H146.815z M173.506,190l6.652,26H163.19l-6.652-26H173.506z M151.377,190 l6.652,26h-16.834l-6.686-26H151.377z M141.654,152h-16.917l-6.686-26h16.951L141.654,152z M150.098,185h-16.874l-7.201-28h16.911 L150.098,185z M179.264,126l6.686,26h-17.006l-6.652-26H179.264z M170.223,157h17.013l7.201,28h-17.049L170.223,157z M240,238v4h-16 v-4h6v-9h4v9H240z M230.721,210l3.838,15h9.591l-3.838-15H230.721z M248.279,225H258l-3.858-15h-9.702L248.279,225z M217.049,210 l3.858,15h9.524l-3.838-15H217.049z M243.417,206h9.696l-4.115-16h-9.675L243.417,206z M216.358,170h-9.596l4.115,16h9.575 L216.358,170z M234.206,170l4.094,16h9.67l-4.115-16H234.206z M221.475,190h-9.57l4.115,16h9.549L221.475,190z M239.288,206 l-4.094-16h-9.591l4.094,16H239.288z M234.171,186l-4.094-16h-9.591l4.094,16H234.171z"></path> </g></svg>
          </div>
          <h1 class="m-0 text-[clamp(2.2rem,4vw,3.2rem)] leading-[1.05] font-black tracking-[-0.07em] text-balance">
            Simulador de<br />Proyectos<br />Fotovoltaicos<br />
            <span class="text-[#ff5c39]">Off-Grid.</span>
          </h1>
          <h2 class="mt-2 text-[clamp(1.1rem,1.5vw,1.5rem)] font-semibold">Diseña tu autonomía total</h2>
          <div class="w-32 h-1 bg-[#ff5c39] rounded-full mb-10"></div>
          <p class="max-w-[38ch] text-[clamp(1rem,1.2vw,1.35rem)] leading-normal font-medium text-white/90">Calcula el sistema solar ideal para operar sin red eléctrica: paneles, inversor y baterías según tu demanda diaria.</p>
          <div class="mt-8">
            <div class="flex items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/20">
                <svg class="h-6 w-6" fill="#ffffff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.488 21.754c.294.157.663.156.957-.001 8.012-4.304 8.581-12.713 8.574-15.104a.988.988 0 0 0-.596-.903l-8.05-3.566a1.005 1.005 0 0 0-.813.001L3.566 5.747a.99.99 0 0 0-.592.892c-.034 2.379.445 10.806 8.514 15.115zM8.674 10.293l2.293 2.293 4.293-4.293 1.414 1.414-5.707 5.707-3.707-3.707 1.414-1.414z"></path></g></svg>
              </span>
              <span class="text-base font-medium text-white">Energía independiente, libertad sin límites.</span>
            </div>
          </div>
        </div>
      </aside>

      <section class=" w-full rounded-md border border-slate-300 bg-slate-100 shadow-lg">
        <div class="flex items-center gap-4 px-6 py-8">
          <span class="inline-flex h-18 w-18 items-center justify-center rounded-full bg-red-500">
            <svg class="h-12 w-12" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#ffffff" stroke="#ffffff" stroke-width="0.00024000000000000003"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#CCCCCC" stroke-width="0.096"></g><g id="SVGRepo_iconCarrier"><path d="M22,8a2,2,0,0,0-2-2H18V4.8A1.37,1.37,0,0,0,18,4.27a.58.58,0,0,0-.22-.22,1.37,1.37,0,0,0-.53,0H14.8a1.37,1.37,0,0,0-.53,0,.58.58,0,0,0-.22.22A1.37,1.37,0,0,0,14,4.8V6H10V4.8A1.37,1.37,0,0,0,10,4.27a.58.58,0,0,0-.22-.22A1.37,1.37,0,0,0,9.2,4H6.8a1.37,1.37,0,0,0-.53,0,.58.58,0,0,0-.22.22A1.37,1.37,0,0,0,6,4.8V6H4A2,2,0,0,0,2,8V18a2,2,0,0,0,2,2H20a2,2,0,0,0,2-2ZM10.5,14H9v1.5H7V14H5.5V12H7V10.5H9V12h1.5ZM18,14H14V12h4Z" fill-rule="evenodd"></path><rect width="24" height="24" fill="none"></rect></g></svg>
          </span>
          <div>
            <h1 class="m-0 text-[clamp(1.75rem,2.2vw,2.6rem)] font-black leading-tight tracking-[-0.04em] text-slate-900">Selección de Baterías</h1>
            <p class="m-0 mt-1 text-[clamp(0.95rem,1.05vw,1.1rem)] font-medium text-slate-500">Selecciona la batería que mejor se adapte a tus necesidades.</p>
          </div>
        </div>
        <header class="flex items-center justify-between rounded-t-md bg-[#cc2f1f] px-6 py-4 text-white">
          <h2 class="font-mono text-xl tracking-wide">Dimensionamiento de Baterías</h2>
          <svg class="h-6 w-6" viewBox="0 0 24.00 24.00" xmlns="http://www.w3.org/2000/svg" fill="#ffffff" stroke="#ffffff" stroke-width="0.00024000000000000003"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M24,0V24H0V0Z" fill="none"></path> <path d="M20,10V8.33A1.34,1.34,0,0,0,18.67,7H3.34A1.34,1.34,0,0,0,2,8.33v7.33A1.34,1.34,0,0,0,3.33,17H18.67A1.34,1.34,0,0,0,20,15.67V14h2V10Zm-8.5,3v2L4,11H9.5V9L17,13Z"></path> </g></svg>
        </header>

        <div class="border-b border-slate-300 bg-white/70 px-6 py-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Modo de cálculo</p>
          <div
            id="battery-mode-menu"
            class="inline-flex rounded-full border border-slate-300 bg-white p-1 shadow-sm"
            role="tablist"
            aria-label="Modo de cálculo de baterías"
          >
            <button
              type="button"
              class="battery-mode-btn rounded-full bg-[#cc3b26] px-5 py-2 text-sm font-semibold text-white transition"
              data-mode="calculo-baterias"
              aria-pressed="true"
            >
              Cálculo de baterías
            </button>
            <button
              type="button"
              class="battery-mode-btn rounded-full px-5 py-2 text-sm font-semibold text-slate-600 transition hover:text-slate-900"
              data-mode="tiempo-autonomia"
              aria-pressed="false"
            >
              Tiempo de autonomía
            </button>
          </div>
        </div>

        <div id="calculo-baterias-view">
          <div class="px-6 py-7">
            <div class="mb-5 rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
              <p class="mb-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Energía Ajustada del sistema</p>
              <h3 id="energiaAjustada" class="text-3xl font-black text-slate-900">-- Wh</h3>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje del sistema (V)</span>
                <select id="voltajeSistemaAutonomia" disabled class="h-11 w-full rounded border border-slate-400 bg-slate-200 px-3 text-lg text-slate-500 outline-none focus:border-[#cc3b26] disabled:cursor-not-allowed">
                  <option value="12">12 V</option>
                  <option value="24">24 V</option>
                  <option value="48">48 V</option>
                </select>
                <label for="activarVoltajeManualAutonomia" class="mt-3 flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
                  <input id="activarVoltajeManualAutonomia" type="checkbox" class="h-4 w-4 rounded border-slate-400 text-[#cc3b26] focus:ring-[#cc3b26]" />
                  Yo se dimensionar mi sistema
                </label>
                <p id="voltajeRecomendadoInfoAutonomia" class="mt-2 text-xs text-slate-500"></p>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Profundidad de descarga (%)</span>
                <input id="profDescarga" type="number" min="10" max="100" value="80" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]" />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Voltaje de batería (V)</span>
                <select id="voltajeSelect" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="12">12 V</option>
                  <option value="24">24 V</option>
                  <option value="48">48 V</option>
                </select>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-medium text-slate-700">Capacidad de batería (Ah)</span>
                <select id="capacidadSelect" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none focus:border-[#cc3b26]">
                  <option value="100">100 Ah</option>
                  <option value="150">150 Ah</option>
                  <option value="200">200 Ah</option>
                  <option value="250">250 Ah</option>
                </select>
              </label>
            </div>
          </div>

          <!-- Resultados -->
          <div id="resultados" class="hidden border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Resultados</h2>
              <svg fill="#ffffff" class="h-6 w-6" viewBox="-32 0 512 512" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M400 32H48C21.5 32 0 53.5 0 80v352c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V80c0-26.5-21.5-48-48-48zM160 368c0 8.84-7.16 16-16 16h-32c-8.84 0-16-7.16-16-16V240c0-8.84 7.16-16 16-16h32c8.84 0 16 7.16 16 16v128zm96 0c0 8.84-7.16 16-16 16h-32c-8.84 0-16-7.16-16-16V144c0-8.84 7.16-16 16-16h32c8.84 0 16 7.16 16 16v224zm96 0c0 8.84-7.16 16-16 16h-32c-8.84 0-16-7.16-16-16v-64c0-8.84 7.16-16 16-16h32c8.84 0 16 7.16 16 16v64z"></path></g></svg>
            </header>
            <div class="grid grid-cols-2 gap-4 px-6 py-6 sm:grid-cols-4">
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Baterías en serie</p>
                <p id="batteriasSerie" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Baterías en paralelo</p>
                <p id="batteriasParalelo" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Total baterías</p>
                <p id="totalBaterias" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
              <div class="rounded bg-white p-4 shadow-sm text-center">
                <p class="text-xs uppercase tracking-wide text-slate-500">Tiempo de autonomía</p>
                <p id="tiempoAutonomia" class="mt-1 text-3xl font-bold text-[#cc3b26]">--</p>
              </div>
            </div>

            <div class="px-6 pb-6">
              <button
                id="infoBateriaToggle"
                type="button"
                class="inline-flex cursor-pointer items-center rounded-full border border-red-200 bg-white px-3 py-1 text-sm font-semibold text-[#b9301d] transition hover:border-[#cc2f1f] hover:text-[#cc2f1f]"
                aria-expanded="false"
                aria-controls="infoBateriaSistemaWrap"
              >
                + info completa
              </button>

              <div id="infoBateriaSistemaWrap" class="hidden mt-3 rounded-xl border border-red-100 bg-white p-4 shadow-sm">
                <p class="m-0 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Resumen del sistema</p>
                <p id="infoBateriaSistema" class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-700"></p>
              </div>
            </div>
          </div>

          <!-- Diagrama GoJS -->
          <div id="diagramaContainer" class="hidden border-t border-slate-300 bg-slate-100">
            <header class="flex items-center justify-between bg-[#cc2f1f] px-6 py-4 text-white">
              <h2 class="font-mono text-xl tracking-wide">Diagrama de Conexión</h2>
              <svg fill="#000000" class="h-6 w-6" viewBox="0 0 24 24" id="thunder" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path id="primary" d="M18.82,9.18A2,2,0,0,0,17,8H15.19l1.33-3.26a2,2,0,0,0-.19-1.84A2.06,2.06,0,0,0,14.62,2H10.28A2,2,0,0,0,8.37,3.27l-3.23,8a2,2,0,0,0,.2,1.83,2.06,2.06,0,0,0,1.71.9H9.81L8,20.74a1,1,0,0,0,.5,1.15A1.12,1.12,0,0,0,9,22a1,1,0,0,0,.76-.35l8.8-10.37A2,2,0,0,0,18.82,9.18Z" style="fill: #ffffff;"></path></g></svg>
            </header>
            <div class="px-6 py-6">
              <div id="myDiagramDiv" class="w-full rounded border border-slate-300 bg-white" style="height: 480px;"></div>
            </div>
          </div>
        </div>

        <div id="tiempo-autonomia-view" class="hidden border-t border-slate-300 bg-slate-50">
          <div class="px-6 py-7">
