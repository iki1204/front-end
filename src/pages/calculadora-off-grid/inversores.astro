---
import Layout from '../../layouts/LayoutCalculadora.astro';
import { getInvertersData } from "../../lib/api";

type InverterOption = {
  nombre: string;
  potencia: number;
  marca: string;
  tipoInversor: string;
  eficienciaPorcentaje: number;
  voltaje: number;
  pvMaxCurrent: number;
  pvMaxPower: number;
  mpptMin: number;
  mpptMax: number;
  imagen: string;
};

type StrapiMediaItem = {
  url?: string | null;
};

type StrapiMediaField =
  | StrapiMediaItem
  | StrapiMediaItem[]
  | { data?: StrapiMediaItem | StrapiMediaItem[] | null }
  | null
  | undefined;

const STRAPI_BASE_URL = import.meta.env.VITE_STRAPI_URL ?? "https://api.unicomec.com";
const INVERTER_PLACEHOLDER = "/images/placeholder.png";

const resolveInverterImage = (imageField: StrapiMediaField): string => {
  const normalizedField = imageField as {
    data?: StrapiMediaItem | StrapiMediaItem[] | null;
    url?: string | null;
  } | null | undefined;

  const candidateUrl = Array.isArray(imageField)
    ? imageField[0]?.url
    : Array.isArray(normalizedField?.data)
      ? normalizedField.data[0]?.url
      : normalizedField?.data && !Array.isArray(normalizedField.data)
        ? normalizedField.data.url
        : normalizedField?.url;

  if (!candidateUrl) return INVERTER_PLACEHOLDER;
  return candidateUrl.startsWith("http") ? candidateUrl : `${STRAPI_BASE_URL}${candidateUrl}`;
};

const ordenarInversoresPorPotencia = (inversores: InverterOption[]): InverterOption[] => {
  return [...inversores].sort((a, b) => a.potencia - b.potencia);
};

const opcionesInversores: InverterOption[] = await getInvertersData().then((response) => {
  if (response?.data) {
    const inversoresMapeados = response.data.map((item: any): InverterOption => ({
      potencia: Number(item.potencia ?? 0),
      nombre: String(item.nombre ?? "--"),
      marca: String(item.marca ?? "--"),
      tipoInversor: String(item.tipoInversor ?? "--"),
      eficienciaPorcentaje: Number(item.eficienciaPorcentaje ?? 0),
      voltaje: Number(item.voltaje ?? 0),
      pvMaxCurrent: Number(item.pvMaxCurrent ?? 0),
      pvMaxPower: Number(item.pvMaxPower ?? 0),
      mpptMin: Number(item.mpptMin ?? 0),
      mpptMax: Number(item.mpptMax ?? 0),
      imagen: resolveInverterImage(item.imagen),
    }));

    return ordenarInversoresPorPotencia(inversoresMapeados);
  }

  return [];
}).catch((error) => {
  console.error("Error al obtener los datos de los inversores:", error);
  return [];
});

const inverterInicial: InverterOption = opcionesInversores[0] ?? {
  potencia: 0,
  nombre: "Sin inversores disponibles",
  marca: "--",
  tipoInversor: "--",
  eficienciaPorcentaje: 0,
  voltaje: 0,
  pvMaxCurrent: 0,
  pvMaxPower: 0,
  mpptMin: 0,
  mpptMax: 0,
  imagen: INVERTER_PLACEHOLDER,
};

