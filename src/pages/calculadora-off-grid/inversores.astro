<script>
  import { registerNavigationPreloader } from "../../lib/navigationPreloader";

    type ConsumoStorage = {
      inversorPotencia?: number;
      inversorModelo?: string;
      inversorEficiencia?: string;
      inversorMarca?: string;
      inversorTipo?: string;
      inversorEficienciaPorcentaje?: number;
    };

    type InverterEmptyStateConfig = {
      title: string;
      message: string;
      detail?: string;
    };

    const CONSUMO_STORAGE_KEY = "unicom.offgrid.consumos";
    const INVERTER_PLACEHOLDER_CLIENT = "/images/placeholder.png";
    const MAX_INVERTER_POWER = 12000;

    let dots: HTMLButtonElement[] = [];
    let scrollToResumenButtonEl: HTMLButtonElement | null = null;
    let inverterPrevEl: HTMLButtonElement | null = null;
    let inverterNextEl: HTMLButtonElement | null = null;
    let inverterEmptyStateEl: HTMLElement | null = null;
    let inverterCarouselStateEl: HTMLElement | null = null;
    let inverterEmptyTitleEl: HTMLElement | null = null;
    let inverterEmptyMessageEl: HTMLElement | null = null;
    let inverterEmptyDetailEl: HTMLElement | null = null;
    let carouselInverterPotenciaEl: HTMLElement | null = null;
    let carouselInverterModeloEl: HTMLElement | null = null;
    let carouselInverterMarcaEl: HTMLElement | null = null;
    let carouselInverterTipoEl: HTMLElement | null = null;
    let carouselInverterImageEl: HTMLImageElement | null = null;
    let carouselInverterLoaderEl: HTMLElement | null = null;
    let carouselInverterEficienciaEl: HTMLElement | null = null;
    let carouselInverterVoltajeEl: HTMLElement | null = null;
    let carouselInverterPvCurrentEl: HTMLElement | null = null;
    let carouselInverterPvPowerEl: HTMLElement | null = null;
    let carouselInverterMpptEl: HTMLElement | null = null;
    let resumenConsumoKwhEl: HTMLElement | null = null;
    let resumenConsumoMesEl: HTMLElement | null = null;
    let resumenPanelesTipoEl: HTMLElement | null = null;
    let resumenPanelesCantidadEl: HTMLElement | null = null;
    let resumenPanelesPotenciaEl: HTMLElement | null = null;
    let resumenBateriasCantidadEl: HTMLElement | null = null;
    let resumenBateriasCapacidadEl: HTMLElement | null = null;

    let inversorPotencia = 0;
    let inversorModelo = "";
    let inversorMarca = "";
    let inversorTipo = "";
    let inversorEficiencia = "";
    let indiceInverterActivo = 0;
    let imageLoadRequestId = 0;
    let direccionCarrusel: 1 | -1 = 1;

    const guardarDatos = (
      potencia: number,
      modelo: string,
      eficiencia: string,
      marca: string,
      tipo: string,
      eficienciaPorcentaje: number,
    ): void => {
      try {
        const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
        const consumoActual = consumoGuardado
          ? JSON.parse(consumoGuardado) as ConsumoStorage
          : {};

        const consumoActualizado: ConsumoStorage = {
          ...consumoActual,
          inversorPotencia: potencia,
          inversorModelo: modelo,
          inversorEficiencia: eficiencia,
          inversorMarca: marca,
          inversorTipo: tipo,
          inversorEficienciaPorcentaje: eficienciaPorcentaje,
        };

        window.localStorage.setItem(CONSUMO_STORAGE_KEY, JSON.stringify(consumoActualizado));
      } catch (error) {
        console.error("No se pudo guardar el inversor en localStorage.", error);
      }
    };

    const cargarDatosLocalStorage = (): void => {
      try {
        const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
        if (!consumoGuardado) {
          console.warn("No hay datos guardados en localStorage");
          return;
        }

        const datos = JSON.parse(consumoGuardado) as any;
        const totalEnergiaConsumoLoss = Number(datos.totalEnergiaConsumoLoss) || 0;
        const panelesSolares = Number(datos.panelesSolares) || 0;
        const panelVatios = Number(datos.panelVatios) || 0;
        const totalBaterias = Number(datos.bateriaConfiguracion?.calculoBaterias?.totalBaterias) || 0;
        const capacidadBancoAh = Number(datos.bateriaConfiguracion?.calculoBaterias?.capacidadBancoAh) || 0;

        // Actualizar consumo (convertir Wh a kWh para mes/día)
        const consumoMesKwh = (totalEnergiaConsumoLoss * 30) / 1000; // Wh * 30 días / 1000
        if (resumenConsumoKwhEl) {
          resumenConsumoKwhEl.textContent = `${Number.isInteger(totalEnergiaConsumoLoss) ? totalEnergiaConsumoLoss : totalEnergiaConsumoLoss.toFixed(2)} Wh`;
        }
        if (resumenConsumoMesEl) {
          resumenConsumoMesEl.textContent = `${Number.isInteger(consumoMesKwh) ? consumoMesKwh : consumoMesKwh.toFixed(2)} kWh/mes`;
        }

        // Actualizar paneles
        const potenciaTotal = (panelesSolares * panelVatios) / 1000; // W a kW
        if (resumenPanelesTipoEl) {
          resumenPanelesTipoEl.textContent = panelVatios > 0
            ? `Paneles solares de ${panelVatios} W`
            : "Paneles solares de -- W";
        }
        if (resumenPanelesCantidadEl) {
          resumenPanelesCantidadEl.textContent = panelesSolares > 0 ? String(panelesSolares) : "--";
        }
        if (resumenPanelesPotenciaEl) {
          resumenPanelesPotenciaEl.textContent = panelesSolares > 0 
            ? `${Number.isInteger(potenciaTotal) ? potenciaTotal : potenciaTotal.toFixed(2)} kWp`
            : "-- kWp";
        }

        // Actualizar baterías
        if (resumenBateriasCantidadEl) {
          resumenBateriasCantidadEl.textContent = totalBaterias > 0 ? String(totalBaterias) : "--";
        }
        if (resumenBateriasCapacidadEl) {
          resumenBateriasCapacidadEl.textContent = capacidadBancoAh > 0
            ? `${Number.isInteger(capacidadBancoAh) ? capacidadBancoAh : capacidadBancoAh.toFixed(2)} Ah`
            : "-- Ah";
        }
      } catch (error) {
        console.error("Error al cargar datos del resumen desde localStorage:", error);
      }
    };

    const sincronizarElementos = (): void => {
      dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".inverter-dot"));
      scrollToResumenButtonEl = document.querySelector<HTMLButtonElement>("#scroll-to-resumen-button");
      inverterPrevEl = document.querySelector<HTMLButtonElement>("#inverter-prev");
      inverterNextEl = document.querySelector<HTMLButtonElement>("#inverter-next");
      inverterEmptyStateEl = document.getElementById("inverter-empty-state");
      inverterCarouselStateEl = document.getElementById("inverter-carousel-state");
      inverterEmptyTitleEl = document.getElementById("inverter-empty-title");
      inverterEmptyMessageEl = document.getElementById("inverter-empty-message");
      inverterEmptyDetailEl = document.getElementById("inverter-empty-detail");
      carouselInverterPotenciaEl = document.getElementById("carousel-inverter-potencia");
      carouselInverterModeloEl = document.getElementById("carousel-inverter-modelo");
      carouselInverterMarcaEl = document.getElementById("carousel-inverter-marca");
      carouselInverterTipoEl = document.getElementById("carousel-inverter-tipo");
      carouselInverterImageEl = document.querySelector<HTMLImageElement>("#carousel-inverter-image");
      carouselInverterLoaderEl = document.getElementById("carousel-inverter-loader");
      carouselInverterEficienciaEl = document.getElementById("carousel-inverter-eficiencia");
      carouselInverterVoltajeEl = document.getElementById("carousel-inverter-voltaje");
      carouselInverterPvCurrentEl = document.getElementById("carousel-inverter-pv-current");
      carouselInverterPvPowerEl = document.getElementById("carousel-inverter-pv-power");
      carouselInverterMpptEl = document.getElementById("carousel-inverter-mppt");
      resumenConsumoKwhEl = document.getElementById("resumen-consumo-kwh");
      resumenConsumoMesEl = document.getElementById("resumen-consumo-mes");
      resumenPanelesTipoEl = document.getElementById("resumen-paneles-tipo");
      resumenPanelesCantidadEl = document.getElementById("resumen-paneles-cantidad");
      resumenPanelesPotenciaEl = document.getElementById("resumen-paneles-potencia");
      resumenBateriasCantidadEl = document.getElementById("resumen-baterias-cantidad");
      resumenBateriasCapacidadEl = document.getElementById("resumen-baterias-capacidad");
    };

    const actualizarCarrusel = (): void => {
      if (dots.length === 0) return;

      dots.forEach((dot, index) => {
        const isActive = index === indiceInverterActivo;
        dot.classList.toggle("bg-amber-300", isActive);
        dot.classList.toggle("scale-125", isActive);
        dot.classList.toggle("bg-white/35", !isActive);
        dot.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      if (inverterPrevEl) inverterPrevEl.disabled = indiceInverterActivo === 0;
      if (inverterNextEl) inverterNextEl.disabled = indiceInverterActivo === dots.length - 1;
    };

    const actualizarEstadoPreloader = (cargando: boolean): void => {
      if (carouselInverterLoaderEl) {
        carouselInverterLoaderEl.classList.toggle("hidden", !cargando);
      }

      if (carouselInverterImageEl) {
        carouselInverterImageEl.classList.toggle("opacity-0", cargando);
        carouselInverterImageEl.classList.toggle("opacity-100", !cargando);
      }
    };

    const animarEntradaImagen = (): void => {
      if (!carouselInverterImageEl) return;

      const offset = direccionCarrusel === 1 ? 16 : -16;

      carouselInverterImageEl.animate(
        [
          { opacity: 0.35, transform: `translateX(${offset}px) scale(0.985)` },
          { opacity: 1, transform: "translateX(0) scale(1)" },
        ],
        {
          duration: 380,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "both",
        },
      );
    };

    const actualizarImagenCarrusel = (imagen: string): void => {
      if (!carouselInverterImageEl) return;

      const imageUrl = imagen?.trim() ? imagen : INVERTER_PLACEHOLDER_CLIENT;
      const currentImage = carouselInverterImageEl.dataset.currentSrc || "";

      if (currentImage === imageUrl && carouselInverterImageEl.complete && carouselInverterImageEl.naturalWidth > 0) {
        actualizarEstadoPreloader(false);
        return;
      }

      imageLoadRequestId += 1;
      const requestId = imageLoadRequestId;
      const preloadedImage = new Image();

      actualizarEstadoPreloader(true);

      preloadedImage.onload = () => {
        if (!carouselInverterImageEl || requestId !== imageLoadRequestId) return;
        carouselInverterImageEl.src = imageUrl;
        carouselInverterImageEl.dataset.currentSrc = imageUrl;
        actualizarEstadoPreloader(false);
        animarEntradaImagen();
      };

      preloadedImage.onerror = () => {
        if (!carouselInverterImageEl || requestId !== imageLoadRequestId) return;
        carouselInverterImageEl.dataset.currentSrc = INVERTER_PLACEHOLDER_CLIENT;
        actualizarEstadoPreloader(false);
      };

      preloadedImage.src = imageUrl;
    };

    const updateSelection = (dot: HTMLButtonElement): void => {
      const siguienteIndice = Number(dot.dataset.index || 0);
      direccionCarrusel = siguienteIndice >= indiceInverterActivo ? 1 : -1;
      indiceInverterActivo = siguienteIndice;
      inversorPotencia = Number(dot.dataset.potencia || 0);
      inversorModelo = dot.dataset.modelo || dot.dataset.nombre || "Inversor";
      inversorMarca = dot.dataset.marca || "--";
      inversorTipo = dot.dataset.tipoInversor || "--";
      const eficienciaPorcentaje = Number(dot.dataset.eficienciaPorcentaje || 0);
      inversorEficiencia = Number.isFinite(eficienciaPorcentaje) && eficienciaPorcentaje > 0
        ? `${eficienciaPorcentaje}%`
        : "N/D";

      const voltaje = Number(dot.dataset.voltaje || 0);
      const pvMaxCurrent = Number(dot.dataset.pvMaxCurrent || 0);
      const pvMaxPower = Number(dot.dataset.pvMaxPower || 0);
      const mpptMin = Number(dot.dataset.mpptMin || 0);
      const mpptMax = Number(dot.dataset.mpptMax || 0);
      const imagenInversor = dot.dataset.imagen || INVERTER_PLACEHOLDER_CLIENT;

      if (carouselInverterPotenciaEl) carouselInverterPotenciaEl.textContent = `${inversorPotencia}W`;
      if (carouselInverterModeloEl) carouselInverterModeloEl.textContent = inversorModelo;
      if (carouselInverterMarcaEl) carouselInverterMarcaEl.textContent = `Marca: ${inversorMarca}`;
      if (carouselInverterTipoEl) carouselInverterTipoEl.textContent = inversorTipo;
      if (carouselInverterEficienciaEl) carouselInverterEficienciaEl.textContent = inversorEficiencia;
      if (carouselInverterVoltajeEl) carouselInverterVoltajeEl.textContent = `${voltaje}V`;
      if (carouselInverterPvCurrentEl) carouselInverterPvCurrentEl.textContent = `${pvMaxCurrent}A`;
      if (carouselInverterPvPowerEl) carouselInverterPvPowerEl.textContent = `${pvMaxPower}W`;
      if (carouselInverterMpptEl) carouselInverterMpptEl.textContent = `${mpptMin}V - ${mpptMax}V`;
      actualizarImagenCarrusel(imagenInversor);
      actualizarCarrusel();
      guardarDatos(inversorPotencia, inversorModelo, inversorEficiencia, inversorMarca, inversorTipo, eficienciaPorcentaje);
    };

    const registrarEventos = (): void => {
      dots.forEach((dot) => {
        if (dot.dataset.listenerBound === "1") return;
        dot.addEventListener("click", () => updateSelection(dot));
        dot.dataset.listenerBound = "1";
      });

      if (inverterPrevEl && inverterPrevEl.dataset.listenerBound !== "1") {
        inverterPrevEl.addEventListener("click", () => {
          if (indiceInverterActivo <= 0) return;
          const siguienteDot = dots[indiceInverterActivo - 1];
          if (siguienteDot) updateSelection(siguienteDot);
        });
        inverterPrevEl.dataset.listenerBound = "1";
      }

      if (inverterNextEl && inverterNextEl.dataset.listenerBound !== "1") {
        inverterNextEl.addEventListener("click", () => {
          if (indiceInverterActivo >= dots.length - 1) return;
          const siguienteDot = dots[indiceInverterActivo + 1];
          if (siguienteDot) updateSelection(siguienteDot);
        });
        inverterNextEl.dataset.listenerBound = "1";
      }

      if (scrollToResumenButtonEl && scrollToResumenButtonEl.dataset.listenerBound !== "1") {
        scrollToResumenButtonEl.addEventListener("click", () => {
          const resumenHeading = document.querySelector<HTMLHeadingElement>("h2.text-2xl.font-bold.text-slate-800");
          if (resumenHeading) {
            resumenHeading.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
        scrollToResumenButtonEl.dataset.listenerBound = "1";
      }
    };

    const calcularPotenciaInversorRequerida = (totalEnergiaLoss: number): number => {
        console.log("Calculando potencia requerida para el inversor con totalEnergiaLoss:", totalEnergiaLoss);
      switch (true) {
        case totalEnergiaLoss <= 292:
          return 350;
        case totalEnergiaLoss <= 417:
          return 500;
        case totalEnergiaLoss <= 833:
          return 1000;
        case totalEnergiaLoss <= 1667:
          return 2000;
        case totalEnergiaLoss <= 2500:
          return 3000;
        case totalEnergiaLoss <= 4166:
          return 5000;
        case totalEnergiaLoss <= 5000:
          return 6000;
        case totalEnergiaLoss <= 8333:
          return 10000;
        case totalEnergiaLoss <= 9600:
          return 12000;
        default:
          return 12001;
      }
    };

    const obtenerPotenciaInversorRequerida = (): number | null => {
      try {
        const consumoGuardado = window.localStorage.getItem(CONSUMO_STORAGE_KEY);
        if (!consumoGuardado) return null;

        const datos = JSON.parse(consumoGuardado) as { totalEnergiaLoss?: number };
        const totalEnergiaLoss = Number(datos.totalEnergiaLoss) || 0;
        return calcularPotenciaInversorRequerida(totalEnergiaLoss);
      } catch (error) {
        console.error("Error al obtener la potencia requerida del inversor.", error);
        return null;
      }
    };

    const filtrarCarruselPorNecesidad = (): number | null => {
      const potenciaRequerida = obtenerPotenciaInversorRequerida();
      if (potenciaRequerida === null) return null;

      const todosLosDots = Array.from(document.querySelectorAll<HTMLButtonElement>(".inverter-dot"));
      const potenciasOrdenadas = Array.from(new Set(
        todosLosDots
          .map((dot) => Number(dot.dataset.potencia || 0))
          .filter((potencia) => Number.isFinite(potencia) && potencia > 0),
      )).sort((a, b) => a - b);

      const indiceBase = potenciasOrdenadas.findIndex((potencia) => potencia >= potenciaRequerida);
      const potenciasRecomendadas = new Set<number>();

      if (indiceBase !== -1) {
        potenciasRecomendadas.add(potenciasOrdenadas[indiceBase]);
        const siguientePotencia = potenciasOrdenadas[indiceBase + 1];
        if (typeof siguientePotencia === "number") {
          potenciasRecomendadas.add(siguientePotencia);
        }
      }

      const dotsFiltrados = todosLosDots.filter(
        (dot) => potenciasRecomendadas.has(Number(dot.dataset.potencia || 0)),
      );
      const visibles = new Set(dotsFiltrados);

      todosLosDots.forEach((dot) => {
        const mostrar = visibles.has(dot);
        dot.classList.toggle("hidden", !mostrar);
        dot.disabled = !mostrar;
        dot.setAttribute("aria-hidden", mostrar ? "false" : "true");
        if (!mostrar) {
          dot.setAttribute("aria-pressed", "false");
        }
      });

      dots = dotsFiltrados;
      dots.forEach((dot, index) => {
        dot.dataset.index = String(index);
      });

      return potenciaRequerida;
    };

    const mostrarEstadoGenericoInversor = ({ title, message, detail }: InverterEmptyStateConfig): void => {
      if (inverterCarouselStateEl) inverterCarouselStateEl.classList.add("hidden");
      if (inverterEmptyStateEl) inverterEmptyStateEl.classList.remove("hidden");
      if (inverterEmptyTitleEl) inverterEmptyTitleEl.textContent = title;
      if (inverterEmptyMessageEl) inverterEmptyMessageEl.textContent = message;
      if (inverterEmptyDetailEl) {
        if (detail?.trim()) {
          inverterEmptyDetailEl.textContent = detail;
          inverterEmptyDetailEl.classList.remove("hidden");
        } else {
          inverterEmptyDetailEl.classList.add("hidden");
        }
      }
      if (inverterPrevEl) inverterPrevEl.disabled = true;
      if (inverterNextEl) inverterNextEl.disabled = true;
    };

    const mostrarVistaCarrusel = (): void => {
      if (inverterCarouselStateEl) inverterCarouselStateEl.classList.remove("hidden");
      if (inverterEmptyStateEl) inverterEmptyStateEl.classList.add("hidden");
    };

    const calcularInversorRecomendado = (): HTMLButtonElement | null => {
      try {
        const inversorReal = obtenerPotenciaInversorRequerida();
        if (inversorReal === null) return null;

        const matchExacto = dots.find((dot) => Number(dot.dataset.potencia || 0) === inversorReal);
        if (matchExacto) return matchExacto;

        const dotsOrdenados = [...dots].sort(
          (a, b) => Number(a.dataset.potencia || 0) - Number(b.dataset.potencia || 0),
        );

        const matchSuperior = dotsOrdenados.find((dot) => Number(dot.dataset.potencia || 0) >= inversorReal);
        return matchSuperior ?? dotsOrdenados[dotsOrdenados.length - 1] ?? null;
      } catch (error) {
        console.error("Error al calcular el inversor recomendado.", error);
        return null;
      }
    };

    const inicializarPaginaInversores = (): void => {
      sincronizarElementos();
      mostrarVistaCarrusel();

      if (dots.length === 0) {
        mostrarEstadoGenericoInversor({
          title: "No hay inversores disponibles",
          message: "No hay inversores cargados en este momento",
          detail: "Intenta nuevamente en unos minutos o contáctanos para ayudarte con una opción personalizada.",
        });
        return;
      }

      const potenciaRequerida = filtrarCarruselPorNecesidad();

      registrarEventos();
      registerNavigationPreloader();
      cargarDatosLocalStorage();

      if (dots.length === 0) {
        if ((potenciaRequerida ?? 0) > MAX_INVERTER_POWER) {
          mostrarEstadoGenericoInversor({
            title: "Potencia fuera de rango",
            message: "losiento, no tenemos un inversor para ti",
            detail: `Tu consumo requiere una potencia superior a ${MAX_INVERTER_POWER}W. Escríbenos para ayudarte con una solución personalizada.`,
          });
        } else {
          mostrarEstadoGenericoInversor({
            title: "Sin coincidencias",
            message: "No hay inversores disponibles para esta necesidad",
          });
        }
        return;
      }

      const dotRecomendado = calcularInversorRecomendado();
      const dotSeleccionado = dotRecomendado ?? dots.find((dot) => dot.getAttribute("aria-pressed") === "true") ?? dots[0];
      if (dotSeleccionado) {
        updateSelection(dotSeleccionado);
      }
    };

    document.addEventListener("astro:page-load", inicializarPaginaInversores);
    window.addEventListener("pageshow", inicializarPaginaInversores);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", inicializarPaginaInversores, { once: true });
    } else {
      inicializarPaginaInversores();
    }
  </script>
