            <button id="btn-calcular" type="button" class="h-11 cursor-pointer flex gap-1 items-center justify-center rounded bg-[#cc3b26] px-8 text-lg font-semibold text-white transition hover:bg-[#b9301d]">
              <svg class="h-6 w-6 inline-flex" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M5 9H19M15 18V15M9 18H9.01M12 18H12.01M12 15H12.01M9 15H9.01M15 12H15.01M12 12H12.01M9 12H9.01M8.2 21H15.8C16.9201 21 17.4802 21 17.908 20.782C18.2843 20.5903 18.5903 20.2843 18.782 19.908C19 19.4802 19 18.9201 19 17.8V6.2C19 5.0799 19 4.51984 18.782 4.09202C18.5903 3.71569 18.2843 3.40973 17.908 3.21799C17.4802 3 16.9201 3 15.8 3H8.2C7.0799 3 6.51984 3 6.09202 3.21799C5.71569 3.40973 5.40973 3.71569 5.21799 4.09202C5 4.51984 5 5.07989 5 6.2V17.8C5 18.9201 5 19.4802 5.21799 19.908C5.40973 20.2843 5.71569 20.5903 6.09202 20.782C6.51984 21 7.07989 21 8.2 21Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
              Calcular
            </button>
          </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-3 md:p-0">
          <div class="hidden md:grid grid-cols-6 border-b border-slate-200 px-2 py-3 text-lg text-slate-800">
            <span class="px-2">Objeto</span>
            <span class="px-2">Cantidad</span>
            <span class="px-2">Potencia</span>
            <span class="px-2">Horas</span>
