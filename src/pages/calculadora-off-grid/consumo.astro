                  </div>
                  <span class="hidden text-xl text-slate-400 sm:inline">=</span>
                  <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center">
                    <p class="m-0 text-xs font-semibold uppercase tracking-wide text-red-500">Consumo diario</p>
                    <p class="m-0 mt-1 text-2xl font-black text-red-600">1.20 kWh</p>
                  </div>
                  <button type="button" class="inline-flex h-11 items-center justify-center rounded-lg bg-red-600 px-4 text-base font-semibold text-white transition hover:bg-red-700">Calcular</button>
