            <span class="px-2">Acciones</span>
          </div>

          <div id="tabla-consumos" class="space-y-3 md:space-y-0 md:divide-y md:divide-slate-200"></div>
        </div>

        <div class="space-y-5 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
          <div class="flex items-center gap-3 border-b border-slate-200 pb-4">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-red-50">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5 18V10" stroke="#d12a2a" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M10 18V6" stroke="#d12a2a" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M15 18V12" stroke="#d12a2a" stroke-width="2.2" stroke-linecap="round"/>
                <path d="M20 18V4" stroke="#d12a2a" stroke-width="2.2" stroke-linecap="round"/>
              </svg>
            </span>
            <h2 class="text-[clamp(1.5rem,2.2vw,2rem)] font-semibold text-slate-800">Consumo diario de energía</h2>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-2xl border border-slate-200 bg-[#fcfcfd] p-4 sm:p-5">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-red-50">
                  <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M13 2L5 14H11L10 22L19 9H13L13 2Z" fill="#d12a2a"/>
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-[clamp(1.25rem,1.6vw,1.8rem)] text-slate-600">Potencia total requerida</p>
                  <p id="total-potencia" class="text-[clamp(2.3rem,4vw,3.6rem)] font-bold leading-none text-[#d12a2a]">0 W</p>
                </div>
              </div>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-[#fcfcfd] p-4 sm:p-5">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-[#fff5e8]">
                  <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="6" y="3" width="12" height="18" rx="2" stroke="#ef8a10" stroke-width="2"/>
                    <path d="M12.5 7L9.5 12H12L11.5 16L14.5 11H12L12.5 7Z" fill="#ef8a10"/>
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-[clamp(1.25rem,1.6vw,1.8rem)] text-slate-600">Energía total por día</p>
                  <p id="total-wh" class="text-[clamp(2.3rem,4vw,3.6rem)] font-bold leading-none text-[#ef8a10]">0 Wh</p>
