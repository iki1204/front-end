</main>

</Layout>

  <script>
    import { registerNavigationPreloader } from "../../lib/navigationPreloader";
    import { PrettyModal } from "../../lib/prettyModal";

    type Electrodomestico = {
      id?: string;
      nombre: string;
      potencia: number;
      categoria?: string;
    };

    type RegistroConsumo = {
      id: number;
      equipo: string;
      cantidad: number;
      potencia: number;
      horas: number;
      esInversor?: boolean;
    };

    type CampoEditable = "cantidad" | "potencia" | "horas";
    type BorradorEdicion = Pick<RegistroConsumo, CampoEditable>;
    type ConsumoStorage = {
      registrosPorId: Record<string, RegistroConsumo>;
      contadorRegistros: number;
      totalEnergia: number;
      totalEnergiaConsumo: number;
    };

    const STORAGE_KEY = "unicom.offgrid.consumos";

    let equipoEl: HTMLSelectElement | null = null;
    let cantidadEl: HTMLInputElement | null = null;
    let potenciaEl: HTMLInputElement | null = null;
    let horasEl: HTMLInputElement | null = null;
    let btnCalcularEl: HTMLButtonElement | null = null;
    let tablaConsumosEl: HTMLDivElement | null = null;
    let totalEnergiaEl: HTMLElement | null = null;
    let totalEnergiaConsumoEl: HTMLElement | null = null;
    let agregarInversorEl: HTMLInputElement | null = null;
    let helpTriggerEl: HTMLButtonElement | null = null;
    let helpCloseEl: HTMLButtonElement | null = null;
    let helpUnderstoodEl: HTMLButtonElement | null = null;
    let helpDialogEl: HTMLDialogElement | null = null;
    const prettyModal = new PrettyModal();

    const sincronizarElementosDom = (): void => {
      equipoEl = document.querySelector<HTMLSelectElement>("#equipo");
      cantidadEl = document.querySelector<HTMLInputElement>("#cantidad");
      potenciaEl = document.querySelector<HTMLInputElement>("#potencia");
      horasEl = document.querySelector<HTMLInputElement>("#horas");
      btnCalcularEl = document.querySelector<HTMLButtonElement>("#btn-calcular");
      tablaConsumosEl = document.querySelector<HTMLDivElement>("#tabla-consumos");
      totalEnergiaEl = document.querySelector<HTMLElement>("#total-potencia");
      totalEnergiaConsumoEl = document.querySelector<HTMLElement>("#total-wh");
      agregarInversorEl = document.querySelector<HTMLInputElement>("#agregar-inversor");
      helpTriggerEl = document.querySelector<HTMLButtonElement>("#help-consumo-trigger");
      helpCloseEl = document.querySelector<HTMLButtonElement>("#help-consumo-close");
      helpUnderstoodEl = document.querySelector<HTMLButtonElement>("#help-consumo-understood");
      helpDialogEl = document.querySelector<HTMLDialogElement>("#help-consumo-dialog");
    };

    const esPaginaConsumoActiva = (): boolean => {
      return equipoEl instanceof HTMLSelectElement
        && cantidadEl instanceof HTMLInputElement
        && potenciaEl instanceof HTMLInputElement
        && horasEl instanceof HTMLInputElement
        && btnCalcularEl instanceof HTMLButtonElement
        && tablaConsumosEl instanceof HTMLDivElement
        && agregarInversorEl instanceof HTMLInputElement;
    };

    let electrodomesticos: Electrodomestico[] = [];
    let registros: RegistroConsumo[] = [];
    let registroEnEdicionId: number | null = null;
    let borradorEdicion: BorradorEdicion | null = null;
    let contadorRegistros = 0;
    let totalEnergiaGuardada = 0;
    let totalEnergiaConsumoGuardada = 0;

    const crearRegistroInversor = (): RegistroConsumo => ({
      id: -1,
      equipo: "Consumo Inversor",
      cantidad: 1,
      potencia: 100,
      horas: 5,
      esInversor: true
    });

    const sincronizarRegistroInversor = (): void => {
      if (!(agregarInversorEl instanceof HTMLInputElement)) return;

      const incluirInversor = agregarInversorEl.checked;
      const inversorActual = registros.find((item) => item.esInversor);

      if (incluirInversor && !inversorActual) {
        registros.unshift(crearRegistroInversor());
      }

      if (!incluirInversor && inversorActual) {
        registros = registros.filter((item) => !item.esInversor);
        if (registroEnEdicionId === inversorActual.id) {
          registroEnEdicionId = null;
          borradorEdicion = null;
        }
      }
    };

    const esCampoEditable = (campo: string): campo is CampoEditable => {
      return ["cantidad", "potencia", "horas"].includes(campo);
    };

    const formatearNumero = (valor: number): string => Number.isInteger(valor) ? `${valor}` : valor.toFixed(2);

    const limpiarFormulario = (): void => {
      if (cantidadEl instanceof HTMLInputElement) cantidadEl.value = "1";
      if (horasEl instanceof HTMLInputElement) horasEl.value = "";
      if (registroEnEdicionId === null && potenciaEl instanceof HTMLInputElement) {
        actualizarPotenciaPorEquipo();
      }
    };

    const escapeHtml = (texto: string): string => texto
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    const esRegistroConsumoValido = (valor: unknown): valor is RegistroConsumo => {
      if (!valor || typeof valor !== "object") return false;

      const registro = valor as Partial<RegistroConsumo>;
      return typeof registro.id === "number"
        && typeof registro.equipo === "string"
        && typeof registro.cantidad === "number"
        && typeof registro.potencia === "number"
        && typeof registro.horas === "number";
    };

    const guardarRegistrosEnStorage = (): void => {
      const registrosPorId = registros.reduce<Record<string, RegistroConsumo>>((acumulador, registro) => {
        acumulador[String(registro.id)] = registro;
        return acumulador;
      }, {});

      const totalEnergia = registros.reduce((acumulado, registro) => acumulado + (registro.cantidad * registro.potencia), 0);
      const totalEnergiaConsumo = registros.reduce((acumulado, registro) => acumulado + (registro.cantidad * registro.potencia * registro.horas), 0);

      totalEnergiaGuardada = totalEnergia;
      totalEnergiaConsumoGuardada = totalEnergiaConsumo;

      const payload: ConsumoStorage = {
        registrosPorId,
        contadorRegistros,
        totalEnergia,
        totalEnergiaConsumo
      };

      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (error) {
        console.error("No se pudieron guardar los consumos en localStorage.", error);
      }
    };

    const cargarRegistrosDesdeStorage = (): void => {
      try {
        const guardado = window.localStorage.getItem(STORAGE_KEY);
        if (!guardado) return;

        const datos = JSON.parse(guardado) as Partial<ConsumoStorage>;
        const registrosGuardados = datos.registrosPorId && typeof datos.registrosPorId === "object"
          ? Object.values(datos.registrosPorId).filter(esRegistroConsumoValido).sort((a, b) => a.id - b.id)
          : [];

        registros = registrosGuardados;
        contadorRegistros = typeof datos.contadorRegistros === "number"
          ? datos.contadorRegistros
          : registrosGuardados.reduce((maximo, registro) => Math.max(maximo, registro.id), 0);
        totalEnergiaGuardada = typeof datos.totalEnergia === "number" ? datos.totalEnergia : 0;
        totalEnergiaConsumoGuardada = typeof datos.totalEnergiaConsumo === "number" ? datos.totalEnergiaConsumo : 0;
        registroEnEdicionId = null;
        borradorEdicion = null;

        renderTabla();
        actualizarTotales();
      } catch (error) {
        console.error("No se pudieron recuperar los consumos guardados.", error);
      }
    };

    const inicializarConsumosGuardados = (): void => {
      const guardado = window.localStorage.getItem(STORAGE_KEY);

      if (guardado) {
        cargarRegistrosDesdeStorage();
        if (agregarInversorEl instanceof HTMLInputElement) {
          agregarInversorEl.checked = false;
        }
        
        
        ;
        actualizarTotales();
        return;
      }

      contadorRegistros = 0;
      totalEnergiaGuardada = 0;
      totalEnergiaConsumoGuardada = 0;
      registroEnEdicionId = null;
      borradorEdicion = null;

      registros = [];

      if (agregarInversorEl instanceof HTMLInputElement) {
        agregarInversorEl.checked = false;
      }
      
      
      
      ;
      actualizarTotales();
    };

    const actualizarTotales = (): void => {
      const totalEnergia = registros.reduce((acumulado, registro) => acumulado + (registro.cantidad * registro.potencia), 0);
      const totalEnergiaConsumo = registros.reduce((acumulado, registro) => acumulado + (registro.cantidad * registro.potencia * registro.horas), 0);

      totalEnergiaGuardada = totalEnergia;
      totalEnergiaConsumoGuardada = totalEnergiaConsumo;

      if (totalEnergiaEl) totalEnergiaEl.textContent = `${formatearNumero(totalEnergiaGuardada)} W`;
      if (totalEnergiaConsumoEl) totalEnergiaConsumoEl.textContent = `${formatearNumero(totalEnergiaConsumoGuardada)} Wh`;
      console.log(totalEnergiaConsumoGuardada);
    };

    const renderTabla = (): void => {
      if (!tablaConsumosEl) return;

      const tabla = tablaConsumosEl;
      tabla.innerHTML = "";

      registros.forEach((registro) => {
        const consumo = registro.cantidad * registro.potencia * registro.horas;
        const fila = document.createElement("div");

        fila.className =
          "rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:grid md:grid-cols-6 md:items-center md:rounded-none md:border-0 md:p-0 md:px-2 md:py-3 md:shadow-none text-base text-slate-700";

        const estaEnEdicion = registroEnEdicionId === registro.id && borradorEdicion !== null;

        if (estaEnEdicion && borradorEdicion) {
          fila.innerHTML = `
            <div class="md:px-2">
              <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Objeto</p>
              <p class="font-bold text-slate-800 md:font-normal">${escapeHtml(registro.equipo)}</p>
            </div>

            <div class="mt-3 grid grid-cols-1 gap-3 md:contents">
              <label class="md:px-2">
                <span class="md:hidden mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Cantidad</span>
                <input
                  type="number"
                  min="1"
                  value="${borradorEdicion.cantidad}"
                  class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-[#cc3b26]"
                  data-campo="cantidad"
                  data-id="${registro.id}"
                />
              </label>

              <label class="md:px-2">
                <span class="md:hidden mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Potencia</span>
                <input
                  type="number"
                  min="0"
                  step="0.01"
                  value="${borradorEdicion.potencia}"
                  class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-[#cc3b26]"
                  data-campo="potencia"
                  data-id="${registro.id}"
                />
              </label>

              <label class="md:px-2">
                <span class="md:hidden mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-400">Horas</span>
                <input
                  type="number"
                  min="0"
                  step="0.1"
                  value="${borradorEdicion.horas}"
                  class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none focus:border-[#cc3b26]"
                  data-campo="horas"
                  data-id="${registro.id}"
                />
              </label>

              <div class="md:px-2">
                <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Consumo</p>
                <p class="font-bold text-[#cc3b26]">${formatearNumero(consumo)} Wh</p>
              </div>
            </div>

            <div class="mt-4 flex gap-2 md:mt-0 md:px-2">
              <button
                type="button"
                class="flex cursor-pointer h-10 flex-1 items-center justify-center rounded-lg bg-emerald-600 text-sm font-semibold text-white transition hover:bg-emerald-700 md:flex-none md:px-3"
                data-action="guardar-edicion"
                data-id="${registro.id}"
                aria-label="Guardar edición"
              >
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M4 12.6111L8.92308 17.5L20 6.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
              </button>

              <button
                type="button"
                class="flex cursor-pointer h-10 flex-1 items-center justify-center rounded-lg bg-slate-500 text-sm font-semibold text-white transition hover:bg-slate-600 md:flex-none md:px-3"
                data-action="cancelar-edicion"
                data-id="${registro.id}"
                aria-label="Cancelar edición"
              >
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z" fill="#ffffff"></path> </g></svg>
              </button>
            </div>
          `;
        } else {
          fila.innerHTML = `
            <div class="md:px-2">
              <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Objeto</p>
              <p class="font-bold text-slate-800 md:font-normal">${escapeHtml(registro.equipo)}</p>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-3 md:contents">
              <div class="md:px-2">
                <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Cantidad</p>
                <p>${registro.cantidad}</p>
              </div>

              <div class="md:px-2">
                <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Potencia</p>
                <p>${formatearNumero(registro.potencia)} W</p>
              </div>

              <div class="md:px-2">
                <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Horas</p>
                <p>${formatearNumero(registro.horas)} h</p>
              </div>

              <div class="md:px-2">
                <p class="md:hidden text-xs font-semibold uppercase tracking-wide text-slate-400">Consumo</p>
                <p class="font-bold text-[#cc3b26]">${formatearNumero(consumo)} Wh</p>
              </div>
            </div>

            <div class="mt-4 flex gap-2 md:mt-0 md:px-2">
              <button
                type="button"
                class="flex h-10 flex-1 cursor-pointer items-center justify-center rounded-lg border border-slate-300 bg-white text-sm font-semibold text-slate-700 transition hover:bg-slate-100 md:flex-none md:px-3"
                data-action="editar"
                data-id="${registro.id}"
                title="Editar registro"
              >
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M21.2799 6.40005L11.7399 15.94C10.7899 16.89 7.96987 17.33 7.33987 16.7C6.70987 16.07 7.13987 13.25 8.08987 12.3L17.6399 2.75002C17.8754 2.49308 18.1605 2.28654 18.4781 2.14284C18.7956 1.99914 19.139 1.92124 19.4875 1.9139C19.8359 1.90657 20.1823 1.96991 20.5056 2.10012C20.8289 2.23033 21.1225 2.42473 21.3686 2.67153C21.6147 2.91833 21.8083 3.21243 21.9376 3.53609C22.0669 3.85976 22.1294 4.20626 22.1211 4.55471C22.1128 4.90316 22.0339 5.24635 21.8894 5.5635C21.7448 5.88065 21.5375 6.16524 21.2799 6.40005V6.40005Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M11 4H6C4.93913 4 3.92178 4.42142 3.17163 5.17157C2.42149 5.92172 2 6.93913 2 8V18C2 19.0609 2.42149 20.0783 3.17163 20.8284C3.92178 21.5786 4.93913 22 6 22H17C19.21 22 20 20.2 20 18V13" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
              </button>

              ${registro.esInversor ? '' : `
                <button
                  type="button"
                  class="flex h-10 flex-1 cursor-pointer items-center justify-center rounded-lg bg-red-600 text-sm font-semibold text-white transition hover:bg-red-700 md:flex-none md:px-3"
                  data-action="eliminar"
                  data-id="${registro.id}"
                >
                  <svg class="h-6 w-6 pointer-events-none" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M10 12L14 16M14 12L10 16M18 6L17.1991 18.0129C17.129 19.065 17.0939 19.5911 16.8667 19.99C16.6666 20.3412 16.3648 20.6235 16.0011 20.7998C15.588 21 15.0607 21 14.0062 21H9.99377C8.93927 21 8.41202 21 7.99889 20.7998C7.63517 20.6235 7.33339 20.3412 7.13332 19.99C6.90607 19.5911 6.871 19.065 6.80086 18.0129L6 6M4 6H20M16 6L15.7294 5.18807C15.4671 4.40125 15.3359 4.00784 15.0927 3.71698C14.8779 3.46013 14.6021 3.26132 14.2905 3.13878C13.9376 3 13.523 3 12.6936 3H11.3064C10.477 3 10.0624 3 9.70951 3.13878C9.39792 3.26132 9.12208 3.46013 8.90729 3.71698C8.66405 4.00784 8.53292 4.40125 8.27064 5.18807L8 6" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                </button>
              `}
            </div>
          `;
        }

        tabla.appendChild(fila);
      });
    };

    const cargarElectrodomesticos = async (): Promise<void> => {
      try {
        const respuesta = await fetch("/json/electrodomesticos.json");
        if (!respuesta.ok) throw new Error("No se pudo cargar la lista de equipos.");
        electrodomesticos = (await respuesta.json()) as Electrodomestico[];
      } catch (error) {
        console.error(error);
        electrodomesticos = [];
      }

      if (!(equipoEl instanceof HTMLSelectElement)) return;

      const select = equipoEl;
      select.innerHTML = "";

      const categorias = electrodomesticos.reduce<Map<string, Electrodomestico[]>>((acumulador, equipo) => {
        const categoria = equipo.categoria || "Sin categoría";
        if (!acumulador.has(categoria)) acumulador.set(categoria, []);
        acumulador.get(categoria)?.push(equipo);
        return acumulador;
      }, new Map());

      categorias.forEach((equipos, categoria) => {
        const grupo = document.createElement("optgroup");
        grupo.label = categoria;

        equipos.forEach((equipo) => {
          const opcion = document.createElement("option");
          opcion.value = equipo.nombre;
          opcion.textContent = `${equipo.nombre} (${equipo.potencia} W)`;
          grupo.appendChild(opcion);
        });

        select.appendChild(grupo);
      });

      if (electrodomesticos.length === 0) {
        const opcion = document.createElement("option");
        opcion.value = "";
        opcion.textContent = "Sin equipos disponibles";
        select.appendChild(opcion);
      }

      actualizarPotenciaPorEquipo();
    };

    const actualizarPotenciaPorEquipo = (): void => {
      if (!(equipoEl instanceof HTMLSelectElement) || !(potenciaEl instanceof HTMLInputElement)) return;

      const select = equipoEl;
      const potenciaInput = potenciaEl;
      const equipoSeleccionado = electrodomesticos.find((equipo) => equipo.nombre === select.value);
      if (!equipoSeleccionado) return;
      potenciaInput.value = `${equipoSeleccionado.potencia}`;
    };

    const iniciarEdicionRegistro = (id: number): void => {
      const registro = registros.find((item) => item.id === id);
      if (!registro) return;

      registroEnEdicionId = id;
      borradorEdicion = {
        cantidad: registro.cantidad,
        potencia: registro.potencia,
        horas: registro.horas
      };

      renderTabla();
    };

    const cancelarEdicionRegistro = (): void => {
      registroEnEdicionId = null;
      borradorEdicion = null;
      renderTabla();
    };

    const actualizarBorradorEdicion = (campo: CampoEditable, valor: string): void => {
      if (registroEnEdicionId === null || !borradorEdicion) return;
      borradorEdicion = { ...borradorEdicion, [campo]: Number(valor) };
    };

    const guardarEdicionRegistro = (id: number): void => {
      if (registroEnEdicionId !== id || !borradorEdicion) return;

      const cantidad = Number(borradorEdicion.cantidad);
      const potencia = Number(borradorEdicion.potencia);
      const horas = Number(borradorEdicion.horas);

      if (cantidad <= 0 || potencia <= 0 || horas <= 0) {
        alert("Para guardar la edición, usa valores válidos mayores a cero.");
        return;
      }

      registros = registros.map((registro) => {
        if (registro.id !== id) return registro;
        return { ...registro, cantidad, potencia, horas };
      });

      registroEnEdicionId = null;
      borradorEdicion = null;
      renderTabla();
      actualizarTotales();
      guardarRegistrosEnStorage();
    };

    const eliminarRegistro = (id: number): void => {
      const registroAEliminar = registros.find((item) => item.id === id);
      if (registroAEliminar?.esInversor) {
        alert("No puedes eliminar el consumo del inversor.");
        return;
      }
      registros = registros.filter((item) => item.id !== id);
      if (registroEnEdicionId === id) {
        registroEnEdicionId = null;
        borradorEdicion = null;
      }
      renderTabla();
      actualizarTotales();
      guardarRegistrosEnStorage();
    };

    const manejarCambioEquipo = (): void => {
      if (registroEnEdicionId !== null) return;
      actualizarPotenciaPorEquipo();
    };

    const manejarCambioCheckboxInversor = (): void => {
      sincronizarRegistroInversor();
      renderTabla();
      actualizarTotales();
      guardarRegistrosEnStorage();
    };

    const manejarClickCalcular = (): void => {
      const equipo = equipoEl instanceof HTMLSelectElement ? equipoEl.value : "";
      const cantidad = cantidadEl instanceof HTMLInputElement ? Number(cantidadEl.value) : 0;
      const potencia = potenciaEl instanceof HTMLInputElement ? Number(potenciaEl.value) : 0;
      const horas = horasEl instanceof HTMLInputElement ? Number(horasEl.value) : 0;

      if (!equipo || cantidad <= 0 || potencia <= 0 || horas <= 0) {
        alert("Por favor, completa todos los campos con valores válidos.");
        return;
      }

      if (registroEnEdicionId !== null) {
        alert("Termina o cancela la edición en la tabla antes de agregar un nuevo equipo.");
        return;
      }

      contadorRegistros += 1;
      registros.push({
        id: contadorRegistros,
        equipo,
        cantidad,
        potencia,
        horas
      });

      renderTabla();
      actualizarTotales();
      guardarRegistrosEnStorage();
      limpiarFormulario();
    };

    const manejarInputTabla = (event: Event): void => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (registroEnEdicionId === null || Number(target.dataset.id) !== registroEnEdicionId) return;

      const campo = target.dataset.campo;
      if (!campo || !esCampoEditable(campo)) return;
      actualizarBorradorEdicion(campo, target.value);
    };

    const manejarClickTabla = (event: Event): void => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const botonAccion = target.closest("button[data-action][data-id]");
      if (!(botonAccion instanceof HTMLButtonElement)) return;

      const id = Number(botonAccion.dataset.id);
      const accion = botonAccion.dataset.action;

      if (accion === "editar") iniciarEdicionRegistro(id);
      if (accion === "eliminar") eliminarRegistro(id);
      if (accion === "guardar-edicion") guardarEdicionRegistro(id);
      if (accion === "cancelar-edicion") cancelarEdicionRegistro();
    };

    const registrarEventos = (): void => {
      if (equipoEl && equipoEl.dataset.listenerBound !== "1") {
        equipoEl.addEventListener("change", manejarCambioEquipo);
        equipoEl.dataset.listenerBound = "1";
      }

      if (btnCalcularEl && btnCalcularEl.dataset.listenerBound !== "1") {
        btnCalcularEl.addEventListener("click", manejarClickCalcular);
        btnCalcularEl.dataset.listenerBound = "1";
      }

      if (tablaConsumosEl && tablaConsumosEl.dataset.inputBound !== "1") {
        tablaConsumosEl.addEventListener("input", manejarInputTabla);
        tablaConsumosEl.dataset.inputBound = "1";
      }

      if (tablaConsumosEl && tablaConsumosEl.dataset.clickBound !== "1") {
        tablaConsumosEl.addEventListener("click", manejarClickTabla);
        tablaConsumosEl.dataset.clickBound = "1";
      }

      if (agregarInversorEl && agregarInversorEl.dataset.listenerBound !== "1") {
        agregarInversorEl.addEventListener("change", manejarCambioCheckboxInversor);
        agregarInversorEl.dataset.listenerBound = "1";
      }

      if (helpTriggerEl && helpTriggerEl.dataset.listenerBound !== "1") {
        helpTriggerEl.addEventListener("click", (event) => {
          prettyModal.open("help-consumo-dialog", event);
        });
        helpTriggerEl.dataset.listenerBound = "1";
      }

      if (helpCloseEl && helpCloseEl.dataset.listenerBound !== "1") {
        helpCloseEl.addEventListener("click", () => {
          prettyModal.close("help-consumo-dialog");
        });
        helpCloseEl.dataset.listenerBound = "1";
      }

      if (helpUnderstoodEl && helpUnderstoodEl.dataset.listenerBound !== "1") {
        helpUnderstoodEl.addEventListener("click", () => {
          prettyModal.close("help-consumo-dialog");
        });
        helpUnderstoodEl.dataset.listenerBound = "1";
      }

      if (helpDialogEl && helpDialogEl.dataset.listenerBound !== "1") {
        helpDialogEl.addEventListener("click", (event) => {
          if (event.target === helpDialogEl) {
            prettyModal.close("help-consumo-dialog");
          }
        });

        helpDialogEl.addEventListener("cancel", (event) => {
          event.preventDefault();
          prettyModal.close("help-consumo-dialog");
        });

        helpDialogEl.dataset.listenerBound = "1";
      }
    };

    const inicializarPaginaConsumo = (): void => {
      sincronizarElementosDom();
      if (!esPaginaConsumoActiva()) return;

      inicializarConsumosGuardados();
      sincronizarRegistroInversor();
      renderTabla();
      actualizarTotales();
      guardarRegistrosEnStorage();
      registrarEventos();
      registerNavigationPreloader();
      void cargarElectrodomesticos();
    };

    document.addEventListener("astro:page-load", inicializarPaginaConsumo);
    window.addEventListener("pageshow", inicializarPaginaConsumo);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", inicializarPaginaConsumo, { once: true });
    } else {
      inicializarPaginaConsumo();
    }
  </script>
