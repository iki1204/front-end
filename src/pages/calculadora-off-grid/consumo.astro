---
import Layout from '../../layouts/LayoutCalculadora.astro';
---

<style>
  /* Toggle estilo iPhone con :has() */
  label:has(#agregar-inversor:checked) .toggle-track {
    background-color: #cc2f1f;
  }
  label:has(#agregar-inversor:checked) .toggle-thumb {
    transform: translateX(1.25rem);
  }

  #help-consumo-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(96vw, 920px);
    width: min(96vw, 920px);
    margin: 0;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  #help-consumo-dialog::backdrop {
    background: rgba(15, 23, 42, 0.35);
    backdrop-filter: blur(2px);
  }
</style>

<Layout title="Unicom - Off Grid">
  <main class="min-h-screen min-w-screen bg-white">
  <section class="mx-auto grid min-h-screen min-w-screen w-full max-w-[1520px] grid-cols-1 lg:grid-cols-[minmax(340px,30%)_1fr]">
    <aside class="relative hidden lg:flex items-baseline px-[clamp(2.5rem,3.8vw,4rem)] text-white min-h-screen" style="background: radial-gradient(ellipse at top left, #c92a2a 0%, #5a0a0a 60%, #2a0303 100%);">
      <!-- Fondo decorativo de puntos y líneas -->
      <div class="pointer-events-none absolute inset-0 z-0">
        <svg width="100%" height="100%" viewBox="0 0 400 900" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-full h-full opacity-40" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="bgGrad" cx="0.3" cy="0.1" r="1">
              <stop offset="0%" stop-color="#c92a2a"/>
              <stop offset="60%" stop-color="#5a0a0a"/>
              <stop offset="100%" stop-color="#2a0303"/>
            </radialGradient>
            <linearGradient id="lineGrad" x1="0" y1="0" x2="400" y2="900" gradientUnits="userSpaceOnUse">
              <stop stop-color="#fff" stop-opacity="0.12"/>
              <stop offset="1" stop-color="#fff" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="400" height="900" fill="url(#bgGrad)"/>
          <!-- Líneas curvas decorativas -->
          <path d="M20 200 Q200 100 380 220" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
          <path d="M0 400 Q200 300 400 500" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
          <path d="M40 700 Q200 850 360 700" stroke="url(#lineGrad)" stroke-width="2" fill="none"/>
          <!-- Puntos grandes difusos -->
          <g opacity="0.13">
            <circle cx="350" cy="100" r="80" fill="#fff"/>
            <circle cx="100" cy="800" r="120" fill="#fff"/>
            <circle cx="350" cy="300" r="60" fill="#fff"/>
            <circle cx="60" cy="600" r="40" fill="#fff"/>
          </g>
          <!-- Matriz de puntos pequeños, más cantidad y más visibles -->
          <g opacity="0.22">
            <!-- Primera columna -->
            <circle cx="40" cy="80" r="3" fill="#fff"/>
            <circle cx="40" cy="160" r="3" fill="#fff"/>
            <circle cx="40" cy="240" r="3" fill="#fff"/>
            <circle cx="40" cy="320" r="3" fill="#fff"/>
            <circle cx="40" cy="400" r="3" fill="#fff"/>
            <circle cx="40" cy="480" r="3" fill="#fff"/>
            <circle cx="40" cy="560" r="3" fill="#fff"/>
            <circle cx="40" cy="640" r="3" fill="#fff"/>
            <circle cx="40" cy="720" r="3" fill="#fff"/>
            <circle cx="40" cy="800" r="3" fill="#fff"/>
            <!-- Segunda columna -->
            <circle cx="100" cy="120" r="3" fill="#fff"/>
            <circle cx="100" cy="200" r="3" fill="#fff"/>
            <circle cx="100" cy="280" r="3" fill="#fff"/>
            <circle cx="100" cy="360" r="3" fill="#fff"/>
            <circle cx="100" cy="440" r="3" fill="#fff"/>
            <circle cx="100" cy="520" r="3" fill="#fff"/>
            <circle cx="100" cy="600" r="3" fill="#fff"/>
            <circle cx="100" cy="680" r="3" fill="#fff"/>
            <circle cx="100" cy="760" r="3" fill="#fff"/>
            <!-- Tercera columna -->
            <circle cx="180" cy="80" r="3" fill="#fff"/>
            <circle cx="180" cy="160" r="3" fill="#fff"/>
            <circle cx="180" cy="240" r="3" fill="#fff"/>
            <circle cx="180" cy="320" r="3" fill="#fff"/>
            <circle cx="180" cy="400" r="3" fill="#fff"/>
            <circle cx="180" cy="480" r="3" fill="#fff"/>
            <circle cx="180" cy="560" r="3" fill="#fff"/>
            <circle cx="180" cy="640" r="3" fill="#fff"/>
            <circle cx="180" cy="720" r="3" fill="#fff"/>
            <circle cx="180" cy="800" r="3" fill="#fff"/>
            <!-- Cuarta columna -->
            <circle cx="260" cy="120" r="3" fill="#fff"/>
            <circle cx="260" cy="200" r="3" fill="#fff"/>
            <circle cx="260" cy="280" r="3" fill="#fff"/>
            <circle cx="260" cy="360" r="3" fill="#fff"/>
            <circle cx="260" cy="440" r="3" fill="#fff"/>
            <circle cx="260" cy="520" r="3" fill="#fff"/>
            <circle cx="260" cy="600" r="3" fill="#fff"/>
            <circle cx="260" cy="680" r="3" fill="#fff"/>
            <circle cx="260" cy="760" r="3" fill="#fff"/>
            <!-- Quinta columna -->
            <circle cx="340" cy="80" r="3" fill="#fff"/>
            <circle cx="340" cy="160" r="3" fill="#fff"/>
            <circle cx="340" cy="240" r="3" fill="#fff"/>
            <circle cx="340" cy="320" r="3" fill="#fff"/>
            <circle cx="340" cy="400" r="3" fill="#fff"/>
            <circle cx="340" cy="480" r="3" fill="#fff"/>
            <circle cx="340" cy="560" r="3" fill="#fff"/>
            <circle cx="340" cy="640" r="3" fill="#fff"/>
            <circle cx="340" cy="720" r="3" fill="#fff"/>
            <circle cx="340" cy="800" r="3" fill="#fff"/>
          </g>
        </svg>
      </div>
      <div class="sticky space-y-8 sm:space-y-10 top-28 lg:top-30 z-10">
        <!-- Icono solar -->
        <div class="mb-4 flex justify-start">
          <svg class="h-20 w-20" fill="#ffffff" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 260 244" enable-background="new 0 0 260 244" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M258,54v-8h-25.176c-0.596-3.416-1.941-6.576-3.86-9.307l17.806-17.806l-5.656-5.657l-17.803,17.802 c-2.731-1.926-5.892-3.275-9.311-3.876V2h-8v25.148c-3.433,0.596-6.609,1.947-9.35,3.879L178.87,13.248l-5.656,5.657l17.781,17.78 c-1.922,2.733-3.269,5.896-3.866,9.315H162v8h25.129c0.598,3.428,1.95,6.597,3.88,9.335L173.23,81.112l5.656,5.657l17.783-17.782 c2.737,1.924,5.906,3.271,9.331,3.865V98h8V72.844c3.41-0.599,6.565-1.944,9.292-3.862l17.804,17.805l5.656-5.656l-17.803-17.804 c1.927-2.735,3.276-5.902,3.874-9.326H258z M209.976,34.8c8.382,0,15.2,6.819,15.2,15.2s-6.818,15.2-15.2,15.2 c-8.381,0-15.199-6.819-15.199-15.2S201.595,34.8,209.976,34.8z M80,236v6H43v-6h15v-22h6v22H80z M63.537,82l9.723,38h24.545 l-9.773-38H63.537z M84.518,164h24.603l-9.773-38H74.795L84.518,164z M78.325,164l-9.723-38h-24.52l9.723,38H78.325z M26.632,82H2 l9.772,38h24.582L26.632,82z M67.067,120l-9.723-38H32.825l9.723,38H67.067z M95.776,208h24.661l-9.773-38H86.053L95.776,208z M55.34,170l9.723,38h24.52l-9.723-38H55.34z M37.89,126H13.315l9.772,38h24.525L37.89,126z M24.631,170l9.772,38H58.87l-9.723-38 H24.631z M178.667,190h17.055l6.686,26h-17.089L178.667,190z M163,237v-16h-5v16h-11v5h27v-5H163z M155.259,185l-7.164-28h16.968 l7.164,28H155.259z M146.815,152l-6.652-26h16.968l6.652,26H146.815z M173.506,190l6.652,26H163.19l-6.652-26H173.506z M151.377,190 l6.652,26h-16.834l-6.686-26H151.377z M141.654,152h-16.917l-6.686-26h16.951L141.654,152z M150.098,185h-16.874l-7.201-28h16.911 L150.098,185z M179.264,126l6.686,26h-17.006l-6.652-26H179.264z M170.223,157h17.013l7.201,28h-17.049L170.223,157z M240,238v4h-16 v-4h6v-9h4v9H240z M230.721,210l3.838,15h9.591l-3.838-15H230.721z M248.279,225H258l-3.858-15h-9.702L248.279,225z M217.049,210 l3.858,15h9.524l-3.838-15H217.049z M243.417,206h9.696l-4.115-16h-9.675L243.417,206z M216.358,170h-9.596l4.115,16h9.575 L216.358,170z M234.206,170l4.094,16h9.67l-4.115-16H234.206z M221.475,190h-9.57l4.115,16h9.549L221.475,190z M239.288,206 l-4.094-16h-9.591l4.094,16H239.288z M234.171,186l-4.094-16h-9.591l4.094,16H234.171z"></path> </g></svg>        </div>
        <h1 class="m-0 text-[clamp(2.2rem,4vw,3.2rem)] leading-[1.05] font-black tracking-[-0.07em] text-balance">
          Simulador de<br />Proyectos<br />Fotovoltaicos<br />
          <span class="text-[#ff5c39]">Off-Grid.</span>
        </h1>
        <h2 class="mt-2 text-[clamp(1.1rem,1.5vw,1.5rem)] font-semibold">Diseña tu autonomía total</h2>
        <div class="w-32 h-1 bg-[#ff5c39] rounded-full mb-10"></div>
        <p class="max-w-[38ch] text-[clamp(1rem,1.2vw,1.35rem)] leading-normal font-medium text-white/90">Calcula el sistema solar ideal para operar sin red eléctrica: paneles, inversor y baterías según tu demanda diaria.</p>
        <!-- Caja de mensaje -->
        <div class="mt-8">
          <div class="flex items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/20">
              <svg class="h-6 w-6" fill="#ffffff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.488 21.754c.294.157.663.156.957-.001 8.012-4.304 8.581-12.713 8.574-15.104a.988.988 0 0 0-.596-.903l-8.05-3.566a1.005 1.005 0 0 0-.813.001L3.566 5.747a.99.99 0 0 0-.592.892c-.034 2.379.445 10.806 8.514 15.115zM8.674 10.293l2.293 2.293 4.293-4.293 1.414 1.414-5.707 5.707-3.707-3.707 1.414-1.414z"></path></g></svg>
            </span>
            <span class="text-base font-medium text-white">Energía independiente, libertad sin límites.</span>
          </div>
        </div>
      </div>
    </aside>

    <section class="mx-auto w-full rounded-md border border-slate-300 shadow-lg bg-white">

      <header class="flex items-center justify-between rounded-t-md bg-white px-6 py-5 text-slate-900">
        <div class="flex items-center gap-4">
          <span class="inline-flex h-18 w-18 items-center justify-center rounded-full bg-red-500">
            <svg class="h-9 w-9" fill="#ffffff" height="200px" width="200px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 283.831 283.831" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path d="M171.484,134.682h-47c-5.247,0-9.5,4.253-9.5,9.5v130c0,5.247,4.253,9.5,9.5,9.5h47c5.247,0,9.5-4.253,9.5-9.5v-130 C180.984,138.935,176.73,134.682,171.484,134.682z"></path> <path d="M271.822,69.682h-47c-5.247,0-9.5,4.253-9.5,9.5v195c0,5.247,4.253,9.5,9.5,9.5h47c5.246,0,9.5-4.253,9.5-9.5v-195 C281.322,73.935,277.069,69.682,271.822,69.682z"></path> <path d="M71.145,176.831h-47c-5.247,0-9.5,4.253-9.5,9.5v88c0,5.247,4.254,9.5,9.5,9.5h47c5.247,0,9.5-4.253,9.5-9.5v-88 C80.645,181.085,76.392,176.831,71.145,176.831z"></path> <path d="M193.391,18.189L158.163,1.456c-7.486-3.558-16.431-0.369-19.984,7.113c-3.555,7.482-0.37,16.431,7.113,19.984l2.864,1.361 L12.483,78.206C4.678,80.984,0.604,89.563,3.381,97.368c2.186,6.142,7.965,9.974,14.132,9.974c1.67,0,3.367-0.28,5.03-0.872 l135.162-48.11l-1.031,2.17c-3.555,7.483-0.37,16.431,7.113,19.984c2.078,0.987,4.269,1.455,6.425,1.455 c5.611-0.001,10.993-3.163,13.56-8.568l16.732-35.228C204.059,30.691,200.874,21.743,193.391,18.189z"></path> </g> </g></svg>
          </span>
          <div>
            <h1 class="m-0 text-[clamp(1.75rem,2.2vw,2.6rem)] font-black leading-tight tracking-[-0.04em] text-slate-900">Uso diario de Energía</h1>
            <p class="m-0 mt-1 text-[clamp(0.95rem,1.05vw,1.1rem)] font-medium text-slate-500">Selecciona tus equipos y calcula tu consumo diario</p>
          </div>
        </div>
        <button
          id="help-consumo-trigger"
          type="button"
          aria-label="Abrir ayuda sobre consumo"
          class="cursor-pointer inline-flex h-14 w-14 items-center justify-center rounded-full border border-slate-200 text-2xl text-slate-500 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700"
        >
          ?
        </button>
      </header>

      <dialog id="help-consumo-dialog">
        <article class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 sm:p-6 shadow-2xl">
          <button
            id="help-consumo-close"
            type="button"
            aria-label="Cerrar ayuda"
            class="absolute right-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-2xl text-slate-500 transition hover:bg-slate-50 hover:text-slate-700"
          >
            ×
          </button>

          <div class="pr-14">
            <div class="flex items-start gap-4 sm:gap-5">
              <span class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
                <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M4 5.5C4 4.67 4.67 4 5.5 4H9.3C9.88 4 10.43 4.24 10.82 4.66L12 5.93L13.18 4.66C13.57 4.24 14.12 4 14.7 4H18.5C19.33 4 20 4.67 20 5.5V17.5C20 18.33 19.33 19 18.5 19H14.7C14.12 19 13.57 19.24 13.18 19.66L12 20.93L10.82 19.66C10.43 19.24 9.88 19 9.3 19H5.5C4.67 19 4 18.33 4 17.5V5.5Z" stroke="#dc2626" stroke-width="1.8"/>
                  <path d="M8 9H9.5M8 12H10.5M14.5 9H16M14.5 12H16" stroke="#dc2626" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <div>
                <h2 class="m-0 text-[clamp(1.7rem,2.9vw,2.7rem)] font-black leading-tight tracking-[-0.03em] text-slate-900">¿Cómo ingresar tu consumo?</h2>
                <p class="m-0 mt-1 text-[clamp(0.96rem,1.2vw,1.2rem)] font-medium text-slate-500">Sigue estos pasos para registrar correctamente tus equipos y calcular tu demanda diaria.</p>
              </div>
            </div>

            <div class="mt-6 space-y-3">
              <div class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5H5L6.2 12H17.7L19 7H7" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="18" r="1.6" fill="#dc2626"/><circle cx="17" cy="18" r="1.6" fill="#dc2626"/></svg>
                </span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white">1</span>
                <div class="min-w-0 flex-1">
                  <p class="m-0 text-xl font-bold text-slate-900">Selecciona el equipo</p>
                  <p class="m-0 mt-1 text-base text-slate-500">Elige un equipo del listado, por ejemplo refrigerador, foco o televisor.</p>
                </div>
              </div>

              <div class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="16" height="16" rx="3" stroke="#dc2626" stroke-width="2"/><path d="M12 8V16M8 12H16" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/></svg>
                </span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white">2</span>
                <div class="min-w-0 flex-1">
                  <p class="m-0 text-xl font-bold text-slate-900">Ingresa la cantidad</p>
                  <p class="m-0 mt-1 text-base text-slate-500">Especifica cuántas unidades de ese equipo utilizarás.</p>
                </div>
              </div>

              <div class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.2 2.8L6.8 13.2H11.4L10.8 21.2L17.2 10.8H12.6L13.2 2.8Z" stroke="#dc2626" stroke-width="2" stroke-linejoin="round"/></svg>
                </span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white">3</span>
                <div class="min-w-0 flex-1">
                  <p class="m-0 text-xl font-bold text-slate-900">Define potencia y horas</p>
                  <p class="m-0 mt-1 text-base text-slate-500">Verifica la potencia en watts y cuántas horas al día estará encendido.</p>
                </div>
              </div>

              <div class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="3" width="16" height="18" rx="2" stroke="#dc2626" stroke-width="2"/><path d="M8 8H16M8 12H10M12 12H14M16 12H16.01M8 16H10M12 16H14M16 16H16.01" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/></svg>
                </span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white">4</span>
                <div class="min-w-0 flex-1">
                  <p class="m-0 text-xl font-bold text-slate-900">Haz clic en calcular</p>
                  <p class="m-0 mt-1 text-base text-slate-500">El sistema añadirá el consumo del equipo a tu tabla automáticamente.</p>
                </div>
              </div>

              <div class="flex items-center gap-4 rounded-2xl border border-slate-200 px-4 py-3">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 7.5C5.6 5.4 8.1 4 11 4C14.7 4 17.9 6.3 19.1 9.6" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/><path d="M20 5V10H15" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 16.5C18.4 18.6 15.9 20 13 20C9.3 20 6.1 17.7 4.9 14.4" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/><path d="M4 19V14H9" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-bold text-white">5</span>
                <div class="min-w-0 flex-1">
                  <p class="m-0 text-xl font-bold text-slate-900">Repite con todos tus equipos</p>
                  <p class="m-0 mt-1 text-base text-slate-500">Agrega cada aparato por separado para obtener un cálculo más preciso.</p>
                </div>
              </div>
            </div>

            <div class="mt-4 rounded-2xl border border-orange-200 bg-orange-50/40 p-4">
              <p class="m-0 text-[1.7rem] font-black text-orange-500">Tip: <span class="text-lg font-medium text-slate-700">Si no conoces la potencia exacta, puedes usar un valor aproximado y luego ajustarlo.</span></p>

              <div class="mt-3 rounded-xl border border-slate-200 bg-white p-3">
