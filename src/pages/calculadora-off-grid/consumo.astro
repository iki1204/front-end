        </article>
      </dialog>

      <div class="space-y-7 px-6 py-7">
        <div class="rounded-xl border border-slate-200 bg-white/70 p-4 sm:p-5">
          <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-6">
            <div>
              <label for="equipo" class="mb-2 block text-sm text-slate-700">Seleccione el equipo</label>
              <select id="equipo" class="h-11 w-full rounded-xl border-2 border-gray-300 bg-white px-3 text-xl text-slate-700 outline-none">
