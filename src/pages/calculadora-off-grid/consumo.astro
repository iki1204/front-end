            <label class="block">
              <span class="mb-2 block text-sm text-slate-700">Horas al día</span>
              <input id="horas" type="number" min="0" step="0.1" class="h-11 w-full rounded border border-slate-400 bg-white px-3 text-lg text-slate-700 outline-none" />
