            <div>
              <p class="mb-2 text-sm text-slate-700">Agregar consumo del inversor</p>
              <label for="agregar-inversor" class="inline-flex cursor-pointer items-center gap-4 px-4 py-2">
                <input id="agregar-inversor" type="checkbox" class="peer sr-only" />
                <span class="toggle-track relative inline-block h-7 w-12 shrink-0 rounded-full bg-slate-300 transition-colors duration-300 ease-in-out peer-checked:bg-[#cc2f1f]">
