---
import Layout from '../../layouts/LayoutCalculadora.astro';
---

<Layout title="Unicom - Off Grid">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <style>
      /* Contenedor del mapa forma su propio stacking context con z-index bajo */
      #mapa-ecuador {
        position: relative;
        z-index: 0;
      }
      /* Reducir z-indexes internos de Leaflet para que no sobresalgan del header */
      #mapa-ecuador .leaflet-pane         { z-index: 4; }
      #mapa-ecuador .leaflet-tile-pane    { z-index: 2; }
      #mapa-ecuador .leaflet-overlay-pane { z-index: 4; }
      #mapa-ecuador .leaflet-shadow-pane  { z-index: 5; }
      #mapa-ecuador .leaflet-marker-pane  { z-index: 6; }
      #mapa-ecuador .leaflet-tooltip-pane { z-index: 7; }
      #mapa-ecuador .leaflet-popup-pane   { z-index: 8; }
      #mapa-ecuador .leaflet-top,
      #mapa-ecuador .leaflet-bottom       { z-index: 9; }
    </style>
  </Fragment>
  <main class="min-h-screen bg-white">
    <section class="mx-auto grid min-h-screen min-w-screen w-full max-w-[1520px] grid-cols-1 lg:grid-cols-[minmax(340px,30%)_1fr]">
      <aside class="relative hidden lg:flex items-baseline px-[clamp(2.5rem,3.8vw,4rem)] text-white min-h-screen" style="background: radial-gradient(ellipse at top left, #c92a2a 0%, #5a0a0a 60%, #2a0303 100%);">
