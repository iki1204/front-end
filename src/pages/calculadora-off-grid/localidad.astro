        </div>
        <div class="sticky top-28 lg:top-30 z-10 space-y-8 sm:space-y-10">
          <div class="mb-4 flex justify-start">
            <svg class="h-20 w-20" fill="#ffffff" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 260 244" enable-background="new 0 0 260 244" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M258,54v-8h-25.176c-0.596-3.416-1.941-6.576-3.86-9.307l17.806-17.806l-5.656-5.657l-17.803,17.802 c-2.731-1.926-5.892-3.275-9.311-3.876V2h-8v25.148c-3.433,0.596-6.609,1.947-9.35,3.879L178.87,13.248l-5.656,5.657l17.781,17.78 c-1.922,2.733-3.269,5.896-3.866,9.315H162v8h25.129c0.598,3.428,1.95,6.597,3.88,9.335L173.23,81.112l5.656,5.657l17.783-17.782 c2.737,1.924,5.906,3.271,9.331,3.865V98h8V72.844c3.41-0.599,6.565-1.944,9.292-3.862l17.804,17.805l5.656-5.656l-17.803-17.804 c1.927-2.735,3.276-5.902,3.874-9.326H258z M209.976,34.8c8.382,0,15.2,6.819,15.2,15.2s-6.818,15.2-15.2,15.2 c-8.381,0-15.199-6.819-15.199-15.2S201.595,34.8,209.976,34.8z M80,236v6H43v-6h15v-22h6v22H80z M63.537,82l9.723,38h24.545 l-9.773-38H63.537z M84.518,164h24.603l-9.773-38H74.795L84.518,164z M78.325,164l-9.723-38h-24.52l9.723,38H78.325z M26.632,82H2 l9.772,38h24.582L26.632,82z M67.067,120l-9.723-38H32.825l9.723,38H67.067z M95.776,208h24.661l-9.773-38H86.053L95.776,208z M55.34,170l9.723,38h24.52l-9.723-38H55.34z M37.89,126H13.315l9.772,38h24.525L37.89,126z M24.631,170l9.772,38H58.87l-9.723-38 H24.631z M178.667,190h17.055l6.686,26h-17.089L178.667,190z M163,237v-16h-5v16h-11v5h27v-5H163z M155.259,185l-7.164-28h16.968 l7.164,28H155.259z M146.815,152l-6.652-26h16.968l6.652,26H146.815z M173.506,190l6.652,26H163.19l-6.652-26H173.506z M151.377,190 l6.652,26h-16.834l-6.686-26H151.377z M141.654,152h-16.917l-6.686-26h16.951L141.654,152z M150.098,185h-16.874l-7.201-28h16.911 L150.098,185z M179.264,126l6.686,26h-17.006l-6.652-26H179.264z M170.223,157h17.013l7.201,28h-17.049L170.223,157z M240,238v4h-16 v-4h6v-9h4v9H240z M230.721,210l3.838,15h9.591l-3.838-15H230.721z M248.279,225H258l-3.858-15h-9.702L248.279,225z M217.049,210 l3.858,15h9.524l-3.838-15H217.049z M243.417,206h9.696l-4.115-16h-9.675L243.417,206z M216.358,170h-9.596l4.115,16h9.575 L216.358,170z M234.206,170l4.094,16h9.67l-4.115-16H234.206z M221.475,190h-9.57l4.115,16h9.549L221.475,190z M239.288,206 l-4.094-16h-9.591l4.094,16H239.288z M234.171,186l-4.094-16h-9.591l4.094,16H234.171z"></path> </g></svg>
          </div>
          <h1 class="m-0 text-[clamp(2.2rem,4vw,3.2rem)] leading-[1.05] font-black tracking-[-0.07em] text-balance">
            Simulador de<br />Proyectos<br />Fotovoltaicos<br />
            <span class="text-[#ff5c39]">Off-Grid.</span>
          </h1>
          <h2 class="mt-2 text-[clamp(1.1rem,1.5vw,1.5rem)] font-semibold">Diseña tu autonomía total</h2>
          <div class="w-32 h-1 bg-[#ff5c39] rounded-full mb-10"></div>
          <p class="max-w-[38ch] text-[clamp(1rem,1.2vw,1.35rem)] leading-normal font-medium text-white/90">Calcula el sistema solar ideal para operar sin red eléctrica: paneles, inversor y baterías según tu demanda diaria.</p>
          <div class="mt-8">
            <div class="flex items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/20">
                <svg class="h-6 w-6" fill="#ffffff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.488 21.754c.294.157.663.156.957-.001 8.012-4.304 8.581-12.713 8.574-15.104a.988.988 0 0 0-.596-.903l-8.05-3.566a1.005 1.005 0 0 0-.813.001L3.566 5.747a.99.99 0 0 0-.592.892c-.034 2.379.445 10.806 8.514 15.115zM8.674 10.293l2.293 2.293 4.293-4.293 1.414 1.414-5.707 5.707-3.707-3.707 1.414-1.414z"></path></g></svg>
              </span>
              <span class="text-base font-medium text-white">Energía independiente, libertad sin límites.</span>
            </div>
          </div>
        </div>
      </aside>

      
 <section class="mx-auto w-full rounded-md border border-slate-300 bg-slate-100 p-8 shadow-lg">
    <div class="flex items-center gap-4">
      <span class="inline-flex h-18 w-18 items-center justify-center rounded-full bg-red-500">
        <svg class="h-14 w-14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M12 21C15.5 17.4 19 14.1764 19 10.2C19 6.22355 15.866 3 12 3C8.13401 3 5 6.22355 5 10.2C5 14.1764 8.5 17.4 12 21Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M12 12C13.1046 12 14 11.1046 14 10C14 8.89543 13.1046 8 12 8C10.8954 8 10 8.89543 10 10C10 11.1046 10.8954 12 12 12Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
      </span>
      <div>
        <h1 class="m-0 text-[clamp(1.75rem,2.2vw,2.6rem)] font-black leading-tight tracking-[-0.04em] text-slate-900">Localidad</h1>
        <p class="m-0 mt-1 text-[clamp(0.95rem,1.05vw,1.1rem)] font-medium text-slate-500">Selecciona tu provincia para calcular las horas de sol pico</p>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
      <div id="mapa-ecuador" class="h-[520px] w-full rounded border border-slate-300"></div>

      <aside class="rounded border border-slate-300 bg-white p-5">
        <p class="text-sm uppercase tracking-wide text-slate-500">Provincia seleccionada</p>
        <p id="provincia-seleccionada" class="mt-2 text-2xl font-semibold text-slate-900">Ninguna</p>

        <p class="mt-6 text-sm uppercase tracking-wide text-slate-500">Horas de irradiación solar</p>
        <input
          id="horas-irradiacion"
          type="number"
          min="0"
          max="24"
          step="0.1"
          value="0"
          disabled
          class="mt-2 h-11 w-full rounded px-3 text-3xl font-bold text-[#cc3b26] outline-none disabled:cursor-not-allowed"
        />
        <p class="mt-2 text-sm text-slate-600">h/día</p>
        <label for="editar-horas-manual" class="mt-3 flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
          <input id="editar-horas-manual" type="checkbox" class="h-4 w-4 rounded border-slate-400 text-[#cc3b26] focus:ring-[#cc3b26]" />
          Elegir horas manualmente
        </label>

        <p class="mt-6 text-sm text-slate-600">
          Haz clic sobre un marcador para elegir la provincia para saber cuales son las horas de sol pico.
        </p>
      </aside>

      <aside class="">

      </aside>

    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/calculadora-off-grid/consumo"
        data-nav-loading
        class="inline-flex h-11 items-center rounded bg-slate-700 px-6 text-base font-semibold text-white transition hover:bg-slate-800"
      >
        Volver a consumo
      </a>
      <a
        id="confirmar-localidad"
        href="/calculadora-off-grid/paneles"
        data-nav-loading
        class="inline-flex h-11 items-center rounded bg-[#cc2f1f] px-6 text-base font-semibold text-white transition hover:bg-[#b9301d]"
      >
        Confirmar siguiente
      </a>
    </div>
  </section>


    </section>
  </main>
</Layout>

<script>
  import { registerNavigationPreloader } from "../../lib/navigationPreloader";

  type Provincia = {
    nombre: string;
    lat: number;
    lng: number;
    horas_sol: number;
  };

  const LOCALIDAD_STORAGE_KEY = "unicom.offgrid.localidad";

  type LeafletGlobal = any;

  type LeafletWindow = Window & typeof globalThis & {
    L?: LeafletGlobal;
    __leafletLoadingPromise?: Promise<LeafletGlobal>;
    __localidadMap?: any;
  };

  let provinciaSeleccionada: Provincia | null = null;

  const esProvinciaValida = (valor: unknown): valor is Provincia => {
    if (!valor || typeof valor !== "object") return false;

    const provincia = valor as Partial<Provincia>;
    return typeof provincia.nombre === "string"
      && typeof provincia.lat === "number"
      && typeof provincia.lng === "number"
      && typeof provincia.horas_sol === "number";
  };

  const guardarProvinciaSeleccionada = (): void => {
    if (!provinciaSeleccionada) return;

    try {
      window.localStorage.setItem(LOCALIDAD_STORAGE_KEY, JSON.stringify(provinciaSeleccionada));
    } catch (error) {
      console.error("No se pudo guardar la provincia seleccionada.", error);
    }
  };

  const cargarProvinciaSeleccionada = (): void => {
    try {
      const guardada = window.localStorage.getItem(LOCALIDAD_STORAGE_KEY);
      if (!guardada) return;

      const provincia = JSON.parse(guardada) as unknown;
      if (!esProvinciaValida(provincia)) return;

      provinciaSeleccionada = provincia;
      actualizarPanel(provincia.nombre, provincia.horas_sol);
    } catch (error) {
      console.error("No se pudo recuperar la provincia guardada.", error);
    }
  };

  const registrarConfirmacionLocalidad = (): void => {
    const confirmarLocalidadEl = document.querySelector<HTMLAnchorElement>("#confirmar-localidad");
    if (!(confirmarLocalidadEl instanceof HTMLAnchorElement)) return;
    if (confirmarLocalidadEl.dataset.listenerBound === "1") return;

    confirmarLocalidadEl.addEventListener("click", (event) => {
      const horasManualEl = document.querySelector<HTMLInputElement>("#horas-irradiacion");
      const editarHorasManualEl = document.querySelector<HTMLInputElement>("#editar-horas-manual");

      if (editarHorasManualEl?.checked) {
        const horasManual = Number(horasManualEl?.value ?? "0");
        if (!Number.isFinite(horasManual) || horasManual <= 0) {
          event.preventDefault();
          alert("Ingresa un valor válido de horas de irradiación para continuar.");
          return;
        }

        provinciaSeleccionada = provinciaSeleccionada
          ? { ...provinciaSeleccionada, horas_sol: horasManual }
          : { nombre: "Manual", lat: 0, lng: 0, horas_sol: horasManual };

        guardarProvinciaSeleccionada();
        return;
      }

      if (!provinciaSeleccionada) {
        event.preventDefault();
        alert("Selecciona una provincia antes de confirmar la localidad.");
        return;
      }

      guardarProvinciaSeleccionada();
    });

    confirmarLocalidadEl.dataset.listenerBound = "1";
  };

  const actualizarPanel = (provincia: string, horas: number): void => {
    const provinciaSeleccionadaEl = document.querySelector<HTMLElement>("#provincia-seleccionada");
    const horasIrradiacionEl = document.querySelector<HTMLInputElement>("#horas-irradiacion");

    if (provinciaSeleccionadaEl) provinciaSeleccionadaEl.textContent = provincia;
    if (horasIrradiacionEl) horasIrradiacionEl.value = `${horas.toFixed(1)}`;
  };

  const registrarControlHorasManual = (): void => {
    const editarHorasManualEl = document.querySelector<HTMLInputElement>("#editar-horas-manual");
    const horasIrradiacionEl = document.querySelector<HTMLInputElement>("#horas-irradiacion");
    if (!(editarHorasManualEl instanceof HTMLInputElement) || !(horasIrradiacionEl instanceof HTMLInputElement)) return;
    if (editarHorasManualEl.dataset.listenerBound === "1") return;

    const actualizarEstadoInput = (): void => {
      const modoManual = editarHorasManualEl.checked;
      horasIrradiacionEl.disabled = !modoManual;
      horasIrradiacionEl.classList.toggle("bg-white", modoManual);
      horasIrradiacionEl.classList.toggle("bg-slate-100", !modoManual);
      horasIrradiacionEl.classList.toggle("text-slate-700", modoManual);
      horasIrradiacionEl.classList.toggle("text-[#cc3b26]", !modoManual);
    };

    editarHorasManualEl.addEventListener("change", () => {
      actualizarEstadoInput();

      if (!editarHorasManualEl.checked && provinciaSeleccionada) {
        actualizarPanel(provinciaSeleccionada.nombre, provinciaSeleccionada.horas_sol);
        return;
      }

      if (editarHorasManualEl.checked && provinciaSeleccionada) {
        provinciaSeleccionada = { ...provinciaSeleccionada, horas_sol: Number(horasIrradiacionEl.value || "0") };
      }
    });

    horasIrradiacionEl.addEventListener("input", () => {
      if (!editarHorasManualEl.checked || !provinciaSeleccionada) return;

      const horas = Number(horasIrradiacionEl.value || "0");
      if (!Number.isFinite(horas) || horas <= 0) return;
      provinciaSeleccionada = { ...provinciaSeleccionada, horas_sol: horas };
    });

    if (provinciaSeleccionada?.nombre === "Manual") {
      editarHorasManualEl.checked = true;
    }

    actualizarEstadoInput();
    editarHorasManualEl.dataset.listenerBound = "1";
  };

  const cargarLeaflet = async (): Promise<LeafletGlobal> => {
    const leafletWindow = window as LeafletWindow;

    if (leafletWindow.L) return leafletWindow.L;
    if (leafletWindow.__leafletLoadingPromise) return leafletWindow.__leafletLoadingPromise;

    leafletWindow.__leafletLoadingPromise = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
      script.crossOrigin = "";
      script.onload = () => {
        if (leafletWindow.L) {
          resolve(leafletWindow.L);
          return;
        }

        reject(new Error("Leaflet se cargó, pero `window.L` no está disponible."));
      };
      script.onerror = () => reject(new Error("No se pudo cargar Leaflet desde el CDN."));
      document.head.appendChild(script);
    });

    return leafletWindow.__leafletLoadingPromise;
  };

  const iniciarMapa = async (): Promise<void> => {
    const mapaEl = document.querySelector<HTMLElement>("#mapa-ecuador");
    if (!(mapaEl instanceof HTMLElement)) return;
    if (mapaEl.dataset.mapaInicializado === "1" || mapaEl.dataset.mapaInicializando === "1") return;

    mapaEl.dataset.mapaInicializando = "1";

    try {
      const leafletWindow = window as LeafletWindow;
      const leaflet = await cargarLeaflet();

      if (leafletWindow.__localidadMap) {
        leafletWindow.__localidadMap.remove();
        leafletWindow.__localidadMap = undefined;
      }

      mapaEl.innerHTML = "";

      const mapa = leaflet.map(mapaEl, { scrollWheelZoom: false }).setView([-1.75, -78.5], 6.5);
      leafletWindow.__localidadMap = mapa;
      mapaEl.dataset.mapaInicializado = "1";

      leaflet.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(mapa);

      requestAnimationFrame(() => {
        mapa.invalidateSize();
      });

      const respuesta = await fetch("/json/provincias.json");
      if (!respuesta.ok) throw new Error("No se pudo cargar el archivo de provincias.");

      const provincias = (await respuesta.json()) as Provincia[];
      let marcadorActivo: { setStyle: (styles: { fillColor: string; color: string }) => void } | null = null;

      provincias.forEach((provincia: Provincia) => {
        const marcador = leaflet.circleMarker([provincia.lat, provincia.lng], {
          radius: 7,
          color: "#9f1239",
          fillColor: "#cc3b26",
          fillOpacity: 0.75,
          weight: 2
        });

        marcador.bindTooltip(provincia.nombre);
        marcador.on("click", () => {
          if (marcadorActivo) {
            marcadorActivo.setStyle({ fillColor: "#cc3b26", color: "#9f1239" });
          }

          const editarHorasManualEl = document.querySelector<HTMLInputElement>("#editar-horas-manual");
          const horasIrradiacionEl = document.querySelector<HTMLInputElement>("#horas-irradiacion");
          const modoManualActivo = Boolean(editarHorasManualEl?.checked);
          const horasManual = Number(horasIrradiacionEl?.value ?? "0");

          marcadorActivo = marcador;
          provinciaSeleccionada = {
            ...provincia,
            horas_sol: modoManualActivo && Number.isFinite(horasManual) && horasManual > 0
              ? horasManual
              : provincia.horas_sol,
          };
          marcador.setStyle({ fillColor: "#2563eb", color: "#1e3a8a" });
          actualizarPanel(provincia.nombre, provinciaSeleccionada.horas_sol);
        });

        marcador.addTo(mapa);
      });
    } catch (error) {
      console.error("Error al iniciar el mapa de localidad:", error);
      mapaEl.innerHTML = '<p class="flex h-full items-center justify-center text-sm text-slate-600">No se pudo cargar el mapa.</p>';
      delete mapaEl.dataset.mapaInicializado;
    } finally {
      delete mapaEl.dataset.mapaInicializando;
    }
  };

  const ejecutarMapa = (): void => {
    cargarProvinciaSeleccionada();
    registrarControlHorasManual();
    registrarConfirmacionLocalidad();
    registerNavigationPreloader();

    requestAnimationFrame(() => {
      void iniciarMapa();
    });
  };

  document.addEventListener("astro:page-load", ejecutarMapa);
  window.addEventListener("pageshow", ejecutarMapa);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", ejecutarMapa, { once: true });
  } else {
    ejecutarMapa();
  }
</script>