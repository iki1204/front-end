---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import { getUsuarios } from "../lib/api";
import sesionScript from "../lib/sesionWidget.ts?url";



---

<Layout title="Inicia sesión">
  <section class="py-16 lg:py-24">
    <Container>
      <div class="mx-auto max-w-3xl rounded-3xl border border-zinc-200 bg-white/80 p-8 shadow-xl backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/80">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">UNICOM EC</p>
        <h1 class="mt-3 text-3xl font-bold text-zinc-900 dark:text-white">Registro</h1>
        <h3 class="mt-2 text-sm text-zinc-500 dark:text-zinc-300">
          Registra tu cuenta para revisar tus pedidos y configuraciones
        </h3>



        <form data-register-form class="mt-8 space-y-6">
           <div>
            <label for="username" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              Usuario
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              placeholder="Ejemplo"
              class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
            />
          </div>

          <div>
            <label for="email" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              Correo
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="Micorreo@ejemplo.com"
              class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
            />
          </div>

          <div>
            <label for="telefono" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              Teléfono
            </label>
            <input
              type="text"
              id="telefono"
              name="telefono"
              required
              placeholder="1234567890"
              class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label for="name" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
                Nombres
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Nombres Completos"
                class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
              />
            </div>
            <div>
              <label for="lastname" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
                Apellidos
              </label>
              <input
                type="text"
                id="lastname"
                name="lastname"
                required
                placeholder="Apellidos Completos"
                class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
              />
            </div>
          </div>
          
          <div class="flex gap-2">
             <div class="w-85 flex-auto">
                <label for="direccion" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
                  Dirección
                </label>
                <input
                  type="text"
                  id="direccion"
                  name="direccion"
                  required
                  placeholder="Ejemplo: Av.Shyris y 6 de Diciembre"
                  class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
                />
              </div>
              
              <div class="w-15 flex-auto">
                  <label for="fechaNacimiento" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
                    Fecha de Nacimiento
                  </label>
                  <input
                    type="date"
                    id="fechaNacimiento"
                    name="fechaNacimiento"
                    required
                    class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
                  />
              </div>
          </div>
          <div>
            <label for="password" class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              Contraseña
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••••"
              class="mt-2 w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-xl text-zinc-900 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-white"
            />
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              type="button"
              href="/login"
              class="inline-flex w-full items-center justify-center rounded-full border border-zinc-200 px-5 py-3 text-xl font-semibold text-zinc-700 transition hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-100 dark:hover:border-red-600 dark:hover:text-red-600"
            >
              Iniciar sesión
            </a>
            <button
              type="submit"
              data-register-submit
              class="inline-flex cursor-pointer w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-xl font-semibold text-white transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-70"
            >
              Registrarse
            </button>
          </div>
          <p
            data-register-feedback
            class="text-xs font-medium text-zinc-500 transition dark:text-zinc-300"
            data-variant="neutral"
          >
            
          </p>
        </form>
      </div>
    </Container>
  </section>
  <script type="module" src={sesionScript}></script>
</Layout>