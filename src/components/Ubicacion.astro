---
import Container from "../components/Container.astro";
---

<Container>
  <section class="space-y-10">
    <header class="text-center">
      <h2 class="text-3xl font-semibold tracking-wide uppercase text-gray-900 dark:text-white">
        Necesita Ayuda? <span class="text-[#f05a28]">Contactanos</span>
      </h2>
    </header>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="mapa__frame">
            <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.8028345497596!2d-78.48016962428231!3d-0.15963493543402468!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91d59b21bc1c3801%3A0x2cdb1f0f177d9b0c!2sUNICOM%20EC%20-%20Importadores%20de%20equipos%20para%20Telecomunicaciones%20y%20Energ%C3%ADas%20Renovables!5e0!3m2!1ses-419!2sec!4v1768491039457!5m2!1ses-419!2sec"
            width="100%"
            height="420"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            />
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <article class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f05a28] text-white">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2c-3.59 0-6.5 2.91-6.5 6.5 0 4.29 5.3 9.96 6.11 10.8.22.23.56.23.78 0 .81-.84 6.11-6.51 6.11-10.8C18.5 4.91 15.59 2 12 2zm0 9.25a2.75 2.75 0 1 1 0-5.5 2.75 2.75 0 0 1 0 5.5z"
            />
          </svg>
        </span>
        <div>
          <a href="https://maps.google.com?daddr=-0.1596403,-78.4775947">
            <h3 class="text-sm font-semibold text-gray-900">Google Maps</h3>
            <p class="text-sm text-gray-500">Av. de los Shyris 45-77 y 6 de Diciembre Quito, Ecuador</p>
          </a>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f05a28] text-white">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2c-5.52 0-10 4.48-10 10s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.53 13.03-4.5-2.7a.75.75 0 0 1-.35-.64V7.5a.75.75 0 0 1 1.5 0v3.82l4.1 2.46a.75.75 0 1 1-.75 1.29z"
            />
          </svg>
        </span>
        <div>
          <a href="https://www.waze.com/ul?ll=-0.1596403%2C-78.4775947">
            <h3 class="text-sm font-semibold text-gray-900">Waze</h3>
            <p class="text-sm text-gray-500">Av. de los Shyris 45-77 y 6 de Diciembre Quito, Ecuador</p>
          </a>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f05a28] text-white">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path
              d="M17.47 14.41c-.33-.17-1.93-.95-2.23-1.06-.3-.11-.52-.17-.74.17-.22.33-.85 1.06-1.04 1.28-.19.22-.38.25-.7.08-.33-.17-1.39-.51-2.65-1.63-.98-.88-1.64-1.97-1.83-2.3-.19-.33-.02-.51.15-.68.15-.15.33-.38.5-.57.17-.19.22-.33.33-.55.11-.22.05-.41-.03-.58-.08-.17-.74-1.78-1.01-2.44-.27-.65-.54-.56-.74-.57-.19-.01-.41-.01-.63-.01-.22 0-.58.08-.88.41-.3.33-1.15 1.12-1.15 2.73 0 1.61 1.18 3.17 1.34 3.39.17.22 2.32 3.54 5.61 4.96.78.34 1.39.54 1.86.69.78.25 1.49.22 2.05.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.41.19-1.55-.08-.14-.3-.22-.63-.39z"
            />
          </svg>
        </span>
        <div>
          <a href="https://wa.me/593967302450?text=hola, necesito mas informacion sobre sus productos">
            <h3 class="text-sm font-semibold text-gray-900">WhatsApp</h3>
            <p class="text-sm text-gray-500">Habla directamente con nuestros asesores</p>
          </a>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f05a28] text-white">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
            <path
              d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.49a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.01z"
            />
          </svg>
        </span>
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Llámanos</h3>
          <p class="text-sm text-gray-500">0967302450 / 025123060</p>
        </div>
      </article>
    </div>
  </section>
</Container>