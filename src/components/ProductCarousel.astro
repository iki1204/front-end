---
import Container from "./Container.astro";
import { getProductos } from "../lib/api";

const ITEM_COUNT = 6;
const FETCH_COUNT = 24;

const normalizeWithAttributes = (item: any) =>
  item?.attributes ? { id: item.id, ...item.attributes } : item;

const shuffle = (items: any[]) => {
  const list = [...items];
  for (let i = list.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [list[i], list[j]] = [list[j], list[i]];
  }
  return list;
};

const priceFormatter = new Intl.NumberFormat("es-PE", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 2,
});

const params = new URLSearchParams({
  "pagination[page]": "1",
  "pagination[pageSize]": String(FETCH_COUNT),
  populate: "*",
});

const productosResponse = await getProductos(params);
const productos = (productosResponse?.data ?? []).map(normalizeWithAttributes);
const fewStockThreshold = 10;
const productosUltimasUnidades = productos.filter((producto) => {
  const stockCount = Number(producto?.cantidad_stock ?? 0);
  return Number.isFinite(stockCount) && stockCount > 0 && stockCount <= fewStockThreshold;
});
const productosAleatorios = shuffle(productosUltimasUnidades).slice(0, ITEM_COUNT);
const loopItems =
  productosAleatorios.length > 1
    ? [...productosAleatorios, ...productosAleatorios]
    : productosAleatorios;

const getProductImage = (producto: any) => {
  const API_URL = import.meta.env.VITE_STRAPI_URL;
  const medias: any[] = [
    ...(Array.isArray(producto?.imagen) ? producto.imagen : []),
    ...(producto?.imagen?.data?.attributes ? [producto.imagen.data.attributes] : []),
    ...(Array.isArray(producto?.imagenes?.data) ? producto.imagenes.data.map((m: any) => m.attributes) : []),
  ].filter(Boolean);

  const path =
    medias[0]?.formats?.medium?.url ??
    medias[0]?.formats?.large?.url ??
    medias[0]?.url ??
    null;

  return path ? `${API_URL}${path}` : "/images/placeholder.svg";
};

const getFormattedPrice = (price: number | null | undefined) =>
  typeof price === "number" ? priceFormatter.format(price) : "Consultar";
---

<Container>
  <section class="space-y-8" data-product-carousel>
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-primary">Explora</p>
      <h2 class="mt-2 text-3xl font-bold text-zinc-900 dark:text-white">
        Explora compra y venta
      </h2>
      <p class="mt-2 text-zinc-500 dark:text-zinc-400">
        Productos destacados seleccionados al azar desde nuestro catálogo.
      </p>
    </div>

    <div class="relative">
      <button
        type="button"
        aria-label="Anterior"
        data-carousel-prev
        class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 shadow-lg transition hover:scale-105 hover:text-primary sm:flex"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <div
        class="flex gap-6 overflow-x-auto scroll-smooth pb-4 pt-2"
        data-carousel-track
        data-loop={productosAleatorios.length > 1 ? "true" : "false"}
      >
        {productosAleatorios.length ? (
          loopItems.map((producto) => {
            const slug = producto?.ID_Nombre ?? producto?.slug ?? producto?.id;
            const price = getFormattedPrice(producto?.precio);
            const image = getProductImage(producto);

            return (
              <article
                class="flex w-[260px] shrink-0 flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg dark:border-zinc-800 dark:bg-zinc-900"
                data-carousel-card
              >
                <div class="relative h-44 overflow-hidden">
                  <img
                    src={image}
                    alt={producto?.nombre ?? "Producto"}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="absolute left-4 top-4 rounded-full bg-amber-400 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-zinc-900">
                    Nuevo
                  </span>
                </div>
                <div class="flex flex-1 flex-col gap-3 p-5">
                  <h3 class="line-clamp-2 text-lg font-semibold text-zinc-900 dark:text-white">
                    {producto?.nombre ?? "Producto"}
                  </h3>
                  <p class="text-sm text-zinc-500 dark:text-zinc-400">
                    Código: {producto?.codigo ?? "N/A"}
                  </p>
                  <div class="mt-auto flex items-center justify-between gap-3">
                    <span class="text-lg font-bold text-primary">{price}</span>
                    <a
                      href={`/producto/${slug}`}
                      class="rounded-full bg-primary px-4 py-2 text-xs font-semibold uppercase tracking-wide text-white transition hover:brightness-110"
                    >
                      Ver detalles
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        ) : (
          <div class="rounded-2xl border border-dashed border-zinc-300 p-6 text-center text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
            No encontramos productos para mostrar en este momento.
          </div>
        )}
      </div>

      <button
        type="button"
        aria-label="Siguiente"
        data-carousel-next
        class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 shadow-lg transition hover:scale-105 hover:text-primary sm:flex"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
    </div>
  </section>
</Container>

<script>
  const carousel = document.querySelector("[data-product-carousel]");
  if (carousel) {
    const track = carousel.querySelector("[data-carousel-track]");
    const prevButton = carousel.querySelector("[data-carousel-prev]");
    const nextButton = carousel.querySelector("[data-carousel-next]");
    const shouldLoop = track?.dataset.loop === "true";
    let loopWidth = 0;

    const getScrollStep = () => {
      const card = track?.querySelector("[data-carousel-card]");
      if (!card) {
        return 0;
      }

      const cardWidth = card.getBoundingClientRect().width;
      const gap = parseFloat(window.getComputedStyle(track).columnGap || "24");
      return cardWidth + (Number.isNaN(gap) ? 24 : gap);
    };

    const updateLoopWidth = () => {
      if (!track || !shouldLoop) return;
      loopWidth = track.scrollWidth / 2;
      if (!loopWidth) return;
      if (track.scrollLeft < loopWidth * 0.5 || track.scrollLeft > loopWidth * 1.5) {
        track.scrollLeft = loopWidth;
      }
    };

    const handleLoop = () => {
      if (!track || !shouldLoop || !loopWidth) return;
      if (track.scrollLeft <= loopWidth * 0.5) {
        track.scrollLeft += loopWidth;
      } else if (track.scrollLeft >= loopWidth * 1.5) {
        track.scrollLeft -= loopWidth;
      }
    };

    const scrollByStep = (direction) => {
      if (!track) return;
      const step = getScrollStep();
      track.scrollBy({ left: step * direction, behavior: "smooth" });
    };

    prevButton?.addEventListener("click", () => scrollByStep(-1));
    nextButton?.addEventListener("click", () => scrollByStep(1));
    if (shouldLoop && track) {
      requestAnimationFrame(() => {
        updateLoopWidth();
        handleLoop();
      });
      window.addEventListener("resize", updateLoopWidth);
      track.addEventListener("scroll", handleLoop);
    }
  }
</script>
