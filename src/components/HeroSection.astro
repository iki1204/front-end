---
import { animate, splitText, stagger } from 'animejs';
const { pageData } = Astro.props;
const responseHome = pageData;

const heroSection =
  responseHome?.data?.[0]?.Secciones?.find((s) => s.__component === "shared.hero") ?? {};
const titulo = heroSection?.Titulo ?? "";
const mainTitulo = titulo.slice(0, -2);
const lastTitulo = titulo.slice(-2);

const subtitulo = heroSection?.Subtitulo ?? "";
const mainSubtitulo = subtitulo.slice(0, -7);
const lastSubtitulo = subtitulo.slice(-7);

const botones = heroSection?.boton_link ?? [];



---
  
<div class="relative z-40 h-screen w-full" id="hero">

    <div class="absolute inset-0">
        <header>
          <div class="relative h-screen w-screen pt-28 ml-auto flex items-start gap-5">
            <div class="lg:w-9/10 text-center mx-auto">
              <h1 class="text-balance text-white font-bold text-6xl md:text-6xl xl:text-8xl"
                data-anime="text"
              >
                {mainTitulo}
                <span class="text-primary">{lastTitulo}</span>
              </h1>
              <p class="mt-8 text-white text-xl md:text-4xl xl:text-6xl "
                data-anime="typewriter"
              >
                {mainSubtitulo}
                <span class="text-primary">{lastSubtitulo}</span>
              </p>




              <div class="mt-16 gap-5 flex flex-col sm:flex-row sm:justify-center">
                {botones.map((btn, index) => {
                  const isPrimary = index % 2 === 0;

                  const baseClasses =
                    "group relative inline-flex h-12 w-full items-center justify-center rounded-full px-6 text-base font-semibold transition " +
                    "active:scale-[0.97] sm:w-auto sm:min-w-[180px] "
                    "shadow-lg hover:shadow-md";

                  const primaryClasses =
                    "bg-red-800 text-white ring-2 ring-white/40 hover:ring-white hover:bg-primary";

                  const secondaryClasses =
                    "bg-gray-900 text-white ring-2 ring-red/40 hover:ring-red hover:bg-gray-600";

                  const shineEffect =
                    "before:pointer-events-none before:absolute before:inset-0 before:rounded-full before:opacity-0 before:transition " +
                    "before:bg-[radial-gradient(120px_circle_at_30%_30%,rgba(255,255,255,0.25),transparent_60%)] " +
                    "group-hover:before:opacity-100";

                  return (
                    <a
                      href={btn.url}
                      data-anime="split"
                      class= {`${baseClasses} ${shineEffect} ${
                        isPrimary ? primaryClasses : secondaryClasses
                        
                      }`}
                    >
                      <span class="relative flex items-center gap-2">
                        {btn.etiqueta}
                        
                        <svg
                          class="h-4 w-4 translate-x-0 transition group-hover:translate-x-2"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M13 5l7 7-7 7M20 12H4"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </a>
                  );
                })}
              </div>
                
            </div>
            
          </div>
          
        </header>
      </div>
  </div>

</div>
