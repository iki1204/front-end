---
const { pageData } = Astro.props;
const API_URL = import.meta.env.VITE_STRAPI_URL;
const responseHome = pageData;

const heroSection =
  responseHome?.data?.[0]?.Secciones?.find((s) => s.__component === "shared.hero") ?? {};
const titulo = heroSection?.Titulo ?? "";
const mainTitulo = titulo.slice(0, -2);
const lastTitulo = titulo.slice(-2);

const subtitulo = heroSection?.Subtitulo ?? "";
const mainSubtitulo = subtitulo.slice(0, -7);
const lastSubtitulo = subtitulo.slice(-7);

const botones = heroSection?.boton_link ?? [];

---
  
<div class="relative z-40 h-screen w-screen" id="hero">

    <div class="absolute inset-0">
        <header>
          <div class="relative h-screen w-screen pt-28 ml-auto flex items-start gap-5">
            <div class="lg:w-9/10 text-center mx-auto">
              <h1 class="text-balance text-white font-bold text-3xl md:text-6xl xl:text-8xl">
                {mainTitulo}
                <span class="text-primary">{lastTitulo}</span>
              </h1>
              <p class="mt-8 text-white text-xl md:text-4xl xl:text-6xl">
                {mainSubtitulo}
                <span class="text-primary ">{lastSubtitulo}</span>
              </p>
              <div class="mt-16 flex flex-wrap group justify-center gap-y-4 gap-x-6">
                {botones.map((btn, index) => {
                  const isEven = index % 2 === 0;
                  const baseClasses =
                    'relative flex h-11 w-full items-center justify-center px-6 before:absolute before:inset-0 before:rounded-full before:transition before:duration-300 active:duration-75 sm:w-max';
                  const colorClasses = isEven
                    ? 'before:bg-primary hover:before:scale-105 active:before:scale-95'
                    : 'before:border before:border-transparent before:bg-gradient-to-b group hover:before:scale-105 active:before:scale-95 before:border-gray-700 before:bg-gray-800';
                  const textClasses = isEven
                    ? 'relative text-base font-semibold text-white'
                    : 'relative text-base font-semibold text-white';
                  return (
                    <a href={btn.url} class={`${baseClasses} ${colorClasses}`}>
                      <span class={textClasses}>{btn.etiqueta}</span>
                    </a>
                  );
                })}
              </div>
            </div>
            
          </div>
          
        </header>
      </div>
  </div>

</div>
