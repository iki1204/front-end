---
import Container from "./Container.astro";

const stats = [
  { value: "+1500", label: "Clientes" },
  { value: "+2000", label: "Ventas" },
  { value: "+5000", label: "Horas de soporte" },
  { value: "+130", label: "Trabajadores" },
];

---
<section id="stats" class="stats-section relative overflow-hidden">
  <div class="stats-background absolute inset-0"></div>
  <div class="absolute inset-0 bg-slate-950/70"></div>

  <Container>
    <div class="relative z-10 py-16 md:py-24">
      <div class="text-center text-white">
        <p class="text-sm uppercase tracking-[0.3em] text-slate-200">Impacto real</p>
        <h2 class="mt-4 text-3xl font-semibold md:text-4xl">
          Resultados que hablan por nosotros
        </h2>
      </div>

      <div class="mt-12 grid gap-8 text-center text-white sm:grid-cols-2 lg:grid-cols-4">
        {stats.map((stat) => (
          <div class="space-y-2">
            <p class="text-4xl font-semibold md:text-5xl">{stat.value}</p>
            <p class="text-sm uppercase tracking-[0.2em] text-slate-200">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
<style>
  .stats-section {
    min-height: 360px;
  }

  .stats-background {
    background-image: url("/images/background/about.jpg");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  @media (max-width: 768px) {
    .stats-background {
      background-attachment: scroll;
    }
  }
</style>