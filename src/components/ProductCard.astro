---
const { producto } = Astro.props;
const API_URL = import.meta.env.VITE_STRAPI_URL;

const asesorContactLinks: Record<string, string> = {
  "Edison": "https://wa.me/593967302450?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Moises": "https://wa.me/593989372276?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Katya": "https://wa.me/593991046279?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Samantha": "https://wa.me/593989538349?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
  "Lizeth": "https://wa.me/593980373798?text=Hola, necesito mas informacion sobre su producto " + producto?.nombre + " con codigo: " + (producto?.codigo ?? ""),
};

const getRandomAsesorLink = (links: Record<string, string>) => {
  const values = Object.values(links).filter(Boolean);
  if (values.length === 0) return "#";
  return values[Math.floor(Math.random() * values.length)];
};

const randomAsesorContactLink = getRandomAsesorLink(asesorContactLinks);

const medias: any[] = [
  // imagen como array de media
  ...(Array.isArray(producto?.imagen) ? producto.imagen : []),
  // imagen como single media
  ...(producto?.imagen?.data?.attributes ? [producto.imagen.data.attributes] : []),
  // imagenes como relation multiple
  ...(Array.isArray(producto?.imagenes?.data) ? producto.imagenes.data.map((m:any) => m.attributes) : []),
].filter(Boolean);

const path =
  medias[0]?.formats?.medium?.url ??
  medias[0]?.formats?.large?.url ??
  medias[0]?.url ??
  null;
var imgUrl = path ? `${API_URL}${path}` : "/images/placeholder.svg";


if (imgUrl == null) {
  imgUrl = "/images/placeholder.svg";
}

const srcset = medias[0]?.formats
  ? [
      medias[0].formats.thumbnail?.url && `${API_URL}${medias[0].formats.thumbnail.url} 156w`,
      medias[0].formats.small?.url && `${API_URL}${medias[0].formats.small.url} 500w`,
      medias[0].formats.medium?.url && `${API_URL}${medias[0].formats.medium.url} 750w`,
      medias[0].formats.large?.url && `${API_URL}${medias[0].formats.large.url} 1000w`,
      medias[0].url && `${API_URL}${medias[0].url} ${(medias[0].width ?? 1200)}w`,
    ].filter(Boolean).join(', ')
  : undefined;
const sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw";

const priceFormatter = new Intl.NumberFormat("es-PE", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 2,
});

const slugRaw = producto?.slug ?? producto?.ID_Nombre ?? producto?.id;
const slug = encodeURIComponent(String(slugRaw ?? ""));
const stockCount = Number(producto?.cantidad_stock ?? 0);
const fewStockThreshold = 10;
const isOutOfStock = Number.isFinite(stockCount) ? stockCount <= 0 : !producto?.cantidad_stock;
const porcentajeDescuento = Number(producto?.oferta?.Porcentaje_de_descuento ?? 0);

const rawPrices = {
  default: typeof producto?.precio === "number" ? producto.precio : null,
  pvp1: typeof producto?.precio === "number" ? producto.precio : null,
  pvp2: typeof producto?.Precio2 === "number" ? producto.Precio2 : null,
  pvp3: typeof producto?.Precio3 === "number" ? producto.Precio3 : null,
  pvp4: typeof producto?.Precio4 === "number" ? producto.Precio4 : null,
};

const formatPrice = (value: number | null) => (typeof value === "number" ? priceFormatter.format(value) : "Consultar");
const formattedPrices = {
  default: formatPrice(rawPrices.default),
  pvp1: formatPrice(rawPrices.pvp1),
  pvp2: formatPrice(rawPrices.pvp2),
  pvp3: formatPrice(rawPrices.pvp3),
  pvp4: formatPrice(rawPrices.pvp4),
};

const isOfertaActiva = producto?.oferta?.Activo;

const applyDiscount = (price: number | null) => {
  if (typeof price !== "number") return null;
  if (!porcentajeDescuento || porcentajeDescuento <= 0) return null;
  if (isOfertaActiva !== true) return null;
  return price * (1 - porcentajeDescuento / 100);
};

const offerPrices = {

  default: applyDiscount(rawPrices.default),
  pvp1: applyDiscount(rawPrices.pvp1),
  pvp2: applyDiscount(rawPrices.pvp2),
  pvp3: applyDiscount(rawPrices.pvp3),
  pvp4: applyDiscount(rawPrices.pvp4),
};

const formattedOfferPrices = {
  default: formatPrice(offerPrices.default),
  pvp1: formatPrice(offerPrices.pvp1),
  pvp2: formatPrice(offerPrices.pvp2),
  pvp3: formatPrice(offerPrices.pvp3),
  pvp4: formatPrice(offerPrices.pvp4),
};

const activePrices = isOfertaActiva
  ? offerPrices
  : rawPrices;


---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-zinc-300 bg-zinc-100 shadow-sm transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg dark:border-red-900 dark:bg-zinc-900"
  data-product-card
>
  <a href={`/producto/${slug}`} class="flex flex-1 flex-col">
    <div class="relative h-60 overflow-hidden object-cover rounded-3xl border-red-300 bg-white dark:border-red-900">
      {isOutOfStock ? (
        <div
          data-auth-visible="authenticated"
        >
          <span class="absolute -left-12 top-4 rotate-[-35deg] bg-rose-600 px-12 py-1 text-[11px] font-semibold uppercase tracking-wide text-white shadow-md">
            Sin stock
          </span>
        </div>
      ) : null}
      {fewStockThreshold && stockCount > 0 && stockCount <= fewStockThreshold ? (
        <div
          data-auth-visible="authenticated"
        >
          <span class="absolute -left-12 top-4 rotate-[-25deg] bg-yellow-500 px-12 py-1 text-[11px] font-semibold uppercase tracking-wide text-white shadow-md">
            Ultimas unidades
          </span>
        </div>
      ) : null}
      {isOfertaActiva && porcentajeDescuento > 0 ? (
        <div>
          <span class="absolute -right-2 top-4 bg-green-500 px-3 py-1 rounded-2xl text-[11px] font-semibold uppercase tracking-wide text-white shadow-md">
              {porcentajeDescuento}% OFF
          </span>
        </div>
      ) : null}
      <img
        src={imgUrl}
        alt={producto?.nombre ?? "Producto"}
        sizes={srcset ? sizes : undefined}
        class="h-full w-full object-contain "
        decoding="async"
        loading="lazy"
      />
    </div>
    <div class="mt-4 flex flex-1 flex-col gap-3 py-2 px-1">
      <h3 class="line-clamp-2 text-lg font-semibold text-zinc-900 dark:text-white px-2"
        title={producto?.nombre}
      >
        {producto?.nombre}
      </h3>
      <div class="mt-auto flex items-center justify-between px-2">
        {isOfertaActiva && porcentajeDescuento > 0 ? (
          <>
            <p
              class="text-lg font-bold text-gray-500 line-through"
              data-auth-visible="authenticated"
              data-user-price
              data-price-default={formattedPrices.default}
              data-price-pvp1={formattedPrices.pvp1}
              data-price-pvp2={formattedPrices.pvp2}
              data-price-pvp3={formattedPrices.pvp3}
              data-price-pvp4={formattedPrices.pvp4}
            >
              {formattedPrices.default}
            </p>

            <p
              class="absolute mt-10 mb-2 text-2xl font-bold text-red-500"
              data-auth-visible="authenticated"
              data-user-offer-price
              data-price-default={formattedOfferPrices.default}
              data-price-pvp1={formattedOfferPrices.pvp1}
              data-price-pvp2={formattedOfferPrices.pvp2}
              data-price-pvp3={formattedOfferPrices.pvp3}
              data-price-pvp4={formattedOfferPrices.pvp4}
            >
              {formattedOfferPrices.default}
            </p>
          </>
        ) : (
          <p
            class="text-lg font-bold text-red-500"
            data-auth-visible="authenticated"
            data-user-price
            data-price-default={formattedPrices.default}
            data-price-pvp1={formattedPrices.pvp1}
            data-price-pvp2={formattedPrices.pvp2}
            data-price-pvp3={formattedPrices.pvp3}
            data-price-pvp4={formattedPrices.pvp4}
          >
            {formattedPrices.default}
          </p>
        )}
      <p class="text-sm text-zinc-500 dark:text-zinc-400 px-2"
        data-auth-visible="authenticated"
      >
        Código: {producto?.codigo ?? "N/A"}
      </p>
      </div>
    </div>
  </a>
  <a
    href={randomAsesorContactLink}
    data-auth-visible="guest"
    data-asesor-contact
    data-asesor-links={JSON.stringify(asesorContactLinks)}
    class="flex min-h-10 mx-3 items-center justify-center gap-2 rounded-full border border-green-500/40 bg-green-50 px-4 py-2 text-xs font-semibold text-green-700 transition hover:bg-green-500 hover:text-white hover:border-green-500 dark:bg-green-950/40 dark:text-green-400 dark:border-green-700 dark:hover:bg-green-600 dark:hover:text-white"
  >
    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.05 21.95l4.868-1.275A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.946 7.946 0 0 1-4.075-1.119l-.292-.173-3.006.788.802-2.928-.19-.3A7.96 7.96 0 0 1 4 12c0-4.418 3.582-8 8-8s8 3.582 8 8-3.582 8-8 8z"/>
    </svg>
    Consultar por WhatsApp
  </a>
  <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:items-center sm:justify-between py-2 px-1">
    <a
      href={randomAsesorContactLink}
      data-auth-visible="authenticated"
      data-asesor-contact
      data-asesor-links={JSON.stringify(asesorContactLinks)}
      class="flex min-h-10 items-center justify-center rounded-full text-center border border-transparent px-3 py-2 text-xs font-semibold text-primary transition hover:border-primary hover:bg-primary/10"
    >
      Ver con Asesor
    </a>
    <button
      data-auth-visible="authenticated"
      type="button"
      data-action="add-to-cart"
      data-product-id={producto?.id ?? producto?.ID_Producto ?? producto?.codigo ?? slug}
      data-product-name={producto?.nombre ?? "Producto"}
      data-product-price={activePrices.default ?? ""}
      data-product-image={imgUrl}
      data-product-url={`/producto/${slug}`}
      data-user-price-target="productPrice"
      data-price-default={activePrices.default ?? ""}
      data-price-pvp1={activePrices.pvp1 ?? ""}
      data-price-pvp2={activePrices.pvp2 ?? ""}
      data-price-pvp3={activePrices.pvp3 ?? ""}
      data-price-pvp4={activePrices.pvp4 ?? ""}
      disabled={isOutOfStock || undefined}
      aria-disabled={isOutOfStock ? "true" : undefined}
      class={`flex min-h-10 items-center justify-center rounded-full px-3 py-2 sm:text-xs font-semibold text-white transition focus:outline-none focus:ring-2 focus:ring-primary/60 ${
        isOutOfStock
          ? "bg-zinc-300 dark:bg-zinc-700 cursor-not-allowed opacity-60"
          : "bg-primary cursor-pointer hover:brightness-110"
      }`}>
      
      <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>

    </button>
  </div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    let sessionAsesorKey: string | null = null;

    try {
      const rawSession = localStorage.getItem("usuarioSesion");
      if (rawSession) {
        const parsedSession = JSON.parse(rawSession);
        const user = parsedSession?.user ?? parsedSession?.data?.user ?? null;
        sessionAsesorKey = user?.asesor ?? null;
      }
    } catch {
      // sin sesión válida
    }

    const getRandomLink = (links: Record<string, string>) => {
      const values = Object.values(links).filter(Boolean);
      return values.length > 0 ? values[Math.floor(Math.random() * values.length)] : "#";
    };

    document.querySelectorAll<HTMLAnchorElement>("[data-asesor-contact]").forEach((el) => {
      const raw = el.getAttribute("data-asesor-links") ?? "{}";
      let links: Record<string, string> = {};
      try { links = JSON.parse(raw); } catch { return; }

      if (sessionAsesorKey && links[sessionAsesorKey]) {
        el.setAttribute("href", links[sessionAsesorKey]);
      } else {
        el.setAttribute("href", getRandomLink(links));
      }
    });
  });
</script>
