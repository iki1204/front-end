---
import Container from "./Container.astro";
import { getGlobalData } from "../lib/api";  
import headerAuthScript from "../lib/headerAuthToggle.ts?url";

const API_URL = import.meta.env.VITE_STRAPI_URL;
const response = await getGlobalData();
const siteName = response.data.header.Etiqueta;
const logoUrl = response.data.header.Logo.map((img) => `${API_URL}${img.url}`) ?? [];
const links = response.data.header.subitem.map((link) => ({
    label: link.etiqueta,
    to: link.url,
}));
const botones = response.data.header.Botones.map((boton) => ({
    label: boton.title,
    to: boton.body,
}));
---

<header id="site-header" class="sticky w-full top-0 z-60 border-b border-black/10 dark:border-white/5 bg-transparent transition-all duration-500 ease-in-out">
    <nav id="nav" class="group/nav top-0 z-50 w-full  dark:border-white/5 lg:border-transparent">
        <Container>
            <div class="relative flex flex-wrap items-center justify-between gap-6 py-3 md:gap-0 md:py-4">
                <div class="relative z-20 flex w-full justify-between md:px-0 lg:w-fit">
                    <a href="/#home" aria-label="logo" class="flex dark:hidden items-center space-x-2">
                        <div aria-hidden="true" class="flex space-x-1">
                            <div class="size-4 rounded-full bg-gray-900 dark:bg-white"></div>
                            <div class="h-6 w-2 bg-primary"></div>
                        </div>
                        <div>
                            {logoUrl ? <img src={logoUrl[0]} alt={siteName} class="h-12 w-auto object-contain" /> : null}
                        </div>
                    </a>
                    <a href="/#home" aria-label="logo" class="hidden dark:flex items-center space-x-2">
                        <div aria-hidden="true" class="flex space-x-1">
                            <div class="size-4 rounded-full bg-gray-900 dark:bg-white"></div>
                            <div class="h-6 w-2 bg-primary"></div>
                        </div>
                        <div>
                            {logoUrl ? <img src={logoUrl[1]} alt={siteName} class="h-8 w-auto object-contain" /> : null}
                        </div>
                    </a>

                    <div class="flex items-center gap-3">

                      <div class="relative flex max-h-10 items-center lg:hidden">
                            <button aria-label="humburger" id="hamburger" class="relative -mr-6 p-6 active:scale-95 duration-300">
                                <div aria-hidden="true" id="line" class="m-auto h-0.5 w-5 rounded bg-gray-950 transition duration-300 dark:bg-white origin-top group-data-[state=active]/nav:rotate-45 group-data-[state=active]/nav:translate-y-1.5"></div>
                                <div aria-hidden="true" id="line2" class="m-auto mt-2 h-0.5 w-5 rounded bg-gray-950 transition duration-300 dark:bg-white origin-bottom group-data-[state=active]/nav:-rotate-45 group-data-[state=active]/nav:-translate-y-1"></div>
                            </button>
                        </div>
                    </div>
                </div>
                <div id="navLayer" aria-hidden="true" class="fixed inset-0 z-10 h-screen w-full origin-bottom scale-y-0 bg-white/70 backdrop-blur-2xl transition duration-500 group-data-[state=active]/nav:origin-top group-data-[state=active]/nav:scale-y-100 dark:bg-gray-950/70 lg:hidden"></div>
                <div id="navlinks" class="invisible absolute top-full  justify-center left-0 z-20 w-full origin-top-right translate-y-1 scale-90 flex-col flex-wrap gap-6 rounded-3xl border border-gray-100 bg-white p-8 opacity-0 shadow-2xl shadow-gray-600/10 transition-all duration-300 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none lg:visible lg:relative lg:flex lg:w-fit lg:translate-y-0 lg:scale-100 lg:flex-row lg:items-center lg:gap-0 lg:border-none lg:bg-transparent lg:p-0 lg:opacity-100 lg:shadow-none lg:dark:bg-transparent group-data-[state=active]/nav:visible group-data-[state=active]/nav:scale-100 group-data-[state=active]/nav:opacity-100 lg:group-data-[state=active]/nav:translate-y-0">
                  <div class="relative mt-6 w-full text-gray-600 dark:text-gray-200 lg:mt-0 lg:w-auto lg:pr-4 lg:pt-0 group/menu" data-nav-dropdown>
                      <button
                        type="button"
                        class="flex h-9 w-full items-center justify-between gap-2 rounded-full border border-red/20 bg-white/80 px-4 text-sm font-semibold text-black dark:text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/20 dark:bg-gray-900 lg:w-auto"
                        aria-haspopup="true"
                      >
                        <span>Navegación</span>
                        <svg aria-hidden="true" class="size-4 transition group-hover/menu:rotate-180 lg:group-data-[open=true]/menu:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.24 4.5a.75.75 0 0 1-1.08 0l-4.24-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                        </svg>
                      </button>
                      <div class="mt-2 w-full overflow-hidden rounded-2xl border border-gray-100 bg-white p-2 shadow-xl shadow-gray-600/10 transition-[max-height,opacity,transform] duration-300 max-h-0 opacity-0 pointer-events-none scale-95 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none group-data-[open=true]/menu:max-h-80 group-data-[open=true]/menu:scale-100 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:pointer-events-auto lg:absolute lg:left-1/2 lg:top-full lg:mt-4 lg:w-64 lg:-translate-x-1/2 lg:origin-top lg:group-hover/menu:max-h-80 lg:group-hover/menu:scale-100 lg:group-hover/menu:opacity-100 lg:group-hover/menu:pointer-events-auto" data-nav-panel>
                          <div id="links-group" class="flex flex-col gap-1 rounded-xl bg-gray-50 p-2 tracking-wide dark:bg-gray-900 lg:text-sm">
                              {
                                links.map((link) => (
                                  <a href={link.to} class="transition block rounded-xl px-4 py-2 text-black dark:text-white hover:bg-primary/10 hover:text-primary md:px-4">
                                    <span>{link.label}</span>
                                  </a>
                                ))
                              }
                          </div>
                      </div>
                  </div>            
                  <div class="relative mt-6 w-full lg:mt-0 lg:w-auto group/menu" data-nav-dropdown>
                    <button
                      type="button"
                      class="flex h-9 w-full items-center justify-between gap-2 rounded-full border border-red/20 bg-white/80 px-4 text-sm font-semibold text-black dark:text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/20 dark:bg-gray-900 lg:w-auto"
                      aria-haspopup="true"
                    >
                      <span>Páginas</span>
                      <svg aria-hidden="true" class="size-4 transition group-hover/menu:rotate-180 lg:group-data-[open=true]/menu:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.24 4.5a.75.75 0 0 1-1.08 0l-4.24-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                      </svg>
                    </button>
                    <div class="mt-2 flex w-full flex-col gap-2 overflow-hidden rounded-2xl border border-gray-100 bg-white p-2 shadow-xl shadow-gray-600/10 transition-[max-height,opacity,transform] duration-300 max-h-0 opacity-0 pointer-events-none scale-95 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none group-data-[open=true]/menu:max-h-80 group-data-[open=true]/menu:scale-100 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:pointer-events-auto lg:absolute lg:left-1/2 lg:top-full lg:mt-4 lg:w-56 lg:-translate-x-1/2 lg:origin-top lg:group-hover/menu:max-h-80 lg:group-hover/menu:scale-100 lg:group-hover/menu:opacity-100 lg:group-hover/menu:pointer-events-auto" data-nav-panel>
                      {
                        botones.map((link) => (
                          <a href={link.to} class="relative flex h-9 w-full items-center justify-center px-4 before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95">
                            <span class="relative text-sm font-semibold text-white">{link.label}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                  <div class="relative mt-16 w-full lg:mt-0 lg:w-auto group/menu" data-nav-dropdown>
                    <button
                      type="button"
                      class="flex h-9 w-full items-center justify-between gap-2 rounded-full border border-red/20 bg-white/80 px-4 text-sm font-semibold text-black dark:text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/20 dark:bg-gray-900 lg:w-auto"
                      aria-haspopup="true"
                    >
                      <span>Cuenta</span>
                      <svg aria-hidden="true" class="size-4 transition group-hover/menu:rotate-180 lg:group-data-[open=true]/menu:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.24 4.5a.75.75 0 0 1-1.08 0l-4.24-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                      </svg>
                    </button>
                                        <div class="mt-2 flex w-full flex-col gap-2 overflow-hidden rounded-2xl border border-gray-100 bg-white p-2 shadow-xl shadow-gray-600/10 transition-[max-height,opacity,transform] duration-300 max-h-0 opacity-0 pointer-events-none scale-95 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none group-data-[open=true]/menu:max-h-80 group-data-[open=true]/menu:scale-100 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:pointer-events-auto lg:absolute lg:left-1/2 lg:top-full lg:mt-4 lg:w-60 lg:-translate-x-1/2 lg:origin-top lg:group-hover/menu:max-h-80 lg:group-hover/menu:scale-100 lg:group-hover/menu:opacity-100 lg:group-hover/menu:pointer-events-auto" data-nav-panel>
                      <a
                          type="button"
                          href="/login"
                          data-login-button
                          class="cursor-pointer group flex hidden items-center justify-between gap-2 rounded-full border border-primary/40 bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/20 dark:bg-gray-900 dark:text-white dark:hover:border-primary"
                          aria-label="Iniciar sesión"
                      >
                          <span class="text-sm font-semibold tracking-wide">Ingresar</span>
                          <span class="flex size-7 items-center justify-center rounded-full bg-primary/10 transition group-hover:bg-white/20 dark:bg-white/10">
                            <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M14.5 6L20 12L14.5 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M20 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                              <path d="M12 4H8C5.79086 4 4 5.79086 4 8V16C4 18.2091 5.79086 20 8 20H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                          </span>
                      </a>
                      <button
                          type="button"
                          data-logout-cta
                          class="cursor-pointer hidden group flex items-center justify-between gap-2 rounded-full border border-primary/40 bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/20 dark:bg-gray-900 dark:text-white dark:hover:border-primary"
                          aria-label="Cerrar sesión"
                          aria-expanded="false"
                          aria-controls="logout-confirmation"
                      >
                        <span>Cerrar sesión</span>
                        <span class="flex size-7 items-center justify-center rounded-full bg-primary/10 transition group-hover:bg-white/20 dark:bg-white/10">
                          <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14.5 6L20 12L14.5 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M20 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M12 4H8C5.79086 4 4 5.79086 4 8V16C4 18.2091 5.79086 20 8 20H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </button>
                    </div>
                  </div>
                <div
                      data-logout-confirmation
                      id="logout-confirmation"
                      class="hidden absolute right-4 top-20 z-50 w-full max-w-xs rounded-lg border border-red-200 bg-white p-4 text-sm shadow-lg shadow-red-100/60 dark:border-red-700 dark:bg-gray-900 dark:text-red-100"
                      role="alert"
                      aria-live="assertive"
                    >
                      <p class="font-semibold text-red-800 dark:text-red-200">¿Cerrar sesión?</p>
                      <p class="mt-1 text-red-700 dark:text-red-300">Confirma si deseas salir de tu cuenta activa.</p>
                      <div class="mt-3 flex items-center gap-2">
                        <button
                          type="button"
                          data-logout-confirm="yes"
                          class="flex-1 rounded-md cursor-pointer bg-red-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-900"
                        >
                          Sí, cerrar
                        </button>
                        <button
                          type="button"
                          data-logout-confirm="no"
                          class="flex-1 rounded-md cursor-pointer border border-red-300 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50 dark:border-red-600 dark:text-red-200 dark:hover:bg-red-800/30"
                        >
                          No
                        </button>
                      </div>
                    </div>
                  </div>

                
            </div>

                
            </div>
        </Container>
    </nav>
</header>

<script>
  const header = document.getElementById("site-header");

  const updateHeaderState = () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.add("bg-white", "dark:bg-gray-950", "shadow-md");
      header.classList.remove("bg-transparent");
    } else {
      header.classList.remove("bg-white", "dark:bg-gray-950", "shadow-md");
      header.classList.add("bg-transparent");
    }
   };

  updateHeaderState();
  window.addEventListener("scroll", updateHeaderState);
</script>



<script type="module" src={headerAuthScript}></script>


<script>
    let isToggled = false;
    const navbar = document.getElementById("nav");
    const menuBtn = document.getElementById("hamburger");
    const links = navbar ? Array.from(navbar.querySelector("#links-group")?.children ?? []) : [];

    function toggleNavlinks() {
        if (!navbar) return;
        if (isToggled) {
            navbar.dataset.state = "active";
        } else {
            navbar.dataset.state = "";
        }
    }

    menuBtn?.addEventListener("click", () => {
        isToggled = !isToggled;
        toggleNavlinks();
    });

    links.forEach((link) => {
        link.addEventListener("click", () => {
            isToggled = !isToggled;
            toggleNavlinks();
        });
    });
</script>

<script>
  const hoverSupported =
    typeof window !== "undefined" && typeof window.matchMedia === "function"
      ? window.matchMedia("(hover: hover) and (pointer: fine)").matches
      : true;
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-dropdown]"));
     const closeDropdown = (dropdown: HTMLElement) => {
    dropdown.removeAttribute("data-open");
    const button = dropdown.querySelector<HTMLButtonElement>("button");
    if (button) {
      button.setAttribute("aria-expanded", "false");
    }
  };
  const openDropdown = (dropdown: HTMLElement) => {
    dropdown.setAttribute("data-open", "true");
    const button = dropdown.querySelector<HTMLButtonElement>("button");
    if (button) {
      button.setAttribute("aria-expanded", "true");
    }
  };
  const closeAllDropdowns = (exception?: HTMLElement) => {
    dropdowns.forEach((dropdown) => {
      if (exception && dropdown === exception) return;
      closeDropdown(dropdown);
    });
  };

  dropdowns.forEach((dropdown) => {
    const button = dropdown.querySelector<HTMLButtonElement>("button");
    if (!button) return;
    button.setAttribute("aria-expanded", "false");
    button.addEventListener("click", (event) => {
      event.preventDefault();
      const isOpen = dropdown.getAttribute("data-open") === "true";
      if (isOpen) {
        closeDropdown(dropdown);
        return;
      }
      closeAllDropdowns(dropdown);
      openDropdown(dropdown);
    });
  });

  document.addEventListener("click", (event) => {
    if (dropdowns.some((dropdown) => dropdown.contains(event.target as Node))) {
      return;
    }
    closeAllDropdowns();
  });

  if (hoverSupported && dropdowns.length > 0) {
    dropdowns.forEach((dropdown) => {
      const panel = dropdown.querySelector<HTMLElement>("[data-nav-panel]");
      if (!panel) return;

      let hoverCloseTimeout: number | null = null;
      const clearHoverTimeout = () => {
        if (hoverCloseTimeout !== null) {
          window.clearTimeout(hoverCloseTimeout);
          hoverCloseTimeout = null;
        }
      };
      const isPointerInside = () => dropdown.matches(":hover") || panel.matches(":hover");
      const openOnHover = () => {
        openDropdown(dropdown);
      };
      const closeOnHover = () => {
        closeDropdown(dropdown);
      };
      const scheduleClose = () => {
        clearHoverTimeout();
        hoverCloseTimeout = window.setTimeout(() => {
          hoverCloseTimeout = null;
          if (isPointerInside()) {
            scheduleClose();
            return;
          }
          closeOnHover();
        }, 220);
      };

      const handleEnter = () => {
        clearHoverTimeout();
        openOnHover();
      };
      const handleLeave = () => {
        scheduleClose();
      };

      dropdown.addEventListener("mouseenter", handleEnter);
      dropdown.addEventListener("mouseleave", handleLeave);
      panel.addEventListener("mouseenter", handleEnter);
      panel.addEventListener("mouseleave", handleLeave);
    });
  }
</script>
