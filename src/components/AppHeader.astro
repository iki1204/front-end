---
import Container from "./Container.astro";
import { getGlobalData } from "../lib/api";  
import headerAuthScript from "../lib/headerAuthToggle.ts?url";

const API_URL = import.meta.env.VITE_STRAPI_URL;
const { global } = Astro.props;
const response = global ?? (await getGlobalData());
const siteName = response.data.header.Etiqueta;
const logoUrl = response.data.header.Logo.map((img) => `${API_URL}${img.url}`) ?? [];

const isHome = Astro.url.pathname === "/";
const normalizeLink = (url) => {
    if (!url) return url;
    if (url.startsWith("/#")) return url;
    if (url.startsWith("#/")) return `/#${url.slice(2)}`;
    if (url.startsWith("#")) return `${isHome ? "" : "/"}#${url.slice(1)}`;
    return url;
};

const links = response.data.header.subitem.map((link) => ({
    label: link.etiqueta,
    to: normalizeLink(link.url),
}));
const botones = response.data.header.Botones.map((boton) => ({
    label: boton.title,
    to: normalizeLink(boton.body),
}));


