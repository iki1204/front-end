<script>
  const initHamburger = () => {
    let isToggled = false;
    const navbar = document.getElementById("nav");
    const menuBtn = document.getElementById("hamburger");
    const links = navbar ? Array.from(navbar.querySelector("#links-group")?.children ?? []) : [];

    function toggleNavlinks() {
      if (!navbar) return;
      navbar.dataset.state = isToggled ? "active" : "";
    }

    menuBtn?.removeEventListener("click", (window as any).__hamburgerClickHandler);
    (window as any).__hamburgerClickHandler = () => {
      isToggled = !isToggled;
      toggleNavlinks();
    };
    menuBtn?.addEventListener("click", (window as any).__hamburgerClickHandler);

    links.forEach((link) => {
      link.addEventListener("click", () => {
        isToggled = !isToggled;
        toggleNavlinks();
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHamburger, { once: true });
  } else {
    initHamburger();
  }
  document.addEventListener("astro:page-load", initHamburger);
</script>

<script>
  // Menús desplegables del header.
  // - Escritorio (>= lg) con ratón: abre al pasar el cursor (con pequeña intención) y cierra con retardo.
  // - Táctil / móvil / teclado: abre y cierra con clic; Escape y clic fuera cierran.
  const OPEN_DELAY = 60;
  const CLOSE_DELAY = 200;
  const HOVER_CLICK_GRACE = 500; // clic justo después de abrir por hover no lo cierra

  const desktopQuery = window.matchMedia("(min-width: 1024px)");

  const initDropdowns = () => {
    const dropdowns = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-dropdown]"));
    if (dropdowns.length === 0) return;

    const getButton = (dropdown: HTMLElement) =>
      dropdown.querySelector<HTMLButtonElement>(":scope > button");

    const setOpen = (dropdown: HTMLElement, open: boolean) => {
      if (open) dropdown.setAttribute("data-open", "true");
      else dropdown.removeAttribute("data-open");
      getButton(dropdown)?.setAttribute("aria-expanded", open ? "true" : "false");
    };

    const isOpen = (dropdown: HTMLElement) => dropdown.getAttribute("data-open") === "true";

    const closeOthers = (current?: HTMLElement) => {
      dropdowns.forEach((dropdown) => {
        if (dropdown !== current && isOpen(dropdown)) setOpen(dropdown, false);
      });
    };

    dropdowns.forEach((dropdown) => {
      // Evita registrar los listeners dos veces (DOMContentLoaded + astro:page-load con ClientRouter).
      if (dropdown.dataset.navReady === "true") return;
      dropdown.dataset.navReady = "true";

      const button = getButton(dropdown);
      if (!button) return;
      button.setAttribute("aria-expanded", "false");

      let openTimer: number | null = null;
      let closeTimer: number | null = null;
      let openedByHoverAt = 0;

      const clearTimers = () => {
        if (openTimer !== null) { window.clearTimeout(openTimer); openTimer = null; }
        if (closeTimer !== null) { window.clearTimeout(closeTimer); closeTimer = null; }
      };

      const isHoverPointer = (event: PointerEvent) =>
        event.pointerType === "mouse" && desktopQuery.matches;

      dropdown.addEventListener("pointerenter", (event) => {
        if (!isHoverPointer(event)) return;
        clearTimers();
        if (isOpen(dropdown)) return;
        // Si otro menú ya está abierto se cambia al instante; si no, pequeña espera de intención.
        const anotherOpen = dropdowns.some((d) => d !== dropdown && isOpen(d));
        const open = () => {
          openTimer = null;
          closeOthers(dropdown);
          setOpen(dropdown, true);
          openedByHoverAt = Date.now();
        };
        if (anotherOpen) open();
        else openTimer = window.setTimeout(open, OPEN_DELAY);
      });

      dropdown.addEventListener("pointerleave", (event) => {
        if (!isHoverPointer(event)) return;
        clearTimers();
        closeTimer = window.setTimeout(() => {
          closeTimer = null;
          if (dropdown.matches(":hover")) return;
          setOpen(dropdown, false);
        }, CLOSE_DELAY);
      });

      button.addEventListener("click", (event) => {
        event.preventDefault();
        clearTimers();
        if (isOpen(dropdown)) {
          // Si se acaba de abrir por hover, el clic no lo cierra (evita el "abre y se cierra").
          if (Date.now() - openedByHoverAt < HOVER_CLICK_GRACE) return;
          setOpen(dropdown, false);
          return;
        }
        closeOthers(dropdown);
        setOpen(dropdown, true);
        openedByHoverAt = 0;
      });

      dropdown.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !isOpen(dropdown)) return;
        setOpen(dropdown, false);
        button.focus();
      });

      dropdown.addEventListener("focusout", (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && dropdown.contains(next)) return;
        if (desktopQuery.matches && !dropdown.matches(":hover")) setOpen(dropdown, false);
      });
    });

    document.removeEventListener("click", (window as any).__dropdownOutsideClickHandler);
    (window as any).__dropdownOutsideClickHandler = (event: Event) => {
      const current = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-dropdown]"));
      if (current.some((dropdown) => dropdown.contains(event.target as Node))) return;
      current.forEach((dropdown) => {
        if (dropdown.getAttribute("data-open") === "true") setOpen(dropdown, false);
      });
    };
    document.addEventListener("click", (window as any).__dropdownOutsideClickHandler);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDropdowns, { once: true });
  } else {
    initDropdowns();
  }
  document.addEventListener("astro:page-load", initDropdowns);
</script>
