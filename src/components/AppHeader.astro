<script>
  const initHeader = () => {
    const header = document.getElementById("site-header");
    const HOME_PATH = "/";
    const normalizeHash = (value) => {
      if (!value) return null;
      if (value.startsWith("/#")) return value.slice(2);
      if (value.startsWith("#/")) return value.slice(2);
      if (value.startsWith("#")) return value.slice(1);
      return null;
    };

    const scrollToHash = (hashValue) => {
      const target = document.getElementById(hashValue);
      if (!target) return;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const updateHeaderState = () => {
      if (!header) return;
      if (window.scrollY > 50) {
        header.classList.add("bg-white", "dark:bg-gray-950", "shadow-md");
        header.classList.remove("bg-transparent");
      } else {
        header.classList.remove("bg-white", "dark:bg-gray-950", "shadow-md");
        header.classList.add("bg-transparent");
      }
    };

    updateHeaderState();

    // Remove previous listener before adding to avoid duplicates across navigations
    window.removeEventListener("scroll", (window as any).__headerScrollHandler);
    (window as any).__headerScrollHandler = updateHeaderState;
    window.addEventListener("scroll", updateHeaderState);

    document.removeEventListener("click", (window as any).__headerAnchorClickHandler);
    (window as any).__headerAnchorClickHandler = (event: Event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const link = target.closest("a");
      if (!link) return;
      const href = link.getAttribute("href") ?? "";
      const hashValue = normalizeHash(href);
      if (!hashValue) return;
      const isHome = window.location.pathname === HOME_PATH;
      if (isHome) {
        event.preventDefault();
        scrollToHash(hashValue);
        window.history.replaceState({}, "", `/#${hashValue}`);
      }
    };

    if (window.location.pathname === HOME_PATH) {
      const initialHash = normalizeHash(window.location.hash || window.location.pathname);
      if (initialHash) {
        requestAnimationFrame(() => scrollToHash(initialHash));
      }
    }

    document.addEventListener("click", (window as any).__headerAnchorClickHandler);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader, { once: true });
  } else {
    initHeader();
  }
  document.addEventListener("astro:page-load", initHeader);
</script>



